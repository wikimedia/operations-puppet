<%#- SPDX-License-Identifier: Apache-2.0 -%>
[Unit]
Description=Liberica healthcheck daemon
After=network-online.target

[Install]
WantedBy=multi-user.target

[Service]
User=liberica
# setsockopt(2) SO_MARK requires CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
SystemCallFilter=~@keyring @clock @cpu-emulation @obsolete @module @raw-io @reboot @swap
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectSystem=strict
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ExecStart=/usr/bin/libericad healthcheck
ExecReload=/usr/bin/kill -SIGHUP $MAINPID
Restart=on-failure
