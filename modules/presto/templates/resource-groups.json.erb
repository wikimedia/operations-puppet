<%#- SPDX-License-Identifier: Apache-2.0 -%>
<%#- NOTE: This file is managed by Puppet. -%>
<%#- PrestoDB's file resource group manager reads the rootGroups and the -%>
<%#- selectors from this single file (named by 'resource-groups.config-file'). -%>
<%#- There is no separate selector-file property. -%>
{
  "rootGroups": [
    {
      "name": "global",
      "softMemoryLimit": "<%= @resource_config['glob_mem_limit'] %>",
      "hardConcurrencyLimit": <%= @resource_config['glob_concur_limit'] %>,
      "maxQueued": <%= @resource_config['glob_max_queued'] %>,
      "schedulingPolicy": "weighted",
      "subGroups": [
        {
          "name": "high_priority",
          "softMemoryLimit": "<%= @resource_config['hp_mem_limit'] %>",
          "hardConcurrencyLimit": <%= @resource_config['hp_concur_limit'] %>,
          "maxQueued": <%= @resource_config['hp_max_queued'] %>,
          "schedulingWeight": <%= @resource_config['hp_sched_weight'] %>
        },
        {
          "name": "standard",
          "softMemoryLimit": "<%= @resource_config['std_mem_limit'] %>",
          "hardConcurrencyLimit": <%= @resource_config['std_concur_limit'] %>,
          "maxQueued": <%= @resource_config['std_max_queued'] %>,
          "schedulingWeight": <%= @resource_config['std_sched_weight'] %>
        },
        {
          "name": "heavy",
          "softMemoryLimit": "<%= @resource_config['hv_mem_limit'] %>",
          "hardConcurrencyLimit": <%= @resource_config['hv_concur_limit'] %>,
          "maxQueued": <%= @resource_config['hv_max_queued'] %>,
          "schedulingWeight": <%= @resource_config['hv_sched_weight'] %>
        }
      ]
    }
  ],
<%#- Selectors match the authenticated Kerberos principal by regex, so the -%>
<%#- match is on the verified identity rather than the client-supplied source. -%>
  "selectors": [
    {
      "principal": "superset/[^@]+@WIKIMEDIA",
      "group": "global.high_priority"
    },
    {
      "principal": "HTTP/growthbook[^@]*@WIKIMEDIA",
      "group": "global.high_priority"
    },
    {
      "clientTags": [
        "heavy"
      ],
      "group": "global.heavy"
    },
    {
      "group": "global.standard"
    }
  ]
}
