# Environement variables
export MAIL="jmeybohm@wikimedia.org"
export DEBEMAIL="$MAIL"
export EDITOR="vim.basic"

__kube_env_ps1() {
    if [ -z "$K8S_CLUSTER" ] || [ -z "$K8S_NAMESPACE" ]; then
        return
    fi
    echo "<${K8S_NAMESPACE}/${K8S_CLUSTER}>"
}

PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w$(__kube_env_ps1)\$ '
