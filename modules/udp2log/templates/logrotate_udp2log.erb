# Rotate large (>50G/day) logs hourly:
# - api.log
# - poolcounter.log
# - csp-report-only.log
# - EventBus.log 
# - xff.log
# - JobExecutor.log
<%= @log_directory %>/api.log <%= @log_directory %>/poolcounter.log  <%= @log_directory %>/csp-report-only.log <%= @log_directory %>/EventBus.log <%= @log_directory %>/xff.log <%= @log_directory %>/JobExecutor.log {
        hourly
        olddir <%= @log_directory %>/archive
        notifempty
        nocreate
        maxage 90
        rotate <%= @rotate %>
        dateext
        datehourago
        compress
        delaycompress
        missingok
        ignoreduplicates
        postrotate
                /usr/bin/killall -HUP udp2log
        endscript
}

# Rotate mw-logs daily
# note: overlapping hourly file(s) below to be excluded by not meeting
# file age requirement when considered for daily rotation
<%= @log_directory %>/*.log {
	daily
	olddir <%= @log_directory %>/archive
	notifempty
	nocreate
	maxage 90
	rotate <%= @rotate %>
	dateext
	compress
	delaycompress
        missingok
        ignoreduplicates
	postrotate
		/usr/bin/killall -HUP udp2log
	endscript
}
