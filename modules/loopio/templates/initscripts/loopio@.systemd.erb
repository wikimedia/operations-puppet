[Unit]
Description=Setup loop IO device from /var/lib/loopio/%i
DefaultDependencies=no
After=local-fs.target
ConditionFileNotEmpty=/var/lib/loopio/%i

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/loopio --start %i
ExecStop=/usr/local/sbin/loopio --stop %i
RemainAfterExit=yes

[Install]
WantedBy=local-fs.target
