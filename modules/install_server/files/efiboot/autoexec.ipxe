#!ipxe
# SPDX-License-Identifier: Apache-2.0
# NOTE: This file is autoloaded by iPXE when loaded under UEFI

# HACK: re-dhcp to grab the root-path, this is necessary because UEFI's DHCP
# client only exposes minimal DHCP data, but we require the root-path to
# determine the OS release. We could in the future have iPXE query the OS
# release directly.
dhcp

kernel http://apt.wikimedia.org/tftpboot/${root-path}/debian-installer/amd64/linux initrd=one.gz vga=normal auto-install/enable=true preseed/url=http://apt.wikimedia.org/autoinstall/preseed.cfg DEBCONF_DEBUG=5 netcfg/choose_interface=auto netcfg/link_wait_timeout=20 hostname=${hostname} domain=${domain_name} netcfg/disable_dhcp=true netcfg/get_ipaddress=${net0/ip} netcfg/get_netmask=${net0/netmask} netcfg/get_gateway=${net0/gateway} netcfg/get_nameservers=${dns} --- console=ttyS1,115200n8 raid0.default_layout=2

initrd --name one.gz http://apt.wikimedia.org/tftpboot/${root-path}/debian-installer/amd64/initrd.gz

boot
