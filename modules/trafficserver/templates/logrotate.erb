<%#- SPDX-License-Identifier: Apache-2.0 -%>
/var/log/trafficserver/*.log {
    daily
    postrotate
      /bin/systemctl is-active --quiet trafficserver.service && /bin/kill -USR2 $(/bin/systemctl show --property MainPID --value trafficserver.service)
    endscript
    missingok
    nocreate
    rotate 28
    compress
    delaycompress
}
