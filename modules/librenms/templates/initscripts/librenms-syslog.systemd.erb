<%#- SPDX-License-Identifier: Apache-2.0 -%>
[Unit]
Description=LibreNMS syslog daemon

[Service]
Type=notify
ExecStart=/usr/sbin/rsyslogd -n -f /etc/librenms-rsyslog.conf -i /var/run/librenms-rsyslogd.pid
StandardOutput=null
Restart=on-failure
# Bandaid for memory leak - T397427
MemoryMax=5G

[Install]
WantedBy=multi-user.target
