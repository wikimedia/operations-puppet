<%
# Must check for :undef as well in below 'if' statements.
# Puppet 'undef' values normally become 'nil' in ERB (Ruby), which are falsey.
# But, in Puppet 3, when undef is put inside a hash or passed indirectly,
# it becomes ':undef' which is not falsey. This is fixed in Puppet 4.
# https://tickets.puppetlabs.com/browse/PUP-1467
#
# The output must not contain:
# - a percent sign: Envoy parses this page as a format string unless you escape it.
# - a double quote followed by a closing brace: VCL embeds this page in a long string.
-%>
<!DOCTYPE html>
<html lang="en">
<%# Commenting at the top of the page is useful for APIs (See T240794) -%>
<% if @errorpage['browsersec_comment'] -%>
<!-- Client security settings are inadequate. Review requirements at https://wikitech.wikimedia.org/wiki/HTTPS -->
<% end -%>
<meta charset="utf-8">
<title><%= @errorpage['title'] %></title>
<% if @errorpage['favicon'] && @errorpage['favicon'] != :undef -%>
<link rel="shortcut icon" href="<%= @errorpage['favicon'] %>">
<% end -%>
<style>
* { margin: 0; padding: 0; }
body { display: flex; flex-direction: column; min-height: 100vh; background: #fff; font: 14px/22px system-ui, -apple-system, 'Segoe UI', Roboto, Lato, Helvetica, Arial, sans-serif; color: #202122; }
.content { box-sizing: border-box; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 32px; margin: 0 auto; padding: 32px; max-width: 640px; text-align: center; }
.footer { border-top: 1px solid #eaecf0; background: #f8f9fa; padding: 2em 1em; font-size: 12px; text-align: center; }
#logo { display: block; }
a img { border: 0; }
.content-text { display: flex; flex-direction: column; gap: 8px; }
h1 { font-size: 18px; line-height: 28px; font-weight: bold; }
a { color: #36c; text-decoration: none; }
a:hover { text-decoration: underline; }
code { font-family: inherit; }
summary { font-weight: bold; cursor: pointer; }
details[open] { background: #970302; color: #dfdedd; }
.text-muted { color: #777; }
.external { display: inline-flex; align-items: center; gap: 4px; }
.external svg { width: 14px; height: 14px; fill: currentColor; }
@media (prefers-color-scheme: dark) {
  body { background: #101418; color: #eaecf0; }
  a { color: #88a3e8; }
  .footer { border-top: 1px solid #54595d; background: #202122; }
  <%# The Cloud VPS and Toolforge logos have dark text. -%>
  #logo[src$="-logo.svg"], #wmfLogo { filter: invert(1) hue-rotate(180deg); }
  .text-muted { color: #888; }
}
</style>
<meta name="color-scheme" content="light dark">
<div class="content" role="main">
<% if @errorpage['logo_link'] && @errorpage['logo_link'] != :undef -%>
<a href="<%= @errorpage['logo_link'] %>"><% end %><img id="logo" src="<%= @errorpage['logo_src'] %>" alt="<%= @errorpage['logo_alt'] %>" width="<%= @errorpage['logo_width'] %>"<% if @errorpage['logo_height'] && @errorpage['logo_height'] != :undef %> height="<%= @errorpage['logo_height'] %>"<% end %>>
<% if @errorpage['logo_link'] && @errorpage['logo_link'] != :undef -%>
</a>
<% end -%>
<script>
if ( /(^|\.)wikipedia\.org$/.test( location.hostname ) ) {
	document.getElementById( 'logo' ).outerHTML = '<picture>' +
		'<source media="(max-width: 639px)" srcset="https://www.wikimedia.org/static/images/errorpages/baby-globe-phone-250px.png">' +
		'<img id="logo" src="https://www.wikimedia.org/static/images/errorpages/baby-globe-laptop-250px.png" alt="Wikipedia" width="120" height="120">' +
		'</picture>';
}
</script>
<div class="content-text">
<h1><%= @errorpage['pagetitle'] %></h1>
<%- if @errorpage.has_key? 'content' and @errorpage['content'] %>
<%= @errorpage['content'] %>
<%- else -%>
<p>Our servers are currently under maintenance or experiencing a technical problem.

Please <a href="" title="Reload this page" onclick="window.location.reload(false); return false">try again</a> in a few&nbsp;minutes.</p>

<p>See the error message at the bottom of this page for more&nbsp;information.</p>
<%- end -%>
</div>
<a class="external" href="https://www.wikimediastatus.net/">Wikimedia Status <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M17 17H3V3h5V1H3a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-5h-2z"/><path d="M11 1l3.29 3.29-5.73 5.73 1.42 1.42 5.73-5.72L19 9V1z"/></svg></a>
<a href="https://wikimediafoundation.org/"><img id="wmfLogo" src="https://www.wikimedia.org/static/images/wmf.png" srcset="https://www.wikimedia.org/static/images/wmf-2x.png 2x" alt="Wikimedia Foundation" width="86" height="86"></a>
</div>
<% if @errorpage['footer'] && @errorpage['footer'] != :undef -%>
<div class="footer"><%= @errorpage['footer'] %></div>
<% end -%>
</html>
