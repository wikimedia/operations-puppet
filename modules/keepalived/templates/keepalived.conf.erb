<%#- SPDX-License-Identifier: Apache-2.0 -%>
# Note: This file is managed by puppet.

global_defs {
<%- if @track_script -%>
  script_security
<%- end -%>
}

<%- if @track_script -%>
vrrp_script failover_track_script {
  script "<%= @track_script %>"
  user <%= @track_script_user %>
  interval 10
  weight 150
  fall 1
  rise 1
}
<%- end -%>

<%- unless @vips_v4.empty? -%>
vrrp_instance vrrp_ipv4 {
  state <%= @default_state %>
  interface <%= @interface %>
  virtual_router_id <%= @virtual_router_id %>
  priority <%= @priority %>
  advert_int 1
  authentication {
    auth_type PASS
    auth_pass <%= @auth_pass %>
  }
  virtual_ipaddress {
<% @vips_v4.each do |vip| -%>
    <%= vip %>
<% end -%>
  }
  unicast_peer {
<% @peers_v4.each do |peer| -%>
    <%= peer %>
<% end -%>
  }
<%- if @track_script -%>
  track_script {
    failover_track_script
  }
<%- end -%>
}
<%- end -%>

<%- unless @vips_v6.empty? -%>
vrrp_instance vrrp_ipv6 {
  state <%= @default_state %>
  interface <%= @interface %>
  virtual_router_id <%= @virtual_router_id %>
  priority <%= @priority %>
  advert_int 1
  virtual_ipaddress {
<% @vips_v6.each do |vip| -%>
    <%= vip %>
<% end -%>
  }
  unicast_src_ip <%= @source_v6 %>
  unicast_peer {
<% @peers_v6.each do |peer| -%>
    <%= peer %>
<% end -%>
  }
<%- if @track_script -%>
  track_script {
    failover_track_script
  }
<%- end -%>
}
<%- end -%>
