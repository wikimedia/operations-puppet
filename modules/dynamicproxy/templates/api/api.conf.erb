server {
    listen [::1]:15668 proxy_protocol;

    set_real_ip_from ::1/128;
    real_ip_header proxy_protocol;

    location / {
        include uwsgi_params;
        uwsgi_pass unix:/run/uwsgi/invisible-unicorn.sock;

<%- if @read_only -%>
        limit_except GET {
            deny all;
        }
<%- end -%>
    }

    location /healthz {
        return 200 'OK';
        add_header Content-Type text/plain;
    }
}
