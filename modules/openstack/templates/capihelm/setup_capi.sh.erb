#!/usr/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# Install CAPI with openstack bits on an existing k8s cluster
#
# Excerpted from 
#
#   https://opendev.org/openstack/magnum-capi-helm/src/branch/master/devstack/contrib/new-devstack.sh#L192-L269%E2%94%82
#

set -x

# For install from our private chart and image repos, the version strings
#  from puppet. To upgrade or update things, you can dig up the latest package
#  versions with the following:
#
# Get latest capi-helm-charts tag
#LATEST_TAG=$(curl -fsL https://api.github.com/repos/azimuth-cloud/capi-helm-charts/tags | jq -r '.[0].name')
# Curl the dependencies URL
#DEPENDENCIES_JSON=$(curl -fsL https://github.com/azimuth-cloud/capi-helm-charts/releases/download/$LATEST_TAG/dependencies.json)
# Parse JSON into bash variables
#ADDON_PROVIDER=$(echo $DEPENDENCIES_JSON | jq -r '.["addon-provider"]')
#CLUSTER_API_JANITOR_OPENSTACK=$(echo $DEPENDENCIES_JSON | jq -r '.["cluster-api-janitor-openstack"]')
#CERT_MANAGER=$(echo $DEPENDENCIES_JSON | jq -r '.["cert-manager"]')



CLUSTER_API=<%= @cluster_api_version %>
CLUSTER_API_PROVIDER_OPENSTACK=<%= @cluster_api_provider_openstack_version %>

DOCKER_REPO_BASE=<%= @docker_repo_base %>

# copy kubeconfig file into standard location
mkdir -p /root/.kube
sudo cp /etc/rancher/k3s/k3s.yaml /root/.kube/config

# Install cert manager
{
    helm upgrade cert-manager cert-manager \
      --install \
      --namespace cert-manager \
      --create-namespace \
      --repo <%= @helm_repo %> \
      --set installCRDs=true \
      --wait \
      --timeout 10m
} || {
    kubectl -n cert-manager get pods |  awk '$1 && $1!="NAME" { print $1 }' | xargs -n1 kubectl -n cert-manager logs
    exit
}

# Install clusterctl
curl -L <%= @cluster_ctl_url %>/$CLUSTER_API/clusterctl-linux-amd64 -o clusterctl
sudo install -o root -g root -m 0755 clusterctl /usr/local/bin/clusterctl

# Drop in a clusterctl config to load images from the cloud-vps repo rather
#  than the upstream repos hard-coded in clusterctl:
mkdir $HOME/.config/cluster-api
echo -e "images:\n  all:\n    repository: $DOCKER_REPO_BASE/cluster-api" > $HOME/.config/cluster-api/clusterctl.yaml

clusterctl init \
    --core cluster-api:$CLUSTER_API \
    --bootstrap kubeadm:$CLUSTER_API \
    --control-plane kubeadm:$CLUSTER_API \
    --infrastructure openstack:$CLUSTER_API_PROVIDER_OPENSTACK

# Install addon manager
helm upgrade cluster-api-addon-provider cluster-api-addon-provider \
  --install \
  --repo <%= @helm_repo %> \
  --namespace capi-addon-system \
  --create-namespace \
  --wait \
  --set-string image.repository=$DOCKER_REPO_BASE/azimuth-cloud/cluster-api-addon-provider \
  --set-string image.tag=latest \
  --timeout 10m

# Install janitor
helm upgrade cluster-api-janitor-openstack cluster-api-janitor-openstack \
  --install \
  --repo <%= @helm_repo %> \
  --namespace capi-janitor-system \
  --create-namespace \
  --wait \
  --set-string image.repository=$DOCKER_REPO_BASE/azimuth-cloud/cluster-api-janitor-openstack \
  --set-string image.tag=latest \
  --timeout 10m

