#!/usr/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# Install CAPI with openstack bits on an existing k8s cluster
#
# Excerpted from 
#
#   https://opendev.org/openstack/magnum-capi-helm/src/branch/master/devstack/contrib/new-devstack.sh#L192-L269%E2%94%82
#
#   and then updated to resemble the simplified cluster at
#
#   https://satishdotpatel.github.io/openstack-magnum-capi/
#

set -x

KUBECONFIG=/etc/rancher/k3s/k3s.yaml

CLUSTER_API=<%= @cluster_api_version %>
CLUSTER_API_PROVIDER_OPENSTACK=<%= @cluster_api_provider_openstack_version %>

DOCKER_REPO_BASE=<%= @docker_repo_base %>

# copy kubeconfig file into standard location
mkdir -p /root/.kube
sudo cp /etc/rancher/k3s/k3s.yaml /root/.kube/config

# Install clusterctl
curl -L <%= @cluster_ctl_url %>/clusterctl/$CLUSTER_API/clusterctl-linux-amd64 -o clusterctl
sudo install -o root -g root -m 0755 clusterctl /usr/local/bin/clusterctl

# Drop in a clusterctl config to load images from the cloud-vps repo rather
#  than the upstream repos hard-coded in clusterctl:
mkdir $HOME/.config/cluster-api
echo -e "images:\n  all:\n    repository: $DOCKER_REPO_BASE/cluster-api" > $HOME/.config/cluster-api/clusterctl.yaml

# Install the ORC CRD, needed for CAPO >=v0.12
#  https://k-orc.cloud/crd-reference/
kubectl apply -f <%= @cluster_ctl_url %>/ORC/install.yaml


export EXP_CLUSTER_RESOURCE_SET=true
export EXP_KUBEADM_BOOTSTRAP_FORMAT_IGNITION=true
export CLUSTER_TOPOLOGY=true

clusterctl init \
    --core cluster-api:$CLUSTER_API \
    --bootstrap kubeadm \
    --control-plane kubeadm \
    --infrastructure openstack:$CLUSTER_API_PROVIDER_OPENSTACK
