# SPDX-License-Identifier: Apache-2.0
# mod_qos: errorlog + accesslog
# https://mod-qos.sourceforge.net/#errorlog
# https://mod-qos.sourceforge.net/#accesslog

counter apache_qos_errors_total        by error, code
gauge   apache_qos_current_connections by filename
gauge   apache_qos_all_connections     by filename
counter apache_http_status_total       by method, status
counter apache_qos_events_total        by event, ev_codes

# Error log

/\[qos:error\].*mod_qos\((?P<code>\d+)\): .*?(?P<error>QS_[A-Za-z0-9_]+)/ {
  apache_qos_errors_total[$error][$code]++
}

# BrokenConnection
/\[qos:error\].*mod_qos\((?P<code>\d+)\): .*?BrokenConnection/ {
  apache_qos_errors_total["BrokenConnection"][$code]++
}

# DSCP socket option failure
/\[qos:error\].*mod_qos\((?P<code>\d+)\): .*?\bDSCP\b/ {
  apache_qos_errors_total["QS_Set_DSCP"][$code]++
}

# Request rate limit
/\[qos:error\].*mod_qos\((?P<code>\d+)\): .*?request rate limit/ {
  apache_qos_errors_total["RequestRateLimit"][$code]++
}

# Invalid request line
/\[qos:error\].*mod_qos\((?P<code>\d+)\): .*?invalid request line/ {
  apache_qos_errors_total["InvalidRequestLine"][$code]++
}

# Invalid URL encoding
/\[qos:error\].*mod_qos\((?P<code>\d+)\): .*?invalid url encoding/ {
  apache_qos_errors_total["InvalidUrlEncoding"][$code]++
}

# Invalid JSON syntax
/\[qos:error\].*mod_qos\((?P<code>\d+)\): .*?invalid JSON syntax/ {
  apache_qos_errors_total["InvalidJSON"][$code]++
}

# Drop header(s)
/\[qos:error\].*mod_qos\((?P<code>\d+)\): .*?\bdrop [A-Za-z0-9_-]+ header/ {
  apache_qos_errors_total["DropHeader"][$code]++
}

# No permit rule match
/\[qos:error\].*mod_qos\((?P<code>\d+)\): .*?no permit rule match/ {
  apache_qos_errors_total["NoPermitRuleMatch"][$code]++
}

# LimitRequestBody
/\[qos:error\].*mod_qos\((?P<code>\d+)\): .*?QS_LimitRequestBody/ {
  apache_qos_errors_total["QS_LimitRequestBody"][$code]++
}

# No valid IP header found
/\[qos:error\].*mod_qos\((?P<code>\d+)\): .*?no valid IP header found/ {
  apache_qos_errors_total["NoValidIPHeader"][$code]++
}

# Handler disabled for host
/\[qos:error\].*mod_qos\((?P<code>\d+)\): .*?handler has been disabled for this host/ {
  apache_qos_errors_total["HandlerDisabled"][$code]++
}

# Console "not acceptable" family (070)
/\[qos:error\].*mod_qos\((?P<code>\d+)\): .*?\bconsole, not acceptable/ {
  apache_qos_errors_total["ConsoleNotAcceptable"][$code]++
}

# Redirect
/\[qos:error\].*mod_qos\((?P<code>\d+)\): .*?\bredirect to\b/ {
  apache_qos_errors_total["Redirect"][$code]++
}

# Access log

# qos.srv / qos.all
/"qos":\{[^}]*"srv":"(?P<srv>\d+)"/ {
  apache_qos_current_connections[getfilename()] = int($srv)
}
/"qos":\{[^}]*"all":"(?P<all>\d+)"/ {
  apache_qos_all_connections[getfilename()] = int($all)
}

# HTTP status by method
/"request":\{"method":"(?P<method>[A-Z]+)".*"response":\{"status_code":(?P<status>\d{3})/ {
  apache_http_status_total[$method][$status]++
}

# Default event
/"qos":\{[^}]*"ev":"-"/ {
  apache_qos_events_total["default"]["-"]++
}

# D = denied
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*D[^"]*)"/ {
  apache_qos_events_total["denied"][$ev]++
}

# S = pass (VIP session)
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*S[^"]*)"/ {
  apache_qos_events_total["pass_vip_session"][$ev]++
}

# V = cookie VIP
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*V[^"]*)"/ {
  apache_qos_events_total["create_vip_cookie"][$ev]++
}

# v = VIP-IP
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*v[^"]*)"/ {
  apache_qos_events_total["vip_by_ip"][$ev]++
}

# K = no keep-alive
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*K[^"]*)"/ {
  apache_qos_events_total["no_keepalive"][$ev]++
}

# T = dynamic keep-alive
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*T[^"]*)"/ {
  apache_qos_events_total["dynamic_keepalive"][$ev]++
}

# r = slow client
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*r[^"]*)"/ {
  apache_qos_events_total["slow_client"][$ev]++
}

# L = request slowdown
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*L[^"]*)"/ {
  apache_qos_events_total["request_slowdown"][$ev]++
}

# u = no user tracking cookie
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*u[^"]*)"/ {
  apache_qos_events_total["no_user_tracking_cookie"][$ev]++
}

# s = serialized request
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*s[^"]*)"/ {
  apache_qos_events_total["serialized_request"][$ev]++
}

# A = connection abort
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*A[^"]*)"/ {
  apache_qos_events_total["connection_abort"][$ev]++
}
