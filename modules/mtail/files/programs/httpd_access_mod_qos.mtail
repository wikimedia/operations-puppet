# SPDX-License-Identifier: Apache-2.0
# https://mod-qos.sourceforge.net/#accesslog

gauge   apache_qos_current_connections by filename
gauge   apache_qos_all_connections     by filename
counter apache_http_status_total       by method, status
counter apache_qos_events_total        by event, ev_codes

# qos.srv / qos.all
/"qos":\{[^}]*"srv":"(?P<srv>\d+)"/ {
  apache_qos_current_connections[getfilename()] = int($srv)
}
/"qos":\{[^}]*"all":"(?P<all>\d+)"/ {
  apache_qos_all_connections[getfilename()] = int($all)
}

# HTTP status by method
/"request":\{"method":"(?P<method>[A-Z]+)".*"response":\{"status_code":(?P<status>\d{3})/ {
  apache_http_status_total[$method][$status]++
}

# Default event
/"qos":\{[^}]*"ev":"-"/ {
  apache_qos_events_total["default"]["-"]++
}

# D = denied
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*D[^"]*)"/ {
  apache_qos_events_total["denied"][$ev]++
}

# S = pass (VIP session)
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*S[^"]*)"/ {
  apache_qos_events_total["pass_vip_session"][$ev]++
}

# V = cookie VIP
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*V[^"]*)"/ {
  apache_qos_events_total["create_vip_cookie"][$ev]++
}

# v = VIP-IP
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*v[^"]*)"/ {
  apache_qos_events_total["vip_by_ip"][$ev]++
}

# K = no keep-alive
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*K[^"]*)"/ {
  apache_qos_events_total["no_keepalive"][$ev]++
}

# T = dynamic keep-alive
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*T[^"]*)"/ {
  apache_qos_events_total["dynamic_keepalive"][$ev]++
}

# r = slow client
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*r[^"]*)"/ {
  apache_qos_events_total["slow_client"][$ev]++
}

# L = request slowdown
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*L[^"]*)"/ {
  apache_qos_events_total["request_slowdown"][$ev]++
}

# u = no user tracking cookie
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*u[^"]*)"/ {
  apache_qos_events_total["no_user_tracking_cookie"][$ev]++
}

# s = serialized request
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*s[^"]*)"/ {
  apache_qos_events_total["serialized_request"][$ev]++
}

# A = connection abort
/"qos":\{[^}]*"ev":"(?P<ev>[^"]*A[^"]*)"/ {
  apache_qos_events_total["connection_abort"][$ev]++
}
