# act only on interactive shells
if [ "x${PS1-}" != x ]; then
  export ETCDCTL_API=3
  export ETCDCTL_CERT="<%= @client_cert %>"
  export ETCDCTL_KEY="<%= @client_key %>"
  export ETCDCTL_CACERT="<%= @trusted_ca %>"
  export ETCDCTL_ENDPOINTS="<%= @adv_client_url %>"
fi
