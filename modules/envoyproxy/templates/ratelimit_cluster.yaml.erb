<%#- SPDX-License-Identifier: Apache-2.0 -%>
name: <%= @upstream_name %>
type: STRICT_DNS
connect_timeout: <%= @connect_timeout %>s
lb_policy: ROUND_ROBIN
typed_extension_protocol_options:
  envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
    "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
    explicit_http_config:
      http2_protocol_options: {}
load_assignment:
  cluster_name: <%= @upstream_name %>
  endpoints:
  - lb_endpoints:
    - endpoint:
        address:
          socket_address:
            address: <%= @rate_limit_config['address'] %>.
            port_value: <%= @rate_limit_config['port'] %>
transport_socket:
  name: envoy.transport_sockets.tls
  typed_config:
    "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
    sni: <%= @rate_limit_config['address'] %>
    common_tls_context:
      tls_params:
        cipher_suites: ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384
      validation_context:
        trusted_ca:
          filename: /etc/ssl/certs/ca-certificates.crt