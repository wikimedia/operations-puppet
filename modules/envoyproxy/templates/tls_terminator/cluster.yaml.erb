<%#- SPDX-License-Identifier: Apache-2.0 -%>
name: <%= @upstream_name %>
connect_timeout: <%= @connect_timeout %>s
<%- if @idle_timeout -%>
typed_extension_protocol_options:
  envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
    "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
    common_http_protocol_options:
      idle_timeout: <%= @idle_timeout %>s
      <%- if @max_requests_per_conn
      # We limit persistent connections to a finite number of requests.
      # This can be important to keep our load-balancing in order if both the
      # client and the server can maintain persistent connections indefinitely.
      -%>
      max_requests_per_connection: <%= @max_requests_per_conn %>
      <%- end -%>
    use_downstream_protocol_config: {}
<%- end -%>
type: strict_dns
lb_policy: round_robin
load_assignment:
  cluster_name: <%= @upstream_name %>
  endpoints:
  - lb_endpoints:
    - endpoint:
        address:
          socket_address:
            address: <%= @upstream.fetch('upstream_addr', @facts["networking"]["fqdn"]) %>
            port_value: <%= @upstream['upstream_port'] %>
<%- if @upstream['upstream_tls'] -%>
transport_socket:
  name: envoy.transport_sockets.tls
  typed_config:
    "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
<%- if @upstream['upstream_sni'] -%>
    sni: <%= @upstream['upstream_sni'] %>
<%- end -%>
    common_tls_context:
      validation_context:
        trusted_ca:
          filename: <%= @upstream['upstream_trusted_ca'] || '/etc/ssl/certs/ca-certificates.crt' %>
<%- end -%>
