<%#- SPDX-License-Identifier: Apache-2.0 -%>
[Unit]
Description=Thanos rule (instance %i)
Documentation=https://github.com/improbable-eng/thanos/

[Service]
Slice=thanos.slice
ExecReload=
ExecReload=/bin/kill -HUP $MAINPID
ExecStart=
ExecStart=/usr/bin/thanos rule \
<%#- avoid log spam https://phabricator.wikimedia.org/T383966#10771692 -%>
  --log.level error \
  --web.route-prefix /rule \
  --web.external-prefix /rule \
  --http-address <%= @http_address %> \
  --grpc-address <%= @grpc_address %> \
  --data-dir <%= @data_dir %> \
<%- if @use_objstore -%>
  --objstore.config-file <%= @objstore_config_file %> \
<%- end -%>
  <%= @tracing_enabled ? "--tracing.config-file #{@tracing_config_file}" : '' %> \
  --alert.query-url <%= @query_url %> \
  --alert.relabel-config-file <%= @relabel_config_file %> \
  --alertmanagers.config-file <%= @am_config_file %> \
  --alert.label-drop replica \
  --label 'recorder="thanos-rule@%i"' \
  --label 'replica="<%= @replica %>"' \
<%- unless @add_labels.empty? -%>
  <%= @add_labels.map { |add_label| "--label #{add_label}" }.join(" ") %> \
<%- end -%>
  <%= @merged_rule_files.map { |f| "--rule-file #{f}" }.join(" ") %> \
  --tsdb.retention <%= @retention_time %> \
  --query http://localhost:<%= @query_port %>
