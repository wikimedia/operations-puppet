<%#- SPDX-License-Identifier: Apache-2.0 -%>
[Service]
Slice=thanos.slice
SendSIGKILL=yes
Environment=OTEL_SERVICE_NAME=%N
RuntimeDirectoryPreserve=yes
RuntimeDirectory=thanos-query
ExecStart=
ExecStart=/usr/bin/thanos query \
<% if @memlimit_ratio > 0 -%>
  --enable-auto-gomemlimit \
  --auto-gomemlimit.ratio=<%= @memlimit_ratio %> \
<% end -%>
  --http-address <%= @http_address %> \
  --query.replica-label <%= @replica_label %> \
  --store.sd-files <%= @sd_files %> \
  --query.active-query-path /run/thanos-query \
  --grpc-compression snappy \
  <%= @tracing_enabled ? "--tracing.config-file #{@tracing_config_file}" : '' %> \
<%- if @query_url -%>
  --alert.query-url <%= @query_url %> \
<%- end -%>
  <%= @logging_cmdline %>
