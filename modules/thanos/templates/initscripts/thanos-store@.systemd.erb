<%#- SPDX-License-Identifier: Apache-2.0 -%>
[Unit]
Description=Thanos store (instance %i)
Documentation=https://github.com/thanos-io/thanos/

[Service]
Slice=thanos.slice
Restart=always
User=thanos
EnvironmentFile=/etc/default/thanos-store
ExecReload=/bin/kill -HUP $MAINPID
TimeoutStopSec=20s
SendSIGKILL=no
SyslogIdentifier=%N
ExecStart=
# Use = for min/max time options since their values can start with -
ExecStart=/usr/bin/thanos store \
<% if @memlimit_ratio > 0 -%>
  --enable-auto-gomemlimit \
  --auto-gomemlimit.ratio=<%= @memlimit_ratio %> \
<% end -%>
  --http-address <%= @http_address %> \
  --grpc-address <%= @grpc_address %> \
  --data-dir <%= @data_dir %> \
  --index-cache.config-file <%= @cache_config_file %> \
  --objstore.config-file <%= @objstore_config_file %> \
  --store.limits.request-series <%= @limits_request_series %> \
  --store.limits.request-samples <%= @limits_request_samples %> \
  <%= @min_time ? "--min-time=#{@min_time}" : '' %> \
  <%= @max_time ? "--max-time=#{@max_time}" : '' %> \
  <%= @tracing_enabled ? "--tracing.config-file #{@tracing_config_file}" : '' %> \
  <%= @consistency_delay ? "--consistency-delay=#{@consistency_delay}" : '' %> \
  <%= @block_selector ? "--selector.relabel-config-file=#{@selector_relabel_config_file}" : '' %>
