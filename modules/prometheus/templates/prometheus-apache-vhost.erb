# Serve vhost on localhost too when reverse-proxied by envoy

<VirtualHost *:80 [::1]:80 127.0.0.1:80>
    ServerName prometheus
    ServerAlias prometheus.*
    ServerAlias prometheus-*.*
    ServerAlias <%= @facts["networking"]["fqdn"] %>

    # enable mod_proxy to reverse-proxy to https
    SSLProxyEngine on

    DocumentRoot /var/www/html

    Include /etc/apache2/prometheus.d/*.conf
</VirtualHost>
