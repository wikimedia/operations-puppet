<%#- SPDX-License-Identifier: Apache-2.0 -%>
    # disable golang debugging from outside localhost
    <%- if @redirect_url != "" -%>
    <Location /<%= @redirect_url %>/debug >
    <%- else -%>
    <Location /debug >
    <%- end -%>
        Require all denied
    </Location>

    # disable quit/reload from outside localhost
    <%- if @redirect_url != "" -%>
    <LocationMatch ^/<%= @redirect_url %>/-/(quit|reload) >
    <%- else -%>
    <LocationMatch ^/-/(quit|reload) >
    <%- end -%>
        Require all denied
    </LocationMatch>

    <% if @redirect_to_homepage %>
    RewriteRule ^/$ %{REQUEST_SCHEME}://%{HTTP_HOST}/<%= @redirect_url %> [R=302]
    <% end %>

    <%- if @proxy_pass.is_a?(Array) -%>
    <Proxy "balancer://<%= @title %>">
    <%- @proxy_pass.each do |url| -%>
        BalancerMember "<%= url %>" max=<%= @maxconn %> acquire=1000
    <%- end -%>
    </Proxy>
    ProxyPass /<%= @redirect_url %> balancer://<%= @title %>
    <%- else -%>
    ProxyPass /<%= @redirect_url %> <%= @proxy_pass %> max=<%= @maxconn %> acquire=1000
    <%- end -%>