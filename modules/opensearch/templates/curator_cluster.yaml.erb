<%#- SPDX-License-Identifier: Apache-2.0 -%>
---
client:
  hosts:
<% @curator_hosts.each do |host| -%>
    - <%= host %>
<% end -%>
  port: <%= @http_port %>
  url_prefix:
  timeout: 30
  master_only: False
<% if @curator_username && @curator_password %>
  username: '<%= @curator_username %>'
  password: '<%= @curator_password %>'
<%- end %>
<%- if @curator_ca_cert %>
  use_ssl: True
  certificate: '<%= @curator_ca_cert %>'
<%- end %>

logging:
  loglevel: DEBUG
  logfile:
  logformat: default
  blacklist: ['elasticsearch', 'urllib3']
