<%#- SPDX-License-Identifier: Apache-2.0 -%>
[Unit]
Description=Versity S3 Gateway daemon
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/default/versitygw@%i
User=<%= @unix_user %>
Group=<%= @unix_group %>
ExecStart=/usr/bin/versitygw posix $DATA_PATH --cert $TLS_CERT --key $TLS_KEY
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
