import ztpclient
import logging.handlers
import logging
import os
import sys

srlinux_image_url = 'http://<%= @facts['networking']['fqdn'] %>:8080/srlinux/srlinux-24.10.4-244.bin'
srlinux_image_md5_url = 'http://<%= @facts['networking']['fqdn'] %>:8080/srlinux/srlinux-24.10.4-244.md5'
srlinux_config_url = 'http://<%= @facts['networking']['fqdn'] %>:8080/srlinux/nokia-bootstrap.json'


LOG_FORMAT = '%(asctime)s %(levelname)s %(filename)s(%(lineno)d)%(message)s'
LOG_LEVEL = "INFO"
LOG_DIR = '/tmp'
LOG_FILE = 'install.log'
LOG_SIZE = 10 * 1024 * 1024  # 10M
LOG_COUNT = 3


class ZTP(object):

    def __init__(self):
        self.logger = logging.getLogger()
        self.setup_logging()
        self.initial_data = {}
        self.client = ztpclient.APIClient()

    def setup_logging(self, log_stdout=True, log_level=LOG_LEVEL, log_dir=LOG_DIR, log_file=LOG_FILE, log_size=LOG_SIZE,  log_count=LOG_COUNT):
        self.logger.setLevel(logging.getLevelName(log_level))

        log_file = '%s/%s' % (log_dir, log_file)

        fh = logging.handlers.RotatingFileHandler(
            log_file, maxBytes=log_size, backupCount=log_count)
        fh.setFormatter(logging.Formatter(LOG_FORMAT))
        self.logger.addHandler(fh)

        if log_stdout:
            ch = logging.StreamHandler(sys.stdout)
            ch.setFormatter(logging.Formatter(LOG_FORMAT))
            self.logger.addHandler(ch)

        self.logger.info("Logger has been setup")

    def log_message(self, log_msg, log_type="info", log_to_controller=True):
        getattr(self.logger, log_type)(log_msg)

    def nos_install(self, image_url, image_md5_url):
        filename = image_url.rsplit('/', 1)[-1]
        self.log_message("Going to Install OS using {}".format(image_url))
        ret = self.client.image_upgrade(image_url, image_md5_url)
        if ret:
            self.log_message("OS nos_install status {}".format(ret['status']))
            status = ret.get("status", None)
            if status is None:
                msg = "OS nos_install failed status is empty"
                self.log_message(msg)
                raise Exception(msg)
            elif status != 0:
                msg = "OS nos_install failed. received non-zero status"
                self.log_message(msg)
                raise Exception(msg)
            return int(ret['status'])
        self.log_message("OS nos_install failed")
        raise Exception("OS nos_install failed")

    def nos_configure(self, config_url):
        self.log_message(log_msg="Going to retrieve config from %s" % (config_url))
        ret = self.client.configure(config_url)
        if ret:
            self.log_message(
                "OS nos_configure status {}".format(ret['status']))
            return int(ret['status'])
        self.log_message("OS nos_configure failed")
        raise Exception("OS nos_configure failed")

    def kick_device(self):
        try:
            self.nos_install(image_url=srlinux_image_url, image_md5_url=srlinux_image_md5_url)
            self.nos_configure(config_url=srlinux_config_url)
        except Exception as e:
            self.log_message(log_msg="Exception in ztp %s" %
                            (str(e)), log_type="exception")
            sys.exit(1)

if __name__ == '__main__':
    ztp = ZTP()
    ztp.kick_device()