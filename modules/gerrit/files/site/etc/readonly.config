# SPDX-License-Identifier: Apache-2.0
#
# https://gerrit.wikimedia.org/r/plugins/readonly/Documentation/config.md
#
# Each allowSshCommand value is a prefix of the SSH command line. A value that
# starts with ^ is a regex that must match the whole command line.
[readonly]
    # When doing switch over we need to be able to monitor the leftover
    # replication tasks by using `replication list`. We might also want to
    # start replications and thus allow any `replication` command.
    allowSshCommand = replication
