<%#- SPDX-License-Identifier: Apache-2.0 -%>
# https://github.com/prymitive/karma/blob/master/docs/CONFIGURATION.md
alertmanager:
  interval: 10s
  servers:
    - name: "<%= @facts["networking"]["domain"] %>"
      uri: "http://alertmanager-<%= @site %>.<%= @facts["networking"]["domain"] %>"
      proxy: true
      healthcheck:
        visible: false
        filters: <% @expected_deadmanswitch_alerts.sort.each do |k, v| %><% if k.start_with?('prometheus_') %>
          <%= k %>:
            - alertname=DeadManSwitch
            - source=<%= v['source'] %>
            - prometheus=<%= v['prometheus'] %>
            - site=<%= v['site'] %><% else %>
          <%= k %>:
            - alertname=DeadManSwitch
            - source=<%= v['source'] %><% end %><% end %>
<%- if @metricsinfra_username and @metricsinfra_password -%>
    - name: "wmcloud.org"
      uri: "https://<%= @metricsinfra_username %>:<%= @metricsinfra_password %>@metricsinfra-alertmanager-rw.wmcloud.org"
      proxy: true
<%- end -%>

# skip wmcloud from silences by default
silenceForm:
  defaultAlertmanagers:
    - "<%= @facts["networking"]["domain"] %>"

silences:
  comments:
    linkDetect:
      rules:
        - regex: "(T[0-9]+(#[0-9]+)?)"
          uriTemplate: https://phabricator.wikimedia.org/$1

<% if @auth_header %>
# Auto-fill silence dialog with the authenticated user
authentication:
  header:
    name: <%= @auth_header %>
    value_re: ^(.+)$
<% end %>

receivers:
  # Hide 'logger' receiver, common to all alerts
  strip:
    - 'logger'
  # This feature is not merged upstream (March 2025)
  # See also https://github.com/prymitive/karma/pull/6404/files
  # And https://phabricator.wikimedia.org/T353457
  # remove these receivers when duplicated
  stripIfDuplicated:
    - 'default'
    - 'sre-irc'

labels:
  strip:
    # Hide 'info' label since it is duplicated into 'summary' annotation for Icinga alerts
    - 'info'
  valueOnly:
    # Don't display 'severity' and 'alertname' label name since that's
    # implied, and highlighted by colors
    - 'severity'
    - 'alertname'
  color:
    custom:
      # Highlight 'instance' (host) and 'source' labels for better visibility
      instance:
        - value_re: '.*'
          color: '#696969'
      source:
        - value_re: '.*'
          color: '#d7d7d7'

      # Match Icinga background colors for 'severity'
      severity:
        - value: 'page'
          color: '#e74c3c'
        - value: 'critical'
          color: '#ffd4c9'
        - value: 'warning'
          color: '#ffda9f'
        - value: 'unknown'
          color: '#eeaeee'

# Sort by decreasing severity
grid:
  sorting:
    order: label
    reverse: false
    label: severity
    customValues:
      labels:
        severity:
          page: 0
          critical: 1
          warning: 2
          unknown: 3

# UI defaults
ui:
  multiGridLabel: 'severity'
  # Default to about two groups per line, depending on users' display.
  # Users wishing to change this can do so from the "cog menu" on top right. Preferences are saved
  # into the browser's Local Storage.
  minimalGroupWidth: 450

history:
  rewrite:
    # Fetching history doesn't work on librenms/grafana/icinga alerts.
    - source: 'https://(librenms|grafana|icinga)\..*'
      uri: ''
    # External to internal production Prometheus - T329294
    - source: 'https://prometheus-([^.]+).wikimedia.org/(.*)'
      uri: 'http://prometheus.svc.$1.wmnet/$2'

# Start with 'description' label collapsed
annotations:
  hidden:
    - description

filters:
  default:
    - "@state=active"
    - "@cluster=<%= @facts["networking"]["domain"] %>"

karma:
  name: "Alerts for <%= @facts["networking"]["domain"] %>"

# Enable ack'ing alerts via silences. See also alertmanager::ack
alertAcknowledgement:
  enabled: true
