<%#- SPDX-License-Identifier: Apache-2.0 -%>
<%# Puppet-managed: Alertmanager Slack template (.tmpl.erb) %>

{{ define "slack.title" }}
{{ .CommonLabels.alertname }} ({{ len .Alerts }} alert{{ if gt (len .Alerts) 1 }}s{{ end }})
{{ end }}

{{- define "slack.text" -}}
*Status:* `{{ .Status | toUpper }}`  -  *Severity:* `{{ .CommonLabels.severity }}` {{ template "team_severity_emoji" . }}
{{- if .CommonAnnotations.summary }}
*Alert:* {{ .CommonAnnotations.summary }}
{{- else -}}
*Alert:* {{ .CommonLabels.alertname }}
{{- end -}}
{{- if .CommonLabels.team }}
*Team:* `{{ .CommonLabels.team }}` {{ template "team_mention" . }}
{{- end -}}
{{- if or .CommonAnnotations.dashboard .CommonAnnotations.runbook }}
*Links:*{{ if .CommonAnnotations.dashboard }} <{{ .CommonAnnotations.dashboard }}|Dashboard>{{ end }}{{ if and .CommonAnnotations.dashboard .CommonAnnotations.runbook }} |{{ end }}{{ if .CommonAnnotations.runbook }} <{{ .CommonAnnotations.runbook }}|Runbook>{{ end }}
{{- end }}
{{- if .CommonLabels.namespace }}
*Namespace:* `{{ .CommonLabels.namespace }}`
{{- end }}

*Firing:* {{ len .Alerts.Firing }}    •    *Resolved:* {{ len .Alerts.Resolved }}

{{- if .Alerts.Firing }}
  *Alerts firing:*
  {{- range .Alerts.Firing }}
    • {{ if .Annotations.summary -}}
        {{ .Annotations.summary }}
      {{- else if .Annotations.description -}}
        {{ .Annotations.description }}
      {{- else -}}
        (no summary)
      {{- end }}  _(started {{ .StartsAt }})_
  {{- end }}
{{- end }}

{{- if .Alerts.Resolved }}
  *Recently resolved:*
  {{- range .Alerts.Resolved }}
    • {{ if .Annotations.description -}}
        {{ .Annotations.description }}
      {{- else if .Annotations.summary -}}
        {{ .Annotations.summary }}
      {{- else -}}
        (no description)
      {{- end }}
  {{- end }}
{{- end }}
{{- end }}

{{- define "slack.title_link" -}}
  {{ .ExternalURL }}/#/alerts
{{- end }}

{{- define "team_severity_emoji" -}}
  {{- if eq .CommonLabels.team "mediawiki-engineering" -}}
    {{- template "team_mediawiki_engineering_emojis" . -}}
  {{- end -}}
{{- end -}}

{{/* Emojis for the "mediawiki-engineering" team */}}
{{- define "team_mediawiki_engineering_emojis" -}}
  {{- if eq .CommonLabels.severity "high" -}}
    :cowboy_mild_panic:
  {{- else if eq .CommonLabels.severity "critical" -}}
    :cowboy-cool-cry-mild-panic:
  {{- else if eq .CommonLabels.severity "page" -}}
    :mild-panic:
  {{- end -}}
{{- end -}}

{{- define "team_mention" -}}
  {{- if eq .CommonLabels.team "mediawiki-engineering" -}}
    {{- template "alerts_api_gateway_mention" . -}}
  {{- end -}}
{{- end -}}

{{/* Mentions for the "alerts-api-gateway" Slack group */}}
{{- define "alerts_api_gateway_mention" -}}
  {{- if eq .CommonLabels.severity "critical" -}}
    (<!subteam^S09JV17BJBH|@alerts-api-gateway>)
  {{- end -}}
{{- end -}}
