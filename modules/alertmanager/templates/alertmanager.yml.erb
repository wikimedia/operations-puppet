<%#- SPDX-License-Identifier: Apache-2.0 -%>
# Sample configuration.
# See https://prometheus.io/docs/alerting/configuration/ for documentation.

global:
  smtp_smarthost: 'localhost:25'
  smtp_from: 'sre-observability@<%= @facts["networking"]["domain"] %>'
  smtp_require_tls: false

  # Give alerts with no 'endsAt' field (e.g. librenms) a little more slack
  # See also https://phabricator.wikimedia.org/T285205
  resolve_timeout: '20m'

<% if @victorops_api_key %>
  victorops_api_key: '<%= @victorops_api_key %>'
<% end %>

# The directory from which notification templates are read.
templates:
  - '/etc/prometheus/alertmanager_templates/*.tmpl'

route:
  receiver: default
  group_by: ['alertname', 'cluster', 'scope', 'team']
  routes:
    # Log all notifications
    - receiver: 'logger'
      continue: true

    # Dead Man Switch - meta monitoring
    - match:
        alertname: 'DeadManSwitch'
        severity: 'info'
      repeat_interval: '5m'
      receiver: 'o11y-deadmanswitch'

<% if @sink_notifications %>
    #
    # ALL NOTIFICATIONS ARE BEING SINKED HERE AND GOING NOWHERE.
    # For testing purposes only.
    #
    - receiver: 'sink'
<% end %>

    # Compat Icinga alerts are routed to a 'sink' channel
    - match_re:
        alertname: '^Icinga/.*'
      receiver: 'irc-spam'
    - match:
        source: 'icinga'
      receiver: 'irc-spam'

    # Alerts for test/dev hosts are routed to the 'sink' channel
    - match_re:
        instance: '.+-(dev|test)([0-9]+.*)?'
      receiver: 'irc-spam'

    - match_re:
        instance: 'sretest.*'
      receiver: 'irc-spam'

    - match:
        severity: 'warning'
      repeat_interval: 72h
      continue: true

    - match:
        alertname: 'SystemdUnitFailed'
      repeat_interval: 24h
      continue: true

    # Fundraising pingthing alerts are routed to irc #wm-operations and fr-tech@wm.o
    - match:
        instance: 'https://donate.wikimedia.org/'
        job: 'blackbox/pingthing'
      receiver: 'fr-tech-ircmail'

    - match:
        scope: 'network'
      match_re:
        instance: '^(pfw|fasw).*'
      receiver: 'fr-tech-ircmail'
      continue: true

    # Generic pingthing alerts are routed to irc #wm-operations and noc@wm.o
    - match:
        job: 'blackbox/pingthing'
      receiver: 'noc-ircmail'

    # Team routes
    - match:
        team: 'sre'
      routes:
        - match:
            alertname: 'MediaWikiElevatedUnknownLogins'
          receiver: 'trust-and-safety-product-critical'
          continue: true
        - match:
            alertname: 'MediaWikiElevatedUnknownLogins'
          receiver: 'security-mail'
          continue: true
        - match:
            severity: 'page'
          receiver: 'sre-page'
        - match:
            severity: 'critical'
          receiver: 'sre-irc'
    - match:
        team: 'data-engineering'
      routes:
        - match:
            severity: 'critical'
          receiver: 'data-engineering-mail'
        - match:
            severity: 'page'
          receiver: 'data-engineering-slack-api-alerts'
        - match:
            severity: 'warning'
          receiver: 'data-engineering-ircmail'
        - match:
            severity: 'task'
          receiver: 'data-engineering-task'
    - match:
        team: 'data-persistence'
      routes:
        - match:
            severity: 'page'
          receiver: 'sre-page'
        - match:
            severity: 'critical'
          receiver: 'data-persistence-ircmail'
        - match:
            severity: 'warning'
          receiver: 'data-persistence-irc-feed'
        - match:
            severity: 'task'
          receiver: 'data-persistence-task'
    - match:
        team: 'serviceops'
      routes:
        - match:
            severity: 'task'
          receiver: 'serviceops-task'
    - match:
        team: 'data-platform'
      routes:
        - match:
            severity: task
          receiver: 'data-platform-task'
        - match:
            severity: page
          receiver: 'data-platform-page'
        # Send everything to email and IRC for data-plaform-alerts
        - receiver: 'data-platform-ircmail'
    - match:
        team: 'experiment-platform'
      routes:
        - match:
            severity: 'task'
          receiver: 'experiment-platform-task'
        - match_re:
            severity: 'warning|critical'
          receiver: 'experiment-platform-ircmailtask'

    - match:
        team: 'infrastructure-foundations'
      routes:
        # Send pages as normal
        - match:
            severity: 'page'
          receiver: 'sre-page'
          continue: true
        # Ensure criticals go toi #w-operations
        - match:
            severity: 'critical'
          receiver: 'sre-irc'
          continue: true
        # send criticals to #w-infrastructure-foundations too
        - match:
            severity: 'critical'
          receiver: 'infrastructure-foundations-irc'
    - match:
        team: 'collaboration-services'
      routes:
        - match:
            severity: 'critical'
          receiver: 'collaboration-services-critical'
        - match:
            severity: 'warning'
          receiver: 'collaboration-services-warning'
        - match:
            severity: 'task'
          receiver: 'collaboration-services-task'
    - match:
        team: 'collaboration-services-releng'
      routes:
        - match:
            severity: 'critical'
          receiver: 'collaboration-services-releng-critical'
        - match:
            severity: 'warning'
          receiver: 'collaboration-services-releng-warning'
        - match:
            severity: 'task'
          receiver: 'collaboration-services-releng-task'
    - match:
        team: 'dcops'
      receiver: 'dcops-mail'
      routes:
        - match:
            severity: 'task'
          # Default to #dcops project if none of the site routes match
          receiver: 'dcops-task'
          group_by: ['instance']
          routes:
<% ["eqiad", "eqord", "codfw", "eqdfw", "esams", "ulsfo", "drmrs", "eqsin", "magru"].each do |site| -%>
            - match_re:
                instance: '^.*<%= site %>.*$'
              receiver: 'dcops-<%= site %>-task'
            - match:
                site: '<%= site %>'
              receiver: 'dcops-<%= site %>-task'
<% end -%>
    - match:
        team: 'noc'
      receiver: 'noc-ircmail'
      routes:
        - match:
            severity: 'page'
          receiver: 'sre-page'
    - match:
        team: 'netops'
      receiver: 'netops-mail'
      routes:
        - match:
            severity: 'page'
          receiver: 'sre-page'
    - match:
        team: 'peering'
      receiver: 'peering-mail'
    - match:
        team: 'perf'
      receiver: 'perf-mail'
      repeat_interval: '48h'
    - match:
        team: 'qte'
      receiver: 'qte-mail'
    - match:
        team: 'traffic'
      receiver: 'traffic-ircmail'
      routes:
        - match:
            severity: 'page'
          receiver: 'sre-page'
    - match_re:
        # team=observability is used for role_owner
        team: '(observability|o11y)'
      routes:
        - match:
            severity: 'critical'
          receiver: 'o11y-irc'
        - match:
            severity: 'task'
          receiver: 'sre-o11y-task'
    - match:
        team: 'releng'
      receiver: 'releng-ircmail'
      routes:
        - match:
            severity: 'page'
          receiver: 'sre-page'
          continue: true
        - receiver: 'releng-ircmail'
    - match:
        team: 'rweb'
      routes:
        - receiver: 'rweb-slack-alerts'
          continue: true
        - receiver: 'rweb-mail'
    - match:
        team: 'wikidata'
      receiver: 'wikidata-mail'
    - match:
        team: 'structured-data'
      receiver: 'structured-data-mail'
    - match:
        team: 'search-platform'
      routes:
        - match:
            severity: task
          receiver: 'search-platform-task'
        - match:
            severity: page
          receiver: 'sre-page'
          continue: true
        - receiver: 'search-platform-ircmail'
    - match:
        team: 'wmcs'
      routes:
        - match:
            severity: 'page'
          receiver: 'wmcs-pageircmail'
        - match:
            severity: 'critical'
          receiver: 'wmcs-ircmail'
        - match:
            severity: 'warning'
          receiver: 'wmcs-ircmail'
    - match:
        team: 'fr-tech'
      routes:
        - match:
            severity: 'critical'
          receiver: 'fr-tech-pageircmail'
        - match:
            severity: 'warning'
          receiver: 'fr-tech-ircmail'
    - match:
        team: 'fr-tech-ops'
      routes:
        - match:
            severity: 'critical'
          receiver: 'fr-tech-ops-pageircmail'
        - match:
            severity: 'warning'
          receiver: 'fr-tech-ops-ircmail'
    - match:
        team: 'abstract-wikipedia'
      routes:
        - match:
            severity: 'critical'
          receiver: 'abstract-wikipedia-critical'
        - match:
            severity: 'warning'
          receiver: 'abstract-wikipedia-warning'
        - match:
            severity: 'task'
          receiver: 'abstract-wikipedia-task'
    - match:
        team: 'editing'
      routes:
        - match:
            severity: 'task'
          receiver: 'editing-task'
    - match:
        team: 'reader-growth'
      routes:
        - match:
            severity: 'task'
          receiver: 'reader-growth-task'
    - match:
        team: 'growth'
      routes:
        - match:
            severity: 'critical'
          receiver: 'growth-critical'
        - match:
            severity: 'task'
          receiver: 'growth-critical'
    - match:
        team: 'trust-and-safety-product'
      routes:
        - match:
            severity: 'critical'
          receiver: 'trust-and-safety-product-critical'
        - match:
            severity: 'task'
          receiver: 'trust-and-safety-product-critical'
          repeat_interval: 24h
    - match:
        team: 'mediawiki-platform'
      routes:
        - match:
            severity: 'task'
          receiver: 'mediawiki-platform-task'
        - receiver: 'mediawiki-platform-ircmail'
    - match:
        team: 'language_and_product_localization'
      routes:
        - match:
            severity: 'task'
          receiver: 'lpl-task'
        - match:
            severity: 'critical'
          receiver: 'lpl-team-slack-api-alerts'
    - match:
        team: 'mw-interfaces'
      routes:
        - match:
            severity: 'task'
          receiver: 'mw-interfaces-task'
    - match:
        team: 'security'
      routes:
        - match:
            severity: 'task'
          receiver: 'security-task'
        - match:
            severity: 'critical'
          receiver: 'security-team-slack-api-alerts'
    - match:
        team: 'campaigns-product'
      routes:
        - match:
            severity: 'task'
          receiver: 'campaigns-product-task'
    - match:
        team: 'community-tech'
      routes:
        - match:
            severity: 'task'
          receiver: 'community-tech-task'
    - match:
        team: 'flaggedrevs'
      routes:
        - match:
            severity: 'task'
          receiver: 'flaggedrevs-task'
    - match:
        team: 'mediawiki-categories'
      routes:
        - match:
            severity: 'task'
          receiver: 'mediawiki-categories-task'
    - match:
        team: 'mediawiki-file-management'
      routes:
        - match:
            severity: 'task'
          receiver: 'mediawiki-file-management-task'
    - match:
        team: 'mediawiki-page-derived-data'
      routes:
        - match:
            severity: 'task'
          receiver: 'mediawiki-page-derived-data-task'
    - match:
        team: 'mediawiki-special-pages'
      routes:
        - match:
            severity: 'task'
          receiver: 'mediawiki-special-pages-task'
    - match:
        team: 'moderator-tools'
      routes:
        - match:
            severity: 'task'
          receiver: 'moderator-tools-task'
    - match:
        team: 'notifications-echo'
      routes:
        - match:
            severity: 'task'
          receiver: 'notifications-echo-task'

    - match:
        team: 'ml'
      routes:
        - match:
            severity: 'task'
          receiver: 'ml-task'
        - receiver: 'ml-ircmail'
          continue: true
        - receiver: 'ml-slack-alerts'
          continue: true


    - match:
        team: 'mediawiki-engineering'
      receiver: 'mediawiki-engineering-slack-api-alerts'

    - match:
        team: 'wikidata-platform'
      routes:
        - receiver: 'wikidata-platform-slack-alerts'
          continue: true
        - receiver: 'wikidata-platform-mail'
          continue: true
        - receiver: 'wikidata-platform-irc'

    # Default routing for page/critical alerts, if no team could be routed
    - match:
        severity: 'page'
      receiver: 'sre-page'
    - match:
        severity: 'critical'
      receiver: 'sre-irc'



    # Force 'default' receiver as last and catch-all child route
    - receiver: 'default'

receivers:
# alertmanager-webhook-logger endpoint
- name: 'logger'
  webhook_configs:
    - url: 'http://localhost:6725'

- name: 'default'

- name: 'sink'

- name: 'irc-spam'
  webhook_configs:
    - url: 'http://<%= @active_host %>:19190/<%= @irc_channel %>'

# Team receivers. Naming convention is '<team>-<method>' where method can be irc/mail/etc, or a
# combination thereof if desired.
- name: 'sre-irc'
  webhook_configs:
    - url: 'http://<%= @active_host %>:19190/wikimedia-operations'

- name: 'sre-page'
  victorops_configs:
    - routing_key: 'sre-batphone'
  webhook_configs:
    - url: 'http://<%= @active_host %>:19190/wikimedia-operations'

- name: 'data-engineering-irc'
  webhook_configs:
    - url: 'http://<%= @active_host %>:19190/wikimedia-analytics'

- name: 'data-engineering-ircmail'
  webhook_configs:
    - url: 'http://<%= @active_host %>:19190/wikimedia-analytics'
  email_configs:
    - to: 'data-engineering-alerts@wikimedia.org'
      send_resolved: true
      headers: {'Auto-Submitted':'auto-generated'}

- name: 'data-engineering-mail'
  email_configs:
    - to: 'data-engineering-alerts@wikimedia.org'
      send_resolved: true
      headers: {'Auto-Submitted':'auto-generated'}

- name: 'data-engineering-slack-api-alerts'
  slack_configs:
    - channel: '#data-engineering-emergency'
      api_url: 'https://slack.com/api/chat.postMessage'
      http_config:
        authorization:
          type: Bearer
          credentials: '<%= @slack_bot_token %>'
      title: '{{ template "slack.title" . }}'
      text: '{{ template "slack.text" . }}'

- name: 'data-persistence-irc'
  webhook_configs:
    - url: 'http://<%= @active_host %>:19190/wikimedia-data-persistence'

- name: 'data-persistence-irc-feed'
  webhook_configs:
    - url: 'http://<%= @active_host %>:19190/wikimedia-data-persistence-feed'

- name: 'data-persistence-ircmail'
  webhook_configs:
    - url: 'http://<%= @active_host %>:19190/wikimedia-data-persistence'
  email_configs:
    - to: 'sre-data-persistence@<%= @facts["networking"]["domain"] %>'
      headers: {'Auto-Submitted':'auto-generated'}

- name: 'data-persistence-task'
