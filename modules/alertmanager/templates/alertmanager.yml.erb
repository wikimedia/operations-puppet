    - url: 'http://localhost:8292/alerts?phid=PHID-PROJ-tdy5qtdpdy6qsxrs7vr6&title=%7B%7BcommonAnnotations.summary%7D%7D'
      send_resolved: false

- name: 'data-platform-page'
  victorops_configs:
