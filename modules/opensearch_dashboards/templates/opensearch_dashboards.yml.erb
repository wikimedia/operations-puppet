<%#- SPDX-License-Identifier: Apache-2.0 -%>
# opensearchDashboards.defaultAppId deprecated as of 1.0.0
opensearchDashboards.defaultAppId: <%= @default_app_id %>
# allow importing <64mb backups
savedObjects.maxImportPayloadBytes: 67108864
logging.quiet: <%= @logging_quiet %>
metrics.enabled: <%= @metrics_enabled %>
<%- unless @region_map_enabled.nil? or @region_map_enabled == :undef -%>
region_map.enabled: <%= @region_map_enabled %>
<%- end -%>
server.maxPayloadBytes: <%= @server_max_payload_bytes %>
<%- unless @tile_map_enabled.nil? or @tile_map_enabled == :undef -%>
tile_map.enabled: <%= @tile_map_enabled %>
<%- end -%>
<%- unless @timelion_enabled.nil? or @timelion_enabled == :undef -%>
vis_type_timeline.enabled: <%= @timelion_enabled %>
<%- end -%>
<%- unless @index.nil? or @index == :undef -%>
opensearchDashboards.index: <%= @index %>
<%- end -%>
<%- unless @vega_enabled.nil? or @vega_enabled == :undef -%>
vis_type_vega.enabled: <%= @vega_enabled %>
<%- end -%>

<%- unless @disable_security_plugin %>
# Dashboards must listen on the IP that maps to the FQDN in the hosts file.
server.host: 0.0.0.0
opensearch.hosts:
  - "https://<%= @fqdn %>:9200"

# profile::pki::get_cert writes the certificates to the /etc/opensearch/<cluster_name>/ssl directory
# because opensearch requires the certificates to be underneath its config directory.  This is
# where the CA files live, so we have to construct the path to them because they're host-specific.
opensearch.ssl.certificateAuthorities:
  - "/etc/ssl/localcerts/<%= @pki_intermediate_name %>.ca.pem",
opensearch.username: <%= @opensearch_api_username %>
opensearch.password: <%= @opensearch_api_password.nil? ? 'undef' : @opensearch_api_password.unwrap %>
opensearch.requestHeadersAllowlist:
  - Authorization
  - securitytenant
  - X-Forwarded-For
  - X-Remote-User
  - X-Remote-User-Roles
opensearch_security.multitenancy.enabled: <%= @multitenancy_enabled %>

opensearch_security.cookie.secure: false
opensearch_security.auth.anonymous_auth_enabled: false
opensearch_security.auth.type: "proxy"
opensearch_security.proxycache.user_header: "X-Remote-User"
opensearch_security.proxycache.roles_header: "X-Remote-User-Roles"
<%- end %>
