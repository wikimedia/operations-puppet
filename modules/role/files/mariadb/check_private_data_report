#!/bin/bash
set -e

EMAILS="marostegui@wikimedia.org jcrespo@wikimedia.org root@wikimedia.org fceratto@wikimedia.org cwilliams@wikimedia.org"
PRIVATE_DATA="/usr/local/sbin/check_private_data.py"
REPORT_PATH="/var/log/private_data_report_${HOSTNAME}.log"
SOCKET="/run/mysqld/mysqld"

if [ ! -f "$PRIVATE_DATA" ]
then
    echo "$PRIVATE_DATA is not present"
    exit 1
fi

# run the script

# db1154 replicates s1 s3 s5 s8 and x3 in a multi-instance setup
# db1269 (future replacement for db1154) replicates s1 s3 s5 s8 and x3 in a multi-instance setup

if [ "$HOSTNAME" == "db1154" ] || [ "$HOSTNAME" == "db1269" ]
then
	for SECTION in s1 s3 s5 s8 x3
	do
		echo "Start time: $(date)" > "${REPORT_PATH}_${SECTION}"
		$PRIVATE_DATA -S ${SOCKET}.${SECTION}.sock >> "${REPORT_PATH}_${SECTION}" 2>&1
		DATA=$(/bin/egrep -v "^-- Non|^Start time|wmf_checksums|^-- Unfiltered" -c "${REPORT_PATH}_${SECTION}" | xargs)
		if [ "$DATA" -gt "0" ]
		then
		echo -e "Private data detected at $HOSTNAME for $SECTION check: ${REPORT_PATH}_${SECTION}\nSee https://w.wiki/CQL7 for new Wikis." | /usr/bin/mail -a "Auto-Submitted: auto-generated" -s "Private data found at $HOSTNAME" $EMAILS
		fi
	done
fi

