[Service]
ExecStart=
ExecStart=/usr/bin/pyrra filesystem --config-files=<%= @config_files %> --prometheus-folder=<%= @prometheus_folder %> --prometheus-url=<%= @prometheus_url %> --generic-rules

# Clean up rule files output by Pyrra filesystem on service start to avoid stale files on SLO offboarding and name changes
ExecStartPre=/usr/bin/find <%= @prometheus_folder %> -type f -iname '*.yaml' -delete
