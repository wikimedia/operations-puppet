# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Gunicorn for deadmanswitchamhook

[Service]
User=nobody
Group=<%= @group %>
WorkingDirectory=/usr/local/lib/o11y-metamonitoring
EnvironmentFile=/etc/default/metamonitoring_deadmanswitchamhook
ExecStart=/usr/bin/gunicorn deadmanswitchamhook:app \
    --bind <%= @listen_address %>:<%= @listen_port %> \
    --workers 4 \
    --access-logfile - \
    --error-logfile -

Restart=always

[Install]
WantedBy=multi-user.target
