# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Gunicorn for metamonitor_public_endpoint

[Service]
User=<%= @user %>
Group=<%= @user %>
WorkingDirectory=/usr/local/lib/o11y-metamonitoring
EnvironmentFile=/etc/default/metamonitoring_public_endpoint
ExecStart=/usr/bin/gunicorn metamonitoring-public-endpoint:app \
    --bind <%= @listen_address %>:<%= @listen_port %> \
    --workers 4 \
    --access-logfile <%= @logfile %> \
    --error-logfile <%= @logfile %>

Restart=always

[Install]
WantedBy=multi-user.target
