# SPDX-License-Identifier: Apache-2.0
/var/log/haproxy/haproxy.log {
    hourly
    rotate 3
    missingok
    notifempty
    compress
	maxsize 2000M
    delaycompress
    sharedscripts
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate
        if [ -f /usr/local/bin/toolviews.py ]; then
            /usr/local/bin/toolviews.py --prometheus-file=/var/lib/prometheus/node.d/toolviews.prom /var/log/haproxy/haproxy.log.1
        fi
    endscript
}
