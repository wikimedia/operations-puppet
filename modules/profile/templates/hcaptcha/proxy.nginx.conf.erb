<%#- SPDX-License-Identifier: Apache-2.0 -%>
# This file is managed by Puppet.

# Strip all cookies except hmt_id
map $http_cookie $filtered_cookies {
    default "";
    "~*(hmt_id=[^;]+)" "$1";
}

server {
    listen <%= @proxy_port %> ssl default_server;
    listen [::]:<%= @proxy_port %> ssl default_server;
    server_name <%= @proxy_domain %>;
    ssl_certificate <%= @ssl_chain %>;
    ssl_certificate_key <%= @ssl_key %>;

    # Default header size limit is too small for some requests.
    large_client_header_buffers 16 64k;

    # HSTS (2 years)
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    # Restrict methods
    if ($request_method !~ ^(GET|HEAD|POST|OPTIONS)$) {
        return 403;
    }

    location / {
      return 418;
    }

    location = / {
        deny all;
     }

    location = /robots.txt {
        add_header Content-Type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location ~* (checksiteconfig|captcha|authenticate|api\.js) {
        <%= @nginx_ipblinding_conf %>
        <%= @nginx_private_conf %>

        proxy_pass https://hcaptcha.com;
        proxy_ssl_server_name on;

        # Never pass the following headers
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Client-IP "";
        proxy_set_header X-Provenance "";
        proxy_set_header Referer "";
        # Set proxied Cookie header to only include filtered cookies
        proxy_set_header Cookie $filtered_cookies;
        proxy_cache HCAPTCHA;

        proxy_intercept_errors on;
        error_page 301 302 = @handle_redirect;
    }

    location @handle_redirect {
        <%= @nginx_ipblinding_conf %>
        <%= @nginx_private_conf %>

        set $saved_redirect_location '$upstream_http_location';
        proxy_pass $saved_redirect_location;
        proxy_ssl_server_name on;

        # Never pass the following headers
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Client-IP "";
        proxy_set_header X-Provenance "";
        proxy_set_header Referer "";
        proxy_set_header GeoIP "";
        proxy_set_header WMF-Uniq "";
        # Set proxied Cookie header to only include filtered cookies
        proxy_set_header Cookie $filtered_cookies;
        proxy_cache HCAPTCHA;
    }
}
