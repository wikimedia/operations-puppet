<%#- SPDX-License-Identifier: Apache-2.0 -%>
# This file is managed by Puppet.

# Strip all cookies except hmt_id
map $http_cookie $filtered_cookies {
    default "";
    "~*(hmt_id=[^;]+)" "$1";
}

server {
    listen <%= @proxy_port %> ssl;
    listen [::]:<%= @proxy_port %> ssl;
    server_name <%= @subdomain %>;
    ssl_certificate <%= @subdomain_ssl_chain %>;
    ssl_certificate_key <%= @subdomain_ssl_key %>;

    # HSTS (2 years)
    add_header Strict-Transport-Security "max-age=63072000" always;

    # Allow each subdomain of known Wikimedia domains to embed iframes from the hcaptcha proxy.
    add_header Content-Security-Policy "frame-ancestors 'self' <%= @csp_origins %>; report-uri https://sentry-<%= @proxy_domain %>/api/6/security/?sentry_key=30910f52569b4c17b1081ead2dae43b4&sentry_environment=prod&sentry_release=csp1;" always;

    # CORS: '*' is correct because all loads here are anonymous (no
    # credentials). proxy_hide_header in each proxy_pass location below
    # drops upstream's ACAO so this one is the only one on the wire (T426178).
    add_header Access-Control-Allow-Origin "*" always;

    # Restrict methods
    if ($request_method !~ ^(GET|HEAD|POST|OPTIONS)$) {
        return 403;
    }

    location = /robots.txt {
        add_header Content-Type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }
    location = / {
        return 418;
    }

    location = /api.js {
        return 418;
    }
    <% if @prefix == 'assets' %>
    # temporary redirect for T404251
    # TODO: check back later to see if we can remove this. The provider has been notified.
    # The exact url can be found in $wgHCaptchaApiUrl (wmf-config)
    location ~* ^/captcha/1/([a-f0-9]+)/secure-api\.js$  {
        <%= @nginx_ipblinding_conf %>
        <%= @nginx_private_conf %>

        proxy_pass https://newassets.hcaptcha.com/captcha/v1/$1/hcaptcha-secure-api.js;
        proxy_ssl_server_name on;

        # Remap Set-Cookie headers emitted by the backend to have the correct domain
        proxy_cookie_domain .hcaptcha.com <%= @subdomain %>;

        # Only preserve upstream Set-Cookie headers for hmt_id.
        header_filter_by_lua_file /etc/nginx/lua/filter_set_cookie.lua;

        # Never pass the following headers
        # TODO: DRY this
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Client-IP "";
        proxy_set_header X-Provenance "";
        proxy_set_header Referer "";
        proxy_set_header GeoIP "";
        proxy_set_header WMF-Uniq "";
        # Set proxied Cookie header to only include filtered cookies
        proxy_set_header Cookie $filtered_cookies;
        proxy_cache HCAPTCHA;
        # The URL includes a content hash, making it immutable at a given path.
        # Cache aggressively to absorb transient upstream failures (T418865).
        proxy_cache_valid 200 24h;
        # Upstream sends Cache-Control: max-age=300 (too short for immutable
        # content) and Set-Cookie (Cloudflare __cf_bm), which would prevent
        # nginx from caching at all. Override both.
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        # This URL is checked on every page load by the hCaptcha health
        # checker. Lock ensures only one request goes upstream per cache key
        # on cold cache or refresh; all others wait for it. Timeout is higher than
        # the global proxy_read_timeout (7s) so the lock is held for at least as
        # long as a legitimate upstream response could take.
        proxy_cache_lock on;
        proxy_cache_lock_timeout 10s;

        # Ignore upstream CSP and ACAO in favor of our configuration
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Access-Control-Allow-Origin;
    }
    <% end %>
    location / {
        <%= @nginx_ipblinding_conf %>
        <%= @nginx_private_conf %>

        proxy_pass https://<%= @target %>.hcaptcha.com;
        proxy_ssl_server_name on;

        # Remap Set-Cookie headers emitted by the backend to have the correct domain
        proxy_cookie_domain .hcaptcha.com <%= @subdomain %>;

        # Only preserve upstream Set-Cookie headers for hmt_id.
        header_filter_by_lua_file /etc/nginx/lua/filter_set_cookie.lua;

        # Never pass the following headers
        # TODO: DRY this
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Client-IP "";
        proxy_set_header X-Provenance "";
        proxy_set_header Referer "";
        proxy_set_header GeoIP "";
        proxy_set_header WMF-Uniq "";
        # Set proxied Cookie header to only include filtered cookies
        proxy_set_header Cookie $filtered_cookies;
        proxy_cache HCAPTCHA;

        # Ignore upstream CSP and ACAO in favor of our configuration
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Access-Control-Allow-Origin;
    }
}
