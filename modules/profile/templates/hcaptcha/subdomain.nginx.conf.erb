<%#- SPDX-License-Identifier: Apache-2.0 -%>
# This file is managed by Puppet.

# Strip all cookies except hmt_id
map $http_cookie $filtered_cookies {
    default "";
    "~*(hmt_id=[^;]+)" "$1";
}

server {
    listen <%= @proxy_port %> ssl;
    listen [::]:<%= @proxy_port %> ssl;
    server_name <%= @subdomain %>;
    ssl_certificate <%= @subdomain_ssl_chain %>;
    ssl_certificate_key <%= @subdomain_ssl_key %>;

    # HSTS (2 years)
    add_header Strict-Transport-Security "max-age=63072000" always;

    # Allow each subdomain of known Wikimedia domains to embed iframes from the hcaptcha proxy.
    add_header Content-Security-Policy "frame-ancestors 'self' <%= @csp_origins %>; report-uri https://sentry-<%= @proxy_domain %>/api/6/security/?sentry_key=30910f52569b4c17b1081ead2dae43b4&sentry_environment=prod&sentry_release=csp1;" always;

    # Restrict methods
    if ($request_method !~ ^(GET|HEAD|POST|OPTIONS)$) {
        return 403;
    }

    location = /robots.txt {
        add_header Content-Type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }
    location / {
        <%= @nginx_ipblinding_conf %>
        <%= @nginx_private_conf %>

        proxy_pass https://<%= @target %>.hcaptcha.com;
        proxy_ssl_server_name on;

        # Remap Set-Cookie headers emitted by the backend to have the correct domain
        proxy_cookie_domain .hcaptcha.com <%= @subdomain %>;

        # Only preserve upstream Set-Cookie headers for hmt_id.
        header_filter_by_lua_file /etc/nginx/lua/filter_set_cookie.lua;

        # Never pass the following headers
        # TODO: DRY this
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Client-IP "";
        proxy_set_header X-Provenance "";
        proxy_set_header Referer "";
        proxy_set_header GeoIP "";
        proxy_set_header WMF-Uniq "";
        # Set proxied Cookie header to only include filtered cookies
        proxy_set_header Cookie $filtered_cookies;
        proxy_cache HCAPTCHA;

        # Ignore upstream CSP in favor of our configuration
        proxy_hide_header Content-Security-Policy;
    }
}
