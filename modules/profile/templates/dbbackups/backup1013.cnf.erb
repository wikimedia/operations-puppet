<%#- SPDX-License-Identifier: Apache-2.0 -%>
type: 'dump'
user: '<%= @user %>'
password: '<%= @password %>'
rotate: True
compress: False
archive: False
retention: 18
stats_file: '/etc/wmfbackups/statistics.ini'
sections:
  # Skip read-only replica sets after the initial backup:
  # es1:
  #   host: 'es1055.eqiad.wmnet'
  # es2:
  #   host: 'es1033.eqiad.wmnet'
  # es3:
  #   host: 'es1057.eqiad.wmnet'
  # es4:
  #   host: 'es1043.eqiad.wmnet'
  # es5:
  #   host: 'es1046.eqiad.wmnet'
  es6:
    host: 'es1036.eqiad.wmnet'
    regex: '.*\.blobs_cluster32'
    threads: 2
  es7:
    host: 'es1040.eqiad.wmnet'
    regex: '.*\.blobs_cluster33'
    threads: 2
