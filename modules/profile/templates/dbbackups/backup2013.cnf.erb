<%#- SPDX-License-Identifier: Apache-2.0 -%>
type: 'dump'
user: '<%= @user %>'
password: '<%= @password %>'
rotate: True
compress: False
archive: False
retention: 18
stats_file: '/etc/wmfbackups/statistics.ini'
sections:
  # Skip read-only replica sets after the initial backup:
  # es1:
  #   host: 'es2032.codfw.wmnet'
  # es2:
  #   host: 'es2015.codfw.wmnet'
  # es3:
  #   host: 'es2029.codfw.wmnet'
  # es4:
  #  host: 'es2043.codfw.wmnet'
  # es5:
  #  host: 'es2046.codfw.wmnet'
  es6:
     host: 'es2036.codfw.wmnet'
     regex: '.*\.blobs_cluster32'
     threads: 2
  es7:
     host: 'es2040.codfw.wmnet'
     regex: '.*\.blobs_cluster33'
     threads: 2
