apiVersion: v1
clusters:
- cluster:
    certificate-authority-data: <%= @launcher_certificate_authority_data %>
    proxy-url: <%= @http_proxy %>
    server: <%= @launcher_server_url %>
    tls-server-name: <%= @launcher_tls_server_name %>
  name: zuul
contexts:
- context:
    cluster: zuul
    user: launcher
  name: zuul
current-context: zuul
kind: Config
users:
- name: launcher
  user:
    token: <%= @launcher_user_token %>
