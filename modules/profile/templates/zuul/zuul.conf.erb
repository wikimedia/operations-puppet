# vim: set ft=dosini:
[zookeeper]
hosts=<%= @zookeeper_server_ip %>:2281
tls_cert=<%= @zuul_tls_cert %>
tls_key=<%= @zuul_tls_key %>
tls_ca=<%= @zookeeper_tls_fullchain %>

[keystore]
password=<%= @tls_password %>

[scheduler]
tenant_config=/etc/zuul/main.yaml

[connection "gerrit.wikimedia.org"]
driver=gerrit
server=gerrit.wikimedia.org
sshkey=/var/ssh/zuul
user=<%= @gerrit_user %>
baseurl=https://gerrit.wikimedia.org/r
# For http
password=<%= @gerrit_pass %>
auth_type=basic

[database]
dburi=mariadb+pymysql://zuul:<%= @mysql_pass %>@<%= @mysql_host %>/zuul

[web]
listen_address=0.0.0.0
port=9000
root=http://localhost:9000

[executor]
private_key_file=/etc/zuul/ssh/id_rsa
# Our CI images have USER nobody
default_username=nobody
#trusted_rw_paths=/srv/static/logs
disk_limit_per_job=4096

[auth zuul_operator]
driver=HS256
allow_authz_override=true
realm=zuul.wikimedia.org
client_id=zuul.wikimedia.org
issuer_id=zuul_operator
secret=<%= @auth_operator_secret %>

[webclient]
url=http://localhost:9000
verify_ssl=false

