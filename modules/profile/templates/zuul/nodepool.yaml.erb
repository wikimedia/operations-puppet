# SPDX-License-Identifier: Apache-2.0
providers:
  - name: wmcs
    driver: kubernetes
    context: zuul # <-- this is the contexts[0].name value from the KUBECONFIG
    pools:
      - name: kubernetes-namespace
        type: namespace
zookeeper-servers:
  - host: <%= @zookeeper_server_ip %>
    port: 2281
    chroot: /nodepool
zookeeper-tls:
   cert: <%= @zookeeper_tls_cert %>
   key: <%= @zookeeper_tls_key %>
   ca: <%= @zookeeper_tls_ca %>
