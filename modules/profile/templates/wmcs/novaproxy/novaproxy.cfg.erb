# SPDX-License-Identifier: Apache-2.0

backend limit-per-ip
    stick-table type ipv6 size 256k expire 300s store http_req_rate(<%= @rate_limit_burst_time %>s)

backend dynamicproxy
    mode http
    option httpchk GET /.well-known/healthz
    server <%= @facts['networking']['fqdn'] %> [::1]:4443 check send-proxy-v2
backend dynamicproxy-backend-http
    mode http
    server dynamic 0.0.0.0:0
backend dynamicproxy-backend-https
    mode http
    server dynamic 0.0.0.0:0 ssl sni var(txn.host) verify none

frontend novaproxy
    bind 0.0.0.0:443 ssl crt-list /etc/haproxy/cert-map.txt alpn h2,http/1.1
    bind :::443 ssl crt-list /etc/haproxy/cert-map.txt alpn h2,http/1.1
    option httpslog

    http-request track-sc0 src table limit-per-ip
    http-request deny status 429 content-type "text/html; charset=utf-8" file "/var/www/error/ratelimit.html" if { sc_http_req_rate(0,limit-per-ip) gt <%= @rate_limit_requests * @rate_limit_burst_time %> }

    acl banned src -n -f /etc/haproxy/banned-ips.txt
<%- if @block_ua_re -%>
    acl banned req.hdr(user-agent) -m reg -i "<%= @block_ua_re %>"
<%- end -%>
<%- if @block_ref_re -%>
    acl banned req.hdr(referer) -m reg -i "<%= @block_ref_re %>"
<%- end -%>
    http-request deny status 403 content-type "text/html; charset=utf-8" file "/var/www/error/banned.html" if banned

    # Host normalization
    http-request set-header Host %[req.hdr(Host),host_only,rtrim(.)]
    http-request set-var(txn.host) req.hdr(Host)

    acl is_landing var(txn.host) -i -m str wmcloud.org www.wmcloud.org wmflabs.org www.wmflabs.org
    http-request redirect code 301 location https://wikitech.wikimedia.org/wiki/Help:Cloud_Services_introduction if is_landing

    # T102367: 366 days
    http-after-response set-header Strict-Transport-Security "max-age=31622400"
    # See http://www.gnuterrypratchett.com/
    http-after-response set-header X-Clacks-Overhead "GNU Terry Pratchett"
    # T353589: Opt-out of Google's "topics" interest-based advertising system
    http-after-response set-header Permissions-Policy "browsing-topics=()"
    # T400994: Collect network error reports
    http-after-response set-header Report-To '{"group": "wm_nel", "max_age": 604800, "endpoints": [{"url": "https://intake-logging.wikimedia.org/v1/events?stream=w3c.reportingapi.network_error&schema_uri=/w3c/reportingapi/network_error/1.0.0"}]}'
    http-after-response set-header NEL '{"report_to": "wm_nel", "max_age": 604800, "failure_fraction": 0.05, "success_fraction": 0.0}'

    # Protect against http://httpoxy.org/ issues in tools
    http-request del-header Proxy

    http-request set-header X-Forwarded-Proto https
    acl xff var(txn.host) -i -m str -f /etc/haproxy/xff-fqdns.txt
    http-request set-var(txn.xff) src if xff
    http-request set-var-fmt(txn.xff) "%[req.hdr(X-Forwarded-For)], %[src]" if xff { req.hdr(X-Forwarded-For) -m found }
    http-request set-header X-Forwarded-For %[var(txn.xff)] if xff
    http-request del-header X-Forwarded-For if !xff

    # GZIP ALL THE THINGS!
    compression algo gzip
    compression type text/plain text/css text/xml application/json application/javascript application/x-javascript text/javascript

    timeout client <%= @web_client_timeout %>s
    timeout client-fin 15s

    maxconn <%= @frontend_conn_limit %>

    # TODO: stop serving the error page logo images from Nginx
    acl is_error_page path -i -m beg /.error/
    use_backend dynamicproxy if is_error_page

    http-request set-var(txn.backend_url) var(txn.host),map(/etc/haproxy/novaproxy.map)
    http-request set-var(txn.backend_url) var(txn.host),regsub(^[^.]+,*),map(/etc/haproxy/novaproxy.map) if !{ var(txn.backend_url) -m found }

    http-request deny status 404 content-type "text/html; charset=utf-8" file "/var/www/error/noproxy.html" if !{ var(txn.backend_url) -m found } !is_error_page

    acl is_wmflabs var(txn.host) -m end .wmflabs.org
    http-request set-var(txn.wmcloud_host) var(txn.host),regsub(\.wmflabs\.org$,.wmcloud.org) if is_wmflabs
    http-request redirect code 301 location https://%[var(txn.wmcloud_host)]%[capture.req.uri] if is_wmflabs { var(txn.wmcloud_host),map(/etc/haproxy/novaproxy.map) -m found }

    http-request set-var(txn.backend_proto) var(txn.backend_url),field(1,:)
    http-request set-var-fmt(txn.backend_host) '%[var(txn.backend_url),regsub("^https?:\/\/(([^:]+)|\[([^\]]+)\])(:(\d+))?$",\2\3)]'
    http-request set-var-fmt(txn.backend_port) '%[var(txn.backend_url),regsub("^https?:\/\/(([^:]+)|\[([^\]]+)\])(:(\d+))?$",\5)]'

    acl backend_is_ip var(txn.backend_host) -m reg ^([0-9]{1,3}\.){3}[0-9]{1,3}$
    acl backend_is_ip var(txn.backend_host) -m sub :
    http-request set-var(txn.backend_address) var(txn.backend_host) if backend_is_ip
    http-request do-resolve(txn.backend_address,system-resolvers) var(txn.txn.backend_host) if !backend_is_ip !is_error_page
    http-request deny status 503 content-type "text/html; charset=utf-8" file "/var/www/error/unreachable.html" if !{ var(txn.backend_address) -m found } !is_error_page

    http-request set-dst var(txn.backend_address) if { var(txn.backend_address) -m found }
    http-request set-dst-port var(txn.backend_port) if { var(txn.backend_port) -m found }
    use_backend dynamicproxy-backend-http if { var(txn.backend_proto) -i -m str http }
    use_backend dynamicproxy-backend-https if { var(txn.backend_proto) -i -m str https }

    http-error status 502 content-type "text/html; charset=utf-8" file "/var/www/error/unreachable.html"
    http-error status 503 content-type "text/html; charset=utf-8" file "/var/www/error/unreachable.html"
    http-error status 504 content-type "text/html; charset=utf-8" file "/var/www/error/unreachable.html"
