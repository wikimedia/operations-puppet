# SPDX-License-Identifier: Apache-2.0

backend acme-chief
    mode http
    option httpchk GET /healthz
    server <%= @acmechief_host %> <%= @acmechief_host %>:80 check

frontend http-redirect
    bind 0.0.0.0:80
    bind :::80

    # Host normalization
    http-request set-header Host %[req.hdr(Host),host_only,rtrim(.)]
    http-request set-var(txn.host) req.hdr(Host)

    option httplog
    # TODO: upgrade to HAProxy 2.8+ so we can use ${HAPROXY_HTTP_LOG_FMT} instead of most of this:
    log-format "%ci:%cp [%tr] %ft %b/%s %TR/%Tw/%Tc/%Tr/%Ta %ST %B %CC %CS %tsc %ac/%fc/%bc/%sc/%rc %sq/%bq %hr %hs %{+Q}r host:%{+Q}[var(txn.host)]"

    acl is_acme path_beg /.well-known/acme-challenge/
    http-request redirect scheme https if !is_acme
    use_backend acme-chief if is_acme

    timeout client  10s
    timeout client-fin 5s

    maxconn <%= @http_redirect_conn_limit %>
