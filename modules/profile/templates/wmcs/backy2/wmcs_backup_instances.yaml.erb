  cloudinfra-nfs: ignore
  cloudinfra: cloudbackup1003
  cloudvirt-canary: ignore
  copypatrol: cloudbackup1003
  cyberbot: cloudbackup1003
  deployment-prep: cloudbackup1003
  devtools: cloudbackup1003
  download: cloudbackup1003
  dumps: cloudbackup1003
  dwl: cloudbackup1003
  ign2commons: cloudbackup1003
  integration: cloudbackup1003
  language: cloudbackup1003
  maps: cloudbackup1003
  metricsinfra: cloudbackup1003
  monitoring: cloudbackup1003
  mwoffliner: ignore
  o11y: cloudbackup1003
  octavia: cloudbackup1003
  packaging: cloudbackup1003
  paws: cloudbackup1003
  pontoon: cloudbackup1003
  puppet-dev: cloudbackup1003
  recommendation-api: cloudbackup1003
  sre-sandbox: ignore
  testlabs: ignore
  tools: cloudbackup1004
  toolsbeta: ignore
  trove: cloudbackup1003
  wikidata-dev: cloudbackup1003
  wikidata-query: cloudbackup1003
