ceph_pool: <%= @ceph_vm_pool %>
exclude_servers:
  devtools:
    - "^gitlab-runner-.*$"
  dumps:
    # negative lookahead, maybe we should use an include_servers too
    - "^(?!dumps-0).*"
  extdist:
    - ".*"
  gitlab-runners:
    - "^runner-.*$"
  integration:
    - "^integration-agent.*$"
    - "^integration-castor.*$"
  paws:
    - "^paws-k8s-worker.*$"
    - "^.*-node.*$"
  puppet-diffs:
    - "^pcc-worker.*$"
  quarry:
    - "^.*-node.*$"
  recommendation-api:
    - "^.*-test.*$"
    - "^.*-prototype.*$"
    - "^.*-build.*$"
  tools:
    - "^.*worker.*$"
    - "^.*etcd.*$"
  video:
    - "encoding.*$"
  wikidata-query:
    - "^wcqs-beta-01$"
  wikiwho:
    # these use localdisc
    - "^wikiwho-api.*$"
  wmf-research-tools:
    - "^.*-test.*$"
    - "^.*-prototype.*$"
    - "^.*-build.*$"
  xtools:
    - "^xtools-prod.*$"
  zuul:
    - "^.*worker.*$"

