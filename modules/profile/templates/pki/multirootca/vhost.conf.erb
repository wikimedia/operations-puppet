#####################################################################
### THIS FILE IS MANAGED BY PUPPET
#####################################################################
# vim: filetype=apache
<VirtualHost *:443>
  ServerName <%= @vhost %>
  ServerAlias <%= @facts["networking"]["fqdn"] %>
  DocumentRoot <%= @document_root %>

  <Directory  <%= @document_root %>>
    Require all granted
  </Directory>

  SSLEngine on
  SSLCertificateFile <%= @certs['cert'] %>
  SSLCertificateKeyFile <%= @certs['key'] %>
  SSLCertificateChainFile <%= @certs['chain'] %>
  <%= @ssl_settings.join("\n  ") %>

  # <%= @root_ca_cn %>
  ProxyPass /ocsp/<%= @root_ca_cn.gsub(/\W/, '_') %>  http://localhost:<%= @root_ocsp_port %>/
  ProxyPassReverse /ocsp/<%= @root_ca_cn.gsub(/\W/, '_') %>  http://localhost:<%= @root_ocsp_port %>/
<%- @intermediates.each_pair do |intermediate, config| -%>
  # <%= intermediate %>
  ProxyPass /ocsp/<%= intermediate.gsub(/\W/, '_') %>  http://localhost:<%= config['ocsp_port'] %>/
  ProxyPassReverse /ocsp/<%= intermediate.gsub(/\W/, '_') %>  http://localhost:<%= config['ocsp_port'] %>/
<%- end -%>

  # See directory listing with Require all granted above.
  # We need to avoid that those requests are caught by
  # the ProxyPass for /.
  ProxyPass /bundles !
  ProxyPass /crl !

  ProxyPass /  http://127.0.0.1:8888/
  ProxyPassReverse / http://127.0.0.1:8888/

  LogLevel warn ssl:info
  ErrorLog /var/log/apache2/<%= @vhost %>_ssl_error.log
  CustomLog /var/log/apache2/<%= @vhost %>_ssl_access.log wmf
</VirtualHost>
<%- if @enable_k8s_vhost -%>
<VirtualHost *:8443>
  # Protected by iptables
  ServerName <%= @vhost %>
  ServerAlias <%= @facts["networking"]["fqdn"] %>
  DocumentRoot <%= @document_root %>

  SSLEngine on
  SSLCertificateFile <%= @certs['cert'] %>
  SSLCertificateKeyFile <%= @certs['key'] %>
  SSLCertificateChainFile <%= @certs['chain'] %>
  <%= @ssl_settings.join("\n  ") %>

  ProxyPass /  http://127.0.0.1:8888/
  ProxyPassReverse / http://127.0.0.1:8888/

  LogLevel warn ssl:info
  ErrorLog /var/log/apache2/<%= @vhost %>_k8s_error.log
  CustomLog /var/log/apache2/<%= @vhost %>_k8s_access.log wmf
</VirtualHost>
<%- end -%>
