# SPDX-License-Identifier: Apache-2.0
table inet filter {
        include "/etc/nftables/sets/PRODUCTION_NETWORKS*"
        include "/etc/nftables/sets/CLOUD_NETWORKS*"

        # used to meter IPv4 IPs
        set TRACKINGLIST {
                type ipv4_addr
                flags dynamic,timeout
                timeout <%= @tracking_timeout %>s
                gc-interval 10s
        }

        # used to meter IPv6 IPs
        set TRACKINGLIST_V6 {
                type ipv6_addr
                flags dynamic,timeout
                timeout <%= @tracking_timeout %>s
                gc-interval 10s
        }

        # used to block actual IPv4 IPs
        set DENYLIST {
                type ipv4_addr
                size 65535
                flags dynamic,timeout
                timeout <%= @throttle_duration %>s
        }

        # used to block actual IPv6 IPs
        set DENYLIST_V6 {
                type ipv6_addr
                size 65535
                flags dynamic,timeout
                timeout <%= @throttle_duration %>s
        }

        chain throttling {
                type filter hook input priority filter - 5; policy accept;

                # TCP/<%= @port %> tracking
                ip  saddr != @PRODUCTION_NETWORKS_ipv4 ip  saddr != @CLOUD_NETWORKS_ipv4 tcp dport <%= @port %> \
                        add @TRACKINGLIST { ip saddr }
                ip6 saddr != @PRODUCTION_NETWORKS_ipv6 ip6 saddr != @CLOUD_NETWORKS_ipv6 tcp dport <%= @port %> \
                        add @TRACKINGLIST_V6 { ip6 saddr }

                # per-IP NEW connection rate limiting via meters (<%= @max_connections %>/s, burst <%= @burst_value %> )
                ip  saddr != @PRODUCTION_NETWORKS_ipv4 ip  saddr != @CLOUD_NETWORKS_ipv4 tcp dport <%= @port %> ct state new \
                        meter gerrit_https_v4 { ip saddr limit rate over <%= @max_connections %>/second burst <%= @burst_value %>  packets } \
                        add @DENYLIST { ip saddr } \
                        counter <%= @nft_policy %>

                ip6 saddr != @PRODUCTION_NETWORKS_ipv6 ip6 saddr != @CLOUD_NETWORKS_ipv6 tcp dport <%= @port %> ct state new \
                        meter gerrit_https_v6 { ip6 saddr limit rate over <%= @max_connections %>/second burst <%= @burst_value %>  packets } \
                        add @DENYLIST_V6 { ip6 saddr } \
                        counter <%= @nft_policy %>

                ip  saddr @DENYLIST     <%= @nft_do_log %><%= @nft_policy %>
                ip6 saddr @DENYLIST_V6  <%= @nft_do_log %><%= @nft_policy %>
        }
}
