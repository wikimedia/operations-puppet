#!/bin/bash
<%#- SPDX-License-Identifier: Apache-2.0 -%>
# NOTE: This file is managed by puppet
#
# Referce ticket: T432208
export PYTHONPATH=\${PYTHONPATH}:<%= @refinery_path %>/python

/usr/bin/python3 <%= @refinery_path %>/bin/sqoop-mediawiki-tables \
    --job-name sqoop-mediawiki-daily-$(/bin/date --date="yesterday" +'%Y-%m-%d') \
    --clouddb \
    --output-dir <%= @output_directory_labs %>/daily \
    --wiki-file <%= @wiki_file %> \
    --tables logging \
    --user <%= @labs_db_user %> \
    --password-file <%= @db_password_labs %> \
    --from-timestamp $(/bin/date --date="yesterday" +'%Y%m%d000000') \
    --to-timestamp   $(/bin/date              +'%Y%m%d000000') \
    --partition-name day \
    --partition-value $(/bin/date --date="yesterday" +'%Y-%m-%d') \
    --mappers <%= @num_mappers_one_month %> \
    --processors <%= @num_processors %> \
    --yarn-queue <%= @yarn_queue %> \
    --output-format avrodata \
    --log-file <%= @labs_log_file_daily %>

