#!/bin/bash
<%#- SPDX-License-Identifier: Apache-2.0 -%>
# NOTE: This file is managed by puppet
#
# Reference ticket: T437961
# Weekly full snapshot of the actor table. actor has no timestamp column, so it
# cannot be easily loaded incrementally.

export PYTHONPATH=\${PYTHONPATH}:<%= @refinery_path %>/python

# T425385: block until the ingestion_wikis_monthly Airflow job has published the
# wiki list in grouped_wikis.csv file
/usr/local/bin/sense_ingestion_wikis_file \
&& /usr/bin/python3 <%= @refinery_path %>/bin/sqoop-mediawiki-tables \
    --job-name sqoop-mediawiki-private-weekly-$(/bin/date +'%Y-%m-%d') \
    --output-dir <%= @output_directory_private %>/weekly \
    --wiki-file <%= @wiki_file %> \
    --tables actor \
    --user <%= @private_db_user %> \
    --password-file <%= @db_password_private %> \
    --partition-name snapshot \
    --partition-value $(/bin/date +'%Y-%m-%d') \
    --mappers <%= @num_mappers_weekly %> \
    --processors <%= @num_processors_weekly %> \
    --yarn-queue <%= @yarn_queue %> \
    --output-format avrodata \
    --log-file <%= @private_log_file_weekly %>
