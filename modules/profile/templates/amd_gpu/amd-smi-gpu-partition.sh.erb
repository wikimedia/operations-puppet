#!/bin/bash

set -e

<%#- AMD_SMI is the rocm_smi_path selected in profile::amd_gpu; PARTITION_MODE comes from profile::amd_gpu::gpu_partition_mode in hieradata/hosts/...yaml. -%>
AMD_SMI="<%= @rocm_smi_path %>"
PARTITION_MODE="<%= @gpu_partition_mode %>"
DEVPATH='/sys/module/amdgpu/drivers/pci:amdgpu'

log() {
    echo "$(date -Iseconds) - amd-smi-gpu-partition: $1"
}

restart_if_active() {
    local service="$1"

    if systemctl is-active --quiet "${service}"; then
        log "Restarting ${service}"
        systemctl restart "${service}" || {
            log "ERROR: Failed to restart ${service}"
            exit 1
        }
    else
        log "${service} is not active, skipping restart"
    fi
}

log "Starting GPU partitioning restore"

if [ ! -x "${AMD_SMI}" ]; then
    log "ERROR: amd-smi not found at ${AMD_SMI}"
    exit 1
fi

while [ ! -d "${DEVPATH}" ]; do
    log "${DEVPATH} does not exist yet, waiting..."
    sleep 1
done

log "Listing available GPUs..."
"${AMD_SMI}" list || {
    log "ERROR: Failed to list GPUs"
    exit 1
}

log "Current partition configuration:"
"${AMD_SMI}" partition --current || {
    log "WARNING: Failed to list current partition configuration"
}

log "Setting memory partition mode: ${PARTITION_MODE}"
yes y | "${AMD_SMI}" set --memory-partition "${PARTITION_MODE}" -g all || {
    log "ERROR: Failed to set memory partition mode"
    exit 1
}

log "Reloading AMD GPU driver to apply memory partition mode"
yes y | "${AMD_SMI}" reset -r || {
    log "ERROR: Failed to reload AMD GPU driver"
    exit 1
}

log "GPU partitioning configured successfully"
log "Partition mode: ${PARTITION_MODE}"

restart_if_active amd-k8s-device-plugin.service
restart_if_active amd-k8s-node-labeller.service
