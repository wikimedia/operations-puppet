-- Grants for 'root'@'localhost'

GRANT ALL PRIVILEGES
    ON *.* TO 'root'@'localhost'
    IDENTIFIED VIA unix_socket
    WITH GRANT OPTION;

GRANT PROXY
    ON ''@'%' TO 'root'@'localhost'
    WITH GRANT OPTION;

