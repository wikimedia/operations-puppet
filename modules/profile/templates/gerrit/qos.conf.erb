<IfModule qos_module>
    QS_LogOnly                      on
    QS_LogEnv                       on
    QS_SrvMaxConnPerIP              <%= @max_connections %>
    QS_SrvMaxConn                   1024
    QS_SrvMaxConnClose              60
</IfModule>

LogFormat "%h %l %u %t \"%r\" %>s %b cr=%{mod_qos_cr}e ev=%{mod_qos_ev}e con=%{mod_qos_con}e" qos