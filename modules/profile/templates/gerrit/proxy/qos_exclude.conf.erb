# puppet:///profile/gerrit/proxy/qos_exclude.conf.erb
# QoS module allowlists
# IPv4: exact IP or a prefix that ends with "."
# IPv6: exact IP or a prefix that ends with ":"

<%-
require 'ipaddr'
qos_exclude_list = Array(@qos_exclude_cidrs).compact

# Split a 32-bit IPv4 integer into 4 octets [a,b,c,d]
def v4_octets(i)
  [ (i >> 24) & 0xff, (i >> 16) & 0xff, (i >> 8) & 0xff, i & 0xff ]
end

# - /8, /16, /24  => emit a prefix that ends with "."
# - <24 but not multiple of 8 (e.g. /22) => expand into contiguous /24 blocks (prefixes)
# - >24 (e.g. /29) => emit exact IPs (prefix would be too wide)
def v4_prefixes_for(cidr)
  ip    = IPAddr.new(cidr)
  plen  = cidr.split('/')[1].to_i
  range = ip.to_range
  out   = []

  if (plen % 8).zero?
    net = ip.to_i
    a, b, c, _d = v4_octets(net)
    case plen
    when 8
      out << "#{a}."
    when 16
      out << "#{a}.#{b}."
    when 24
      out << "#{a}.#{b}.#{c}."
    else
      # /0 or /32 shouldn't occur here; fall back to exact IPs for safety
      range.each { |addr| out << addr.to_s }
    end
  elsif plen < 24
    # Expand into /24 blocks
    cur = range.begin.to_i
    fin = range.end.to_i
    seen = {}
    while cur <= fin
      a, b, c, _d = v4_octets(cur)
      key = "#{a}.#{b}.#{c}."
      unless seen[key]
        out << key
        seen[key] = true
      end
      # jump to next /24 (advance by 256 addresses)
      cur = (((cur >> 8) + 1) << 8)
    end
  else
    # /25 .. /32 → exact IPs
    range.each { |addr| out << addr.to_s }
  end

  out
end

# Format a 128-bit IPv6 integer into eight 4-hex hextets
def v6_hextets(i)
  ("%032x" % i).scan(/.{4}/) # raw 4-hex chunks
end

def v6_join_min(hx_arr, upto = 8)
  # render first 'upto' hextets as minimal hex (no leading zeros), never '::'
  hx_arr.first(upto).map { |h|
    v = h.to_i(16)
    v.to_s(16) # '0'..'ffff' with no padding
  }.join(':')
end

# For IPv6:
# - If mask is on a hextet boundary (/32, /48, /64, /80, /96, /112), we emit a single ":"-ended prefix.
# - If mask is not on a hextet boundary:
#     * For narrow networks (/113 .. /127): we enumerate (e.g. /116 → 4096 lines).
#     * Otherwise (e.g. /60): we enumerate hextet-level ":" prefixes.
def v6_prefixes_for(cidr)
  ip   = IPAddr.new(cidr)
  plen = cidr.split('/')[1].to_i
  net  = ip.mask(plen) # align network to mask
  hx   = v6_hextets(net.to_i)
  out  = []

  if plen == 128
    out << v6_join_min(hx, 8)
    return out
  end

  whole = plen / 16     # count of full hextets
  rem   = plen % 16     # bits inside the next hextet

  if rem.zero?
    # Example: /64 => "h0:h1:h2:h3:"
    out << (v6_join_min(hx, whole) + ':')
  else
    base = hx[whole].to_i(16) & (0xffff << (16 - rem))
    last = base + (1 << (16 - rem)) - 1

    if plen >= 113
      # NARROW: enumerate exact IPs
      (base..last).each do |val|
        hh = hx.dup
        hh[whole] = "%04x" % val
        # render full 8 hextets
        out << v6_join_min(hh, 8)
      end
    else
      # Wider partial-hextet nets (e.g. /60): enumerate hextet prefixes (16 lines for /60)
      (base..last).each do |val|
        hh = hx.dup
        hh[whole] = "%04x" % val
        out << (v6_join_min(hh, whole + 1) + ':')
      end
    end
  end

  out
end

def prefixes_for(cidr)
  cidr.include?(':') ? v6_prefixes_for(cidr) : v4_prefixes_for(cidr)
end
-%>

<IfModule qos_module>
  QS_SupportIPv6 on
<% qos_exclude_list.uniq.sort.each do |cidr| -%>
<%   prefixes_for(cidr).uniq.sort.each do |pfx| -%>
  QS_SrvMaxConnExcludeIP <%= pfx %>
<%   end -%>
<% end -%>
</IfModule>
