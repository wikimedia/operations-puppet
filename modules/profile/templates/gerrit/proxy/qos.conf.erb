# QoS module configuration
<IfModule qos_module>
    QS_LogOnly                      on
    <% if @facts['os']['distro']['codename'] == 'bookworm' -%>
    QS_LogEnv                       on
    <% end -%>
    QS_SrvMaxConnPerIP              <%= @max_connections %>
    QS_SrvMaxConn                   1024
    QS_SrvMaxConnClose              60
</IfModule>

LogFormat "%h %l %u %t \"%r\" %>s %b cr=%{mod_qos_cr}e ev=%{mod_qos_ev}e con=%{mod_qos_con}e" qos
