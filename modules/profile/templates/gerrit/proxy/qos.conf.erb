# QoS module configuration
<IfModule qos_module>
    QS_LogOnly                      on
    <% if @facts['os']['distro']['codename'] == 'bookworm' -%>
    QS_LogEnv                       on
    <% end -%>
    QS_SrvMaxConnPerIP              <%= @max_connections %>
    QS_SrvMaxConn                   1024
    QS_SrvMaxConnClose              60
</IfModule>

<IfModule remoteip_module>
  LogFormat "@cee: {\"@timestamp\":\"%{%Y-%m-%dT%H:%M:%S%z}t\",\
\"ecs\":{\"version\":\"1.7.0\"},\
\"http\":{\"request\":{\"method\":\"%m\",\"referrer\":\"%{Referer}i\"},\
        \"response\":{\"status_code\":%>s,\"bytes\":%B},\
        \"version\":\"%H\"},\
\"url\":{\"path\":\"%U\",\"query\":\"%q\"},\
\"user_agent\":{\"original\":\"%{User-Agent}i\"},\
\"host\":{\"hostname\":\"%v\"},\
\"client\":{\"ip\":\"%a\"},\
\"server\":{\"ip\":\"%A\",\"port\":%p},\
\"event\":{\"dataset\":\"apache.access\"},\
\"qos\":{\"cr\":\"%{mod_qos_cr}e\",\"ev\":\"%{mod_qos_ev}e\",\"con\":\"%{mod_qos_con}e\"}\
}" cee_ecs_accesslog_170_qos
</IfModule>

<IfModule !remoteip_module>
  LogFormat "@cee: {\"@timestamp\":\"%{%Y-%m-%dT%H:%M:%S%z}t\",\
\"ecs\":{\"version\":\"1.7.0\"},\
\"http\":{\"request\":{\"method\":\"%m\",\"referrer\":\"%{Referer}i\"},\
        \"response\":{\"status_code\":%>s,\"bytes\":%B},\
        \"version\":\"%H\"},\
\"url\":{\"path\":\"%U\",\"query\":\"%q\"},\
\"user_agent\":{\"original\":\"%{User-Agent}i\"},\
\"host\":{\"hostname\":\"%v\"},\
\"client\":{\"ip\":\"%h\"},\
\"server\":{\"ip\":\"%A\",\"port\":%p},\
\"event\":{\"dataset\":\"apache.access\"},\
\"qos\":{\"cr\":\"%{mod_qos_cr}e\",\"ev\":\"%{mod_qos_ev}e\",\"con\":\"%{mod_qos_con}e\"}\
}" cee_ecs_accesslog_170_qos
</IfModule>

# Utilisation (comme d’habitude) :
CustomLog /var/log/apache2/gerrit.wikimedia.org.http.access.log cee_ecs_accesslog_170_qos

