<%- |
  String        $name,
  String        $family,
  Array[Stdlib::IP::Address] $addrs,
| -%>
# SPDX-License-Identifier: Apache-2.0
#
# THIS FILE IS MANAGED BY PUPPET

<IfModule setenvif_module>
<% if empty($addrs) { -%>
  # No addrs for <%= $family %>
<% } else { -%>
<%   $addrs.each |$network| { -%>
  SetEnvIfExpr "-R '<%= $network %>'" QS_VipRequest=yes
<%   } -%>
<% } -%>
</IfModule>
