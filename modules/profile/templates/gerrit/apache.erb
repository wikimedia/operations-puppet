#####################################################################
### THIS FILE IS MANAGED BY PUPPET
### puppet:///modules/profile/templates/gerrit/apache.erb
#####################################################################
# vim: filetype=apache

<VirtualHost *:80>
    ServerAdmin noc@wikimedia.org
    ServerName <%= @tls_host %>
    <%- if !@replica_hosts.empty? -%>
    ServerAlias <%= Array(@replica_hosts).join(' ') %>
    <%- end -%>
    <%- if !@spare_hosts.empty? -%>
    ServerAlias <%= Array(@spare_hosts).join(' ') %>
    <%- end -%>

    DocumentRoot /var/www
    <Directory />
        Options FollowSymLinks
        AllowOverride None
    </Directory>
    <Directory /var/www/>
        Options Indexes FollowSymLinks MultiViews
        AllowOverride None
        Require all granted
    </Directory>

    ErrorLog /var/log/apache2/<%= @tls_host %>.http.error.log

    # Possible values include: debug, info, notice, warn, error, crit,
    # alert, emerg.
    LogLevel warn

    CustomLog /var/log/apache2/<%= @tls_host %>.http.access.log wmf
    ServerSignature Off
    <Location />
        Require all denied
    </Location>
</VirtualHost>

<VirtualHost *:443>
    ServerAdmin noc@wikimedia.org
    ServerName <%= @tls_host %>
    <%- if @replica_hosts -%>
    ServerAlias <%= Array(@replica_hosts).join(' ') %>
    <%- end -%>
    <%- if @spare_hosts -%>
    ServerAlias <%= Array(@spare_hosts).join(' ') %>
    <%- end -%>

    # https://httpoxy.org/
    RequestHeader unset Proxy early

    # With Gerrit httpd.listenUrl set to `proxy-https://`, Jetty parses the
    # X-Forwarded-For header set by mod_proxy. If an XFF is set on the client
    # side, it ends up being considered by Gerrit to be the client IP. It can
    # be trusted, so strip it. T388791
    RequestHeader unset X-Forwarded-For

    SSLEngine on
    <%- if @use_acmechief -%>
    SSLCertificateFile /etc/acmecerts/gerrit/live/ec-prime256v1.chained.crt
    SSLCertificateKeyFile /etc/acmecerts/gerrit/live/ec-prime256v1.key
    <%- else -%>
    SSLCertificateFile /etc/letsencrypt/live/gerrit.devtools.wmflabs.org/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/gerrit.devtools.wmflabs.org/privkey.pem
    <%- end -%>
    <%= @ssl_settings.join("\n    ") %>

    # T268260
    RequestHeader set "X-Forwarded-Proto" expr=%{REQUEST_SCHEME}

    RedirectMatch ^/$ /r/
    RedirectMatch ^/r$ /r/

    # Network Error Logging (NEL) headers - T303725
    Header always set Report-To '{"group": "wm_nel", "max_age": 604800, "endpoints": [{"url": "https://intake-logging.wikimedia.org/v1/events?stream=w3c.reportingapi.network_error&schema_uri=/w3c/reportingapi/network_error/1.0.0"}]}'
    Header always set NEL '{"report_to": "wm_nel", "max_age": 604800, "failure_fraction": 0.05, "success_fraction": 0.0}'

    DocumentRoot /var/www
    <Directory />
        Options FollowSymLinks
        AllowOverride None
        <RequireAll>
          Require all granted
          Require not env bad_browser
        </RequireAll>
    </Directory>
    <Directory /var/www/>
        Options Indexes FollowSymLinks MultiViews
        AllowOverride None
    </Directory>

    ProxyRequests Off
    ProxyVia Off
    ProxyPreserveHost On

    <Proxy *>
        <RequireAll>
          Require all granted
          Require not env bad_browser
        </RequireAll>
    </Proxy>

    AllowEncodedSlashes On
    RewriteEngine On

    # git-review for some reason sometimes uses <https://gerrit.wikimedia.org/tools/hooks/commit-msg>
    # instead of <https://gerrit.wikimedia.org/r/tools/hooks/commit-msg>, except when somebody is
    # trying to reproduce this behavior. But people run into this all the time.
    RewriteRule ^/tools/hooks/commit-msg$ https://<%= @tls_host %>/r/tools/hooks/commit-msg

    # Serve default favicon for Documentation and gitiles pages
    RewriteRule ^/favicon.ico$ https://<%= @tls_host %>/r/static/wikimedia-codereview-logo.cache.ico [L,R=301,NE]

    # In gerrit 2.16, cloning over /p/ is broken, so redirect /r/p/ to /r/
    RewriteRule ^/r/p/(.+)/info/(.+)$ https://<%= @tls_host %>/r/$1/info/$2 [L,R=301,NE]

    # PolyGerrit cannot serve over /r/project so uses /r/p.
    RewriteRule ^/r/projects/(.+),dashboards/(.+)$ https://<%= @tls_host %>/r/p/$1/+/dashboard/$2 [L,R=301,NE]

    # Proxies to backend servers are workers which are shared based on URLs
    # overlapping. The first matching rule wins. The definitions thus must be
    # sorted by URL length, starting with the longest worker URLs.

    # Worker for Gitiles
    ProxyPass /g/ http://127.0.0.1:8080/r/plugins/gitiles/ retry=0 nocanon Keepalive=On
    # Below requests are handled by the same backend since the URLs match and
    # thus with the same settings.
    ProxyPass /r/plugins/gitiles/ http://127.0.0.1:8080/r/plugins/gitiles/

    # Worker for Gerrit
    ProxyPass /r/ http://127.0.0.1:8080/r/ retry=0 nocanon Keepalive=On

    ErrorDocument 503 "/error.html#"

    ErrorLog /var/log/apache2/<%= @tls_host %>.https.error.log

    # Possible values include: debug, info, notice, warn, error, crit,
    # alert, emerg.
    LogLevel warn

    CustomLog /var/log/apache2/<%= @tls_host %>.https.access.log cee_ecs_accesslog_170

    ServerSignature Off

</VirtualHost>
