<%# - SPDX-License-Identifier: Apache-2.0 -%>
# Managed by Puppet

# Setting this to zero completely disables DNS function, leaving only DHCP and/or TFTP.
port=0
# Log lots of extra information about DHCP transactions.
log-dhcp

dhcp-split-relay=<%= @tap_ip4['private'] %>,<%= @tftp_servers[@site] %>,<%= @facts['networking']['ip'] %>
dhcp-split-relay=<%= @tap_ip4['public'] %>,<%= @tftp_servers[@site] %>,<%= @facts['networking']['ip'] %>
dhcp-split-relay=<%= @tap_ip4['sandbox'] %>,<%= @tftp_servers[@site] %>,<%= @facts['networking']['ip'] %>
