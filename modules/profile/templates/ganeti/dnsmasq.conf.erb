<%# - SPDX-License-Identifier: Apache-2.0 -%>
# Managed by Puppet

# Setting this to zero completely disables DNS function, leaving only DHCP and/or TFTP.
port=0
# Log lots of extra information about DHCP transactions.
log-dhcp

<% if @tap_ip4.key?("private") -%>
dhcp-split-relay=<%= @tap_ip4['private'] %>,<%= @dhcp_servers[@site] %>,<%= @facts['networking']['ip'] %>
<% end -%>
<% if @tap_ip4.key?("public") -%>
dhcp-split-relay=<%= @tap_ip4['public'] %>,<%= @dhcp_servers[@site] %>,<%= @facts['networking']['ip'] %>
<% end -%>
<% if @tap_ip4.key?("sandbox") -%>
dhcp-split-relay=<%= @tap_ip4['sandbox'] %>,<%= @dhcp_servers[@site] %>,<%= @facts['networking']['ip'] %>
<% end -%>