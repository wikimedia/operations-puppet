<%#- SPDX-License-Identifier: Apache-2.0 -%>
# This file is managed by Puppet [see profile/durum/nginx.conf.erb].

ssl_certificate     /etc/acmecerts/durum/live/ec-prime256v1.chained.crt;
ssl_certificate_key /etc/acmecerts/durum/live/ec-prime256v1.key;

# Do not log any access/error logs; we should not save any data related to Wikidough.
access_log off;
error_log  /dev/null;
<%- if @do_ech -%>
log_format withech '[$time_local] $status "$http_user_agent" "$ech_status"';
<%- end -%>

# landing page: check.wikimedia-dns.org
<%- if @do_ech -%>
server {

  listen      <%= @ips['landing'][0] %>:443 ssl http2;
  listen      [<%= @ips['landing'][1] %>]:443 ssl http2;
  server_name <%= @ech_outer_sni %>;
  ssl_certificate     /etc/acmecerts/ech/live/ec-prime256v1.chained.crt;
  ssl_certificate_key /etc/acmecerts/ech/live/ec-prime256v1.key;

  ssl_protocols TLSv1.3;
  ssl_conf_command Ciphersuites TLS_AES_128_GCM_SHA256:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_256_GCM_SHA384;
  ssl_ecdh_curve X25519:prime256v1;
  ssl_prefer_server_ciphers on;
  add_header Strict-Transport-Security "max-age=106384710; includeSubDomains; preload" always;

  location / {
    add_header Content-Type text/plain;
    return 200 'OK';
  }
}
<%- end -%>

server {

  listen      <%= @ips['landing'][0] %>:443 ssl http2;
  listen      [<%= @ips['landing'][1] %>]:443 ssl http2;
  server_name <%= @domain %>;

  <%= @ssl_settings.join("\n  ") %>

  add_header  Content-Security-Policy     "default-src 'none'; script-src 'self'; style-src 'self'; connect-src https://*.check.wikimedia-dns.org; frame-src 'none'; frame-ancestors 'none';";
  add_header  X-Content-Type-Options      "nosniff";
  add_header  Cache-Control               "no-store";

  location / {
    <%- if @do_ech -%>
    # Enable logging for the inner SNI when ECH is enabled. This is where withech logs to access.log.
    access_log /var/log/nginx/access.log withech;
    <%- end -%>
    root       <%= @durum_path %>;
    index      index.html;
  }

  <%- if @do_ech -%>
  location /health {
    add_header Content-Type text/plain;
    return 200 'OK';
  }
  <%- end -%>

}

# yesdoh: *.check.wikimedia-dns.org (DoH)
<% @ips['success_doh'].each_with_index do |doh_ip, index| -%>
<% ipv6 = index == 1 ? true : false %>
server {

<% if ipv6 -%>
  listen      [<%= doh_ip %>]:443 ssl http2;
<% else -%>
  listen      <%= doh_ip %>:443 ssl http2;
<% end -%>
  server_name *.<%= @domain %>;

  <%= @ssl_settings.join("\n  ") %>

  add_header  Access-Control-Allow-Origin https://<%= @domain %>;
  add_header  Cache-Control               "no-store";

  location /check {
    default_type application/json;
    return 200   '{"wikidough": true, "service": "doh", "site": "<%= scope.lookupvar('::site') %>", "host": "<%= @facts["networking"]["hostname"] %>", "ipv": <%= ipv6 ? '"ipv6"': '"ipv4"' %>}';
  }

}
<% end -%>

# no: *.check.wikimedia-dns.org
server {

  listen      <%= @ips['failure'][0] %>:443 ssl http2;
  listen      [<%= @ips['failure'][1] %>]:443 ssl http2;
  server_name *.<%= @domain %>;

  add_header  Access-Control-Allow-Origin https://<%= @domain %>;
  add_header  Cache-Control               "no-store";

  <%= @ssl_settings.join("\n  ") %>

  location /check {
    default_type application/json;
    return 200   '{"wikidough": false, "service": null, "site": null, "host": "<%= @facts["networking"]["hostname"] %>", "ipv": null}';
  }

}

# yesdot: *.check.wikimedia-dns.org (DoH)
<% @ips['success_dot'].each_with_index do |dot_ip, index| -%>
<% ipv6 = index == 1 ? true : false %>
server {

<% if ipv6 -%>
  listen      [<%= dot_ip %>]:443 ssl http2;
<% else -%>
  listen      <%= dot_ip %>:443 ssl http2;
<% end -%>
  server_name *.<%= @domain %>;

  <%= @ssl_settings.join("\n  ") %>

  add_header  Access-Control-Allow-Origin https://<%= @domain %>;
  add_header  Cache-Control               "no-store";

  location /check {
    default_type application/json;
    return 200   '{"wikidough": true, "service": "dot", "site": "<%= scope.lookupvar('::site') %>", "host": "<%= @facts["networking"]["hostname"] %>", "ipv": <%= ipv6 ? '"ipv6"': '"ipv4"' %>}';
  }

}
<% end -%>
