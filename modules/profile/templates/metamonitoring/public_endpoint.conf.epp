<% | String $sname, Array[String] $saliases, String $acme_chief_cert, Integer $listen_port | -%>
<%#- SPDX-License-Identifier: Apache-2.0 -%>
<VirtualHost *:443>
    ServerName <%= $sname %>
    <% $saliases.each |$salias| { -%>
    ServerAlias <%= $salias %>
    <% } -%>

    ServerAdmin noc@wikimedia.org

    ErrorLog ${APACHE_LOG_DIR}/<%= $sname %>_error.log
    CustomLog ${APACHE_LOG_DIR}/<%= $sname %>_access.log combined

    SSLEngine on
    SSLCertificateFile /etc/acmecerts/<%= $acme_chief_cert %>/live/ec-prime256v1.chained.crt
    SSLCertificateKeyFile /etc/acmecerts/<%= $acme_chief_cert %>/live/ec-prime256v1.key

    RewriteEngine on
    RewriteRule ^/?$ https://wikitech.wikimedia.org/wiki/Prometheus#Meta-Monitoring [R=301,L]

    ProxyPassMatch ^/((prometheus|thanos|icinga)/.*) http://127.0.0.1:<%= $listen_port %>/$1
    ProxyPassReverse / http://127.0.0.1:<%= $listen_port %>/

    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"

    ProxyPreserveHost On

    <Directory />
        Require all granted
    </Directory>

</VirtualHost>

<VirtualHost *:80>
    ServerName <%= $sname %>
    <% $saliases.each |$salias| { -%>
    ServerAlias <%= $salias %>
    <% } -%>

    ServerAdmin noc@wikimedia.org
    DocumentRoot /var/www

    RewriteEngine on
    RewriteCond %{SERVER_PORT} !^443$
    RewriteRule ^/(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

    ErrorLog ${APACHE_LOG_DIR}/<%= $sname %>_error.log
    LogLevel warn
</VirtualHost>
