<%#- SPDX-License-Identifier: Apache-2.0 -%>
    - name: <%= @title.gsub('_', '-') %>
      schedule: "<%= @cron_schedule %>"
      command:
      <%- @command.split.each do |argv| -%>
        - "<%= argv %>"
      <%- end -%>
      labels:
        team: <%= @team %>
        script: <%= @script_label %>
      description: <%= @description %>
