<%#- SPDX-License-Identifier: Apache-2.0 -%>
if ( !req.http.X-Provenance ) {
    // This should never happen in a context where this VCL fragment is used.
}
{{- range gets "/request-known-clients/common/*" }}
{{- $id := base .Key }}
{{- $object := json .Value }}
{{- if $object.identify_enabled }}
{{- $name := printf "known_client_limit:%s" $id }}
{{- $limit := $object.<%= @cluster_limit_field_name %> }}
{{- if or ( not $object.<%= @cluster_limit_enabled_field_name %> ) ( le $limit 0.0 ) }}{{/* Float comparison due to json deserialization. */}}
{{- $limit = <%= @default_rate_limit %> }}
{{- end}}
elseif ( req.http.X-Provenance ~ "(?i)(^|;)id={{ $id }}(;|$)" ) {
    if (vsthrottle.is_denied("{{ $name }}", {{ $limit }}, 60s, 0s)) {
        set req.http.X-Requestctl = req.http.X-Requestctl + ",{{ $name }}";
        set req.http.Retry-After = 60;
        return (synth(429, "Too many requests. Contact bot-traffic@wikimedia.org to request rate limit changes. Please include your User-Agent with your request. (8d42b7d)"));
    }
}
{{- end }}
{{- end }}
