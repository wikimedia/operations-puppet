# Pseudo-backends used only for statistics tracking.
backend httpreqrate
    stick-table type ipv6  size 1m expire 300s store http_req_rate(10s),gpc_rate(10,300s)
<%- if @feature_flags['bwlimit'] -%>
backend limit-by-source
    stick-table type ipv6  size 1m expire 60s store bytes_out_rate(1s)
backend limit-by-path
    stick-table type integer  size 1m expire 60s store bytes_out_rate(1s)
<%- end -%>
<%- if @sticktables -%>
<%- @sticktables.each do |table| -%>
backend <%= table['name'] %>
    stick-table type <%= table['type'] %> <%= table['len'] ? "len " + table['len'].to_s : "" %> size <%= table['size'] %> <%= table['expire'] ? "expire " + table['expire'] : "" %> <%= table['store'] ? "store " + table['store'].join(',') : "" %>
<%- end -%>
<%- end -%>
<%- if @use_persistent_stats -%>
    guid stats_backend_httpreqrate
<%- end -%>

## LOGGING RINGS ##
<%- if @use_benthos -%>
# Benthos log ring used to send requestctl silent drops to benthos
ring reqctl-ring
    format raw
    timeout connect 5
    timeout server 100
    server benthos <%= @benthos_socket %> log-proto legacy<%- if @use_persistent_stats -%> guid stats_ring_reqctl_ring_server_benthos<%- end %>
<%- end -%>
## END LOGGING RINGS ##

listen tls
    log global
    maxconn 199000
    bind :<%= @tls_port -%> tfo ssl crt-list <%= @crt_list_path %><%- if @tls_ticket_keys_path -%> tls-ticket-keys <%= @tls_ticket_keys_path %><%- end %>

    bind :::<%= @tls_port -%> tfo v6only ssl crt-list <%= @crt_list_path %><%- if @tls_ticket_keys_path -%> tls-ticket-keys <%= @tls_ticket_keys_path %><%- end %>
<%- if @use_persistent_stats -%>
    guid stats_listen_tls
<%- end -%>

    http-reuse <%= @http_reuse %>

    # time to wait for a complete HTTP request, It only applies to the header part of the HTTP request (unless option http-buffer-request is used)
    timeout http-request <%= @timeout['http_request'] %>s
    # set the maximum allowed time to wait for a new HTTP request to appear
    timeout http-keep-alive <%= @timeout['keep_alive'] %>s
    # set the maximum inactivity time on the client side
    timeout client <%= @timeout['client'] %>s
    # inactivity timeout on the client side for half-closed connections
    timeout client-fin <%= @timeout['client_fin'] %>s
    # connect timeout against a backend server
    timeout connect <%= @timeout['connect'] %>s
    # set the maximum inactivity time on the server side
    timeout server <%= @timeout['server'] %>s
    # timeout used after upgrading a connection (websockets) or after the first response when no keepalive/close option is specified
    timeout tunnel <%= @timeout['tunnel'] %>s

    acl too_much_recent_concurrency sc0_gpc0_rate(httpreqrate) gt 0
    http-request track-sc0 src table httpreqrate
    http-request set-log-level silent if too_much_recent_concurrency
    http-request silent-drop if too_much_recent_concurrency

    capture request header Host len 255
    capture request header Referer len 1024
    capture request header User-Agent len 1024
    capture request header Accept-Language len 1024
    capture request header Range len 10
    capture request header Accept len 64

    # store a copy of the client headers before header normalization
    http-request set-var(req.pristine_hdrs) req.hdrs

    # populate txn variables used for logging purposes
    http-response set-var(txn.content_type) res.fhdr(Content-Type)

    # default values for x-cache and x-cache-status
    http-request set-var(txn.x_cache) str("<%= @facts["networking"]["hostname"] %> int")
    http-request set-var(txn.x_cache_status) str("int-tls")
    # override them with upstream headers
    http-response set-var(txn.x_cache) res.fhdr(X-Cache) if { res.fhdr(X-Cache) -m found }
    http-response set-var(txn.x_cache_status) res.fhdr(X-Cache-Status) if { res.fhdr(X-Cache-Status) -m found }

    # default value for server
    http-request set-var(txn.server) str("HAProxy")
    # override it with upstream header
    http-response set-var(txn.server) res.fhdr(Server) if { res.fhdr(Server) -m found }


    # Host normalization
    # Use the host_only converter to remove eventual trailing port and
    # lowercase it. Also, remove eventual trailing dot.
    # Set it as separate (txn) var for easy logging (capture happens before this directive
    # is evaluated)
    http-request set-header Host %[req.fhdr(Host),host_only,rtrim(.)]
    http-request set-var(txn.host) req.hdr(Host)

    http-request set-var(txn.xwd_count) req.fhdr_cnt(X-Wikimedia-Debug)
    http-request set-var(req.ciph) ssl_fc_cipher,regsub('^ECDHE-ECDSA-',''),regsub('^TLS_',''),regsub('_','-','g'),regsub('^CHACHA20-POLY1305$','CHACHA20-POLY1305-SHA256')
    http-request set-var(req.auth) str(ECDSA)

<%- if @realm == 'production' -%>
    # Host header has been normalized above
    http-request deny deny_status 400 unless { req.fhdr(host),map_reg(/etc/haproxy/allowed-hosts.map) -m found }
<%- end -%>

    # Bandwidth limiting filters
<%- if @feature_flags['bwlimit'] -%>
    # 32 MByte/s per source IP limit for uploads
    filter bwlim-out limit-by-source key src table limit-by-source limit 32m
    # 38MByte/sec * ~8 cache hosts/PoP =~ 2.4Gbit/sec/distinctURIpath/PoP egress budget
    filter bwlim-out limit-by-path key path,sdbm(1) table limit-by-path limit 38m
<%- end -%>

    # Allowlist ACLs
    acl wikimedia_trust src <%= @wikimedia_trust.join(' ') %>

    # ACLs
    acl too_many_concurrent_queries sc0_trackers(httpreqrate) ge 300
    acl too_high_reqrate sc0_http_req_rate(httpreqrate) ge 5000
    acl almost_too_many_concurrent_queries sc0_trackers(httpreqrate) ge 100
    acl mark_as_too_much_concurrency sc0_inc_gpc0(httpreqrate) gt 0
    acl missing_xwd var(txn.xwd_count) -m int eq 0
    acl mathoid_as_a_service path -m beg /api/rest_v1/media/math/
    acl allowed_methods method <%= @allowed_methods.join(' ') %>

    http-request set-var(req.h2) fc_http_major,even
    http-request set-var-fmt(req.h2s) %[var(req.h2),iif(h2,h1)]
    http-request set-var(req.sess) ssl_fc_is_resumed,iif(reused,new)

    http-request set-header X-Client-IP "%[src]"
    http-request set-header X-Client-Port "%[src_port]"
    http-request set-header X-Forwarded-Proto "https"
    http-request set-header X-Connection-Properties "H2=%[var(req.h2)]; SSR=%[ssl_fc_is_resumed]; SSL=%[ssl_fc_protocol]; C=%[ssl_fc_cipher]; EC=UNKNOWN; KA=%[var(req.auth)];"
    http-request set-var-fmt(txn.tls) "vers=%[ssl_fc_protocol];keyx=UNKNOWN;auth=%[var(req.auth)];ciph=%[var(req.ciph)];prot=%[var(req.h2s)];sess=%[var(req.sess)]"
<%- if @use_etcd_req_filters -%>
<%= scope.lookupvar('haproxy::hiddenparma::set_headers')%>
<%- end -%>

    http-request set-var(txn.req_id,ifnotempty) req.fhdr(X-Request-Id) if wikimedia_trust
    http-request set-var(txn.req_id,ifnotset) uuid()
    http-request set-header X-Request-Id %[var(txn.req_id)]
    http-after-response set-header X-Request-Id %[var(txn.req_id)]

    http-request del-header tracestate if !wikimedia_trust
    http-request del-header traceparent if !wikimedia_trust
    http-request del-header X-Experiment-Enrollments

    # Copy X-Analytics hdr into var to safely log it after deletion
    http-response set-var(txn.x_analytics,ifnotempty) res.fhdr(X-Analytics)
    http-response del-header X-Analytics if missing_xwd

    # Parse Backend-Timing & log into x-analytics
    http-response set-var(res.bt_d) 'res.fhdr(Backend-Timing),word(2,"= ")'  # it is always produced in this order
    http-response set-var(res.bt_t) 'res.fhdr(Backend-Timing),word(4,"= ")'
    http-response set-var(txn.x_analytics,ifset) 'var(txn.x_analytics),add_item(";backend_dur_usec=",res.bt_d),add_item(";backend_ts_usec=",res.bt_t)'
    http-response del-header Backend-Timing if missing_xwd
    http-response del-header X-ATS-Timestamp if missing_xwd
    http-response del-header X-Envoy-Upstream-Service-Time if missing_xwd
    http-response del-header X-OpenStack-Request-ID if missing_xwd
    http-response del-header X-Powered-By if missing_xwd
    # Keep only the major and minor PHP version. WikimediaDebug needs the header.
    http-response replace-header X-Powered-By ^(PHP/[0-9]+\.[0-9]+)\..* \1
    http-response del-header X-Timestamp if missing_xwd
    http-response del-header X-Trans-Id if missing_xwd
    http-response del-header X-Varnish if missing_xwd
    http-response del-header traceparent if missing_xwd
    http-response del-header tracestate if missing_xwd


    # Provide Server header
    http-after-response set-header Server %[var(txn.server)] unless { res.fhdr(Server) -m found }
    # Provide X-Cache headers
    http-after-response set-header X-Cache %[var(txn.x_cache)] unless { res.fhdr(X-Cache) -m found }
    http-after-response set-header X-Cache-Status %[var(txn.x_cache_status)] unless { res.fhdr(X-Cache-Status) -m found }

    # Allow only a subset of methods
    http-after-response set-header Allow "<%= @allowed_methods.join(", ") %>" unless allowed_methods
    http-request deny deny_status 405 unless allowed_methods
    # Allow OPTIONS method only with Origin header
    http-request deny deny_status 405 if { method OPTIONS } !{ hdr(Origin) -m found }

<%- if @use_etcd_req_filters -%>
<%= scope.lookupvar('haproxy::hiddenparma::set_provenance') -%>
<%- else -%>
    # Set provenance to unknown if no other provenance was set
    http-request set-var(txn.provenance,ifnotexists) str('net=unknown')
    # Set trusted_request to E if no other trusted_request was set
    http-request set-var(req.trusted_request,ifnotexists) str(E)
    # These ACLs are used to classify requests based on the value of req.trusted_request
    acl is_trusted_request var(req.trusted_request) -m str A
    acl is_identified_bot_request var(req.trusted_request) -m str B
    acl is_auth_request var(req.trusted_request) -m str C
<%- end -%>

<%- if @use_webrequest_ipreputation -%>
    http-request set-var(req.ip_reputation,ifnotexists,ifnotempty) src,map_ip_key(/etc/haproxy/ip-reputation.d/top_ips_requestctl_webrequest_text_haproxy_config.map)
    http-request set-var(req.ip_reputation,ifnotexists,ifnotempty) src,map_ip_key(/etc/haproxy/ip-reputation.d/top_ips_requestctl_webrequest_upload_haproxy_config.map)
    http-request set-var(txn.provenance) var(txn.provenance),add_item(";",,"top_historical_webrequest=true") if { var(req.ip_reputation) -m found }
<%- end -%>
    # Check if the request originates from a known datacenter.
<%- if @use_datacenter_provenance -%>
    http-request lua.is_datacenter
    http-request set-var(txn.provenance) var(txn.provenance),add_item(";",,"datacenter=true") if { var(txn.is_datacenter) -m bool }
<%- end -%>
<%- if @use_cidergrinder -%>
    http-request lua.cidergrinder_mmdb_lookup unless { var(sess.cidergrinder_mmdb_result) -m found }
    http-request set-var(sess.prehashed) src,ipmask(32,64),xxh3 unless { var(sess.cidergrinder_mmdb_result) -m found } || { var(sess.prehashed) -m found }
    http-request lua.bloom_lookup unless { var(sess.cidergrinder_mmdb_result) -m bool }
    http-request set-var(txn.provenance) var(txn.provenance),add_item(";",,"likely_resiproxy=true") if { var(sess.cidergrinder_mmdb_result) -m bool } || { var(sess.bloom_result) -m bool }
<%- end -%>
<%-if @use_res_proxy_provenance -%>
    http-request lua.res_proxy  # sets var txn.res_proxy to `proxy=foo` (or, doesn't)
    http-request set-var(txn.provenance) var(txn.provenance),add_item(";",txn.res_proxy,"") if { var(txn.res_proxy) -m found }
<%- end -%>

<%- if @use_etcd_req_filters -%>
    # txn.x_requestctl gets populated by matching requestctl rules. Here, we prepare to log it via
    # txn.x_analytics. The ifnotexists here is purely defensive.
    http-request set-var(txn.x_requestctl,ifnotexists) str("")

    # len greater than 4 cause len(hap:) = 4 and requestctl haproxy rules get the hap: prefix
    acl x_requestctl_is_set var(txn.x_requestctl) -m len gt 4
    acl requestctl_key_present var(txn.x_analytics) -i -m sub "requestctl="

    # Retain whether cookies are present on the request, in case we need to synthesize a
    # txn.x_analytics value later.
    http-request set-var(txn.nocookies) req.cook_cnt,bool,not

    # With http-after-response, we ensure that txn.x_analytics gets updated even if a requestctl
    # rule denies the request. There are two cases to handle:
    # * If txn.x_analytics is already set, but does not contain a requestctl key (i.e., for some
    #   reason, upstream did not provide one), we append ;requestctl= to it.
    http-after-response set-var(txn.x_analytics,ifset) var(txn.x_analytics),add_item(';requestctl=',txn.x_requestctl) if x_requestctl_is_set !requestctl_key_present
    # * If txn.x_analytics is not set, it means that haproxy never got it from varnish so we need to
    #   provide some basic data. This is the expected case if the request was denied at haproxy.
    http-after-response set-var-fmt(txn.x_analytics,ifnotset) "https=1;client_port=%[src_port];nocookies=%[var(txn.nocookies)];requestctl=%[var(txn.x_requestctl)]" if x_requestctl_is_set

    # Clean-up requestctl data from X-Analytics response header, which may not be deleted in some
    # cases (e.g., X-Wikimedia-Debug).
    http-after-response set-header x-analytics %[res.fhdr(x-analytics),'regsub("(^|;)\s*requestctl=[^;]*(;|$)","\1\2","g")'] if requestctl_key_present
<%- end -%>

<%- if @use_etcd_req_filters -%>
<%= scope.lookupvar('haproxy::hiddenparma::set_fingerprints')%>
<%- end -%>
<%- if @report_ja3n -%>
    # add ja3n to x-analytics variable
    http-after-response set-var(txn.x_analytics,ifset) var(txn.x_analytics),add_item(';ja3n=',sess.fingerprint_ja3n) unless { var(txn.x_analytics) -m sub ;ja3n= }
<%- end -%>
<%- if @report_ja4h -%>
    # add ja4h to x-analytics variable
    http-after-response set-var(txn.x_analytics,ifset) var(txn.x_analytics),add_item(';ja4h=',txn.fingerprint_ja4h) unless { var(txn.x_analytics) -m sub ;ja4h= }
<%- end -%>
<%- if @use_res_proxy_provenance -%>
    http-after-response set-var(txn.x_analytics,ifset) var(txn.x_analytics),add_item(';res_',txn.res_proxy) if { var(txn.res_proxy) -m found } !{ var(txn.x_analytics) -m sub ;res_ }
<%- end -%>
<%- if @use_kapow_score -%>
    # after all needed vars has already been set
    http-request set-var-fmt(txn.kapow_key) "%[var(sess.fingerprint_ja3n)],%[var(txn.fingerprint_ja4h),field(2,_)]"
    # Remember to use map_str_int if need to do comparisons with the score value
    http-request set-var(txn.kapow_estimate) var(txn.kapow_key),map_str(opt@<%= @kapow_score_file %>,"-1")
    http-request set-header X-Kapow-Estimate %[var(txn.kapow_estimate)]
<%- end -%>
<%- if @use_etcd_moat_scope and @use_etcd_req_filters -%>
    {{- $path := "/request-haproxy-dsl/cache-<%= @cache_cluster %>/moat-<%= @site %>" -}}
    {{- if not (exists $path) }}
    {{- $path = "/request-haproxy-dsl/cache-<%= @cache_cluster %>/moat-global" -}}
    {{- end }}
    {{ if exists $path }}
    # Requestctl haproxy-action moat-scope rules
    {{ $value := json (getv $path) }}{{ range split $value.dsl "\n" }}
    {{ . }}
    {{- end }}
    {{- end }}
<%- end -%>

<%- if @use_etcd_known_client_ident and @use_etcd_req_filters -%>
<%= scope.lookupvar('haproxy::hiddenparma::known_client_fragment') %>
<%- end -%>
<%- if @feature_flags['co_id'] -%>
    # Create unique id identifier for correlation and append to Server-Timing header
    # Server-Timing response header must exists
    unique-id-format %{+X}o\ %ci:%cp_%fi:%fp_%Ts_%rt:%pid
    acl server_timing_present res.fhdr(Server-Timing) -m found

    http-after-response set-var(txn.co_id) unique-id,sdbm() if server_timing_present
    http-after-response set-header Server-Timing "%[res.fhdr(server-timing)],co_id;desc=\"%[var(txn.co_id)]\"" if server_timing_present
<%- end -%>

    # Set X-Provenance to its final authoritative value, if available.
    http-request set-header X-Provenance %[var(txn.provenance)] if { var(txn.provenance) -m found }

    # Image provenance.
    # Set image link generator, possible values are defined by MediaWiki, See:
    # https://wikitech.wikimedia.org/wiki/X-Image-Generator
    http-request set-header X-Image-Generator %[url_param(utm_campaign)] if { url_param(utm_campaign) -m reg ^(parser|imageinfo|index|api|rest)$ }

<%- if @feature_flags['jwt'] and @use_etcd_req_filters -%>
<%= scope.lookupvar('haproxy::hiddenparma::set_jwt_header') %>
<%- end -%>

<%- if @feature_flags['misc_auth'] -%>
    # Check if request for phabricator contains a phusr cookie. If so, mark this as an authorised request (C), unless it's already marked as trusted (A) or bot (B)
    # Please note: we're abusing the X-JWT-Sub header here to forward the value to varnish; this is to avoid wasting more cycles warding for more headers to clean.
    # We might want to change the name of the header in the future to a more generic one like X-Auth-Sub or similar, but for now I don't care(TM).
    acl is_phab_request req.hdr(Host) -m str "phabricator.wikimedia.org"
    acl is_phab_auth req.cook(phusr) -m found
    http-request set-var(req.trusted_request) str(C) if is_phab_request is_phab_auth !is_trusted_request !is_identified_bot_request
    http-request set-header X-JWT-Sub %[req.cook(phusr)] if is_phab_request is_phab_auth !is_trusted_request !is_identified_bot_request
    # Same, but for gerrit, where the cookie is called GerritAccount
    acl is_gerrit_request req.hdr(Host) -m str "gerrit.wikimedia.org"
    acl is_gerrit_auth req.cook(GerritAccount) -m found
    http-request set-var(req.trusted_request) str(C) if is_gerrit_request is_gerrit_auth !is_trusted_request !is_identified_bot_request
    http-request set-header X-JWT-Sub %[req.cook(GerritAccount)] if is_gerrit_request is_gerrit_auth !is_trusted_request !is_identified_bot_request
<%- end -%>

<%- if @use_etcd_req_filters %>
<%= scope.lookupvar('haproxy::hiddenparma::set_ua_contact_header')%>
<%- else -%>
    # Fall back to E if no trust score has been determined yet and set X-Trusted-Request to its
    # final authoritative value.
    http-request set-var(req.trusted_request,ifnotexists) str(E)
    http-request set-header X-Trusted-Request %[var(req.trusted_request)]
<%- end -%>

    # Global concurrency enforcement
<%- if @use_benthos -%>
    http-request set-var-fmt(req.silentdrop) '{"host":"%[req.fhdr(Host),json(utf8ps)]","src":"%[src]","path":"%[path,json(utf8ps)]","ja3n":"%[var(sess.fingerprint_ja3n)]"}' if !is_trusted_request !mathoid_as_a_service !too_much_recent_concurrency too_many_concurrent_queries   # Prepares json payload as a variable used in successive debug function
    http-request set-var-fmt(req.silentdrop) '{"host":"%[req.fhdr(Host),json(utf8ps)]","src":"%[src]","path":"%[path,json(utf8ps)]","ja3n":"%[var(sess.fingerprint_ja3n)]"}' if !is_trusted_request !mathoid_as_a_service !too_much_recent_concurrency too_high_reqrate almost_too_many_concurrent_queries   # Prepares json payload as a variable used in successive debug function
    http-request set-var(req.dummy) var(req.silentdrop),debug(silentdroplog,reqctl-ring) if !is_trusted_request !mathoid_as_a_service !too_much_recent_concurrency too_many_concurrent_queries   # Logs into reqctl-ring the req.silentdrop variable defined earlier
    http-request set-var(req.dummy) var(req.silentdrop),debug(silentdroplog,reqctl-ring) if !is_trusted_request !mathoid_as_a_service !too_much_recent_concurrency too_high_reqrate almost_too_many_concurrent_queries   # Logs into reqctl-ring the req.silentdrop variable defined earlier
<%- end -%>
    http-request set-var-fmt(req.dummy_silent_drop) "src=%[src];ja3n=%[var(sess.fingerprint_ja3n)]" if !is_trusted_request !mathoid_as_a_service !too_much_recent_concurrency too_many_concurrent_queries
    http-request set-var-fmt(req.dummy_silent_drop) "src=%[src];ja3n=%[var(sess.fingerprint_ja3n)]" if !is_trusted_request !mathoid_as_a_service !too_much_recent_concurrency too_high_reqrate almost_too_many_concurrent_queries
    http-request set-var(req.dummy_silent_drop) var(req.dummy_silent_drop),debug(silent-drop_for_300s,stderr) if !is_trusted_request !mathoid_as_a_service !too_much_recent_concurrency too_many_concurrent_queries   # exists only for logging side-effect
    http-request set-var(req.dummy_silent_drop) var(req.dummy_silent_drop),debug(silent-drop_for_300s,stderr) if !is_trusted_request !mathoid_as_a_service !too_much_recent_concurrency too_high_reqrate almost_too_many_concurrent_queries   # exists only for logging side-effect
    # TO DISABLE CONCURRENCY ENFORCEMENT, JUST COMMENT THE FOLLOWING LINES
    http-request silent-drop if !is_trusted_request !mathoid_as_a_service too_many_concurrent_queries mark_as_too_much_concurrency
    http-request silent-drop if !is_trusted_request !mathoid_as_a_service too_high_reqrate almost_too_many_concurrent_queries mark_as_too_much_concurrency

<%- if @use_private_data -%>
    # Functionality provided by private repo.
    http-request lua.request_check if { var(req.trusted_request) -m str "C" "E" }
    http-request set-header X-Is-Browser %[var(txn.request_score)] if { var(txn.request_score) -m found }
    http-request set-header X-Is-Browser 0 if !{ var(txn.request_score) -m found }
    # append x_is_browser to x_analytics iff it hasn't been added upstream
    http-after-response set-var(txn.x_analytics,ifset) var(txn.x_analytics),add_item(';x_is_browser=',txn.request_score) unless { var(txn.x_analytics) -m sub x_is_browser= }
<%- end -%>


<%- if @feature_flags['bwlimit'] %>
    # TODO: move in the filtering backend so we can remove the condition
    http-request set-bandwidth-limit limit-by-source if !is_trusted_request
    http-request set-bandwidth-limit limit-by-path if !is_trusted_request
<%- end -%>
<%- if @feature_flags['upload_qos'] %>
    # Set TOS field for commons files to DSCP CS1 to map them to lower-priority network queue
    http-response set-tos 0x20 if { var(txn.host) -m str "upload.wikimedia.org" }
<%- end -%>

<%- if @use_etcd_req_filters -%>
    # Populate the X-Requestctl request header in order pass the current state on to varnish.
    # While we might not select a requestctl-filter backend, we may have logged to x_requestctl and
    # need that reflected in the combined view in X-Analytics returned by varnish.
    http-request set-header X-Requestctl %[var(txn.x_requestctl)] if x_requestctl_is_set
<%- end -%>

<%- if @dedicated_hc_backend -%>
    acl hc-host        hdr(host) -i healthcheck.wikimedia.org
    acl hc-path        path_beg     /varnish-fe
    acl hc-unique-path path_beg     /varnish-fe-hc-5ebea9
    acl hc-allowed-src src       -f <%= @hc_sources_file_path %>
    use_backend healthcheck if hc-host hc-path hc-allowed-src || hc-unique-path hc-allowed-src
<%- end -%>

    option forwardfor
<%- if @use_etcd_req_filters -%>
    # Enforce requestctl filters for any request with a trust score lower than C
    <% @requestctl_scopes.select { |data| data[0] != 'moat' }.each do |data| %>
    use_backend requestctl_filters_<%= data[0] %> if <%= data[1] %>
    <% end %>
<%- end -%>

    # Deprecated endpoints: mathoid as a service (T431372)
    http-request set-var(txn.is_mathoid) bool(true) if mathoid_as_a_service
    http-response set-header deprecation "@1788134400" if { var(txn.is_mathoid) -m bool }
    http-response set-header sunset "Mon, 28 September 2026 00:00:00 UTC" if { var(txn.is_mathoid) -m bool }
    # Block POST requests to mathoid as a service
    http-request deny status 403 if METH_POST mathoid_as_a_service

    server backend_server <%= @actual_backend  %><%- if @use_persistent_stats -%> guid stats_listen_tls_server_backend_server<%- end %>


<%- if @use_etcd_req_filters -%>
<%- @requestctl_scopes.select { |data| data[0] != 'moat' }.each do |data| -%>
<%- local_scope = data[0] -%>
backend requestctl_filters_<%= local_scope %>
<%- if @use_persistent_stats -%>
    guid stats_backend_requestctl_filters_<%= local_scope %>
<%- end -%>
<%- if local_scope == 'default' %>
    # ACLs for UA policy enforcement:
    # 1) Block clients with no user-agent.
    # 2) Block clients with a library default or WDQS User-Agent unless a contact information is provided
    # 3) Temporarily allow library-default UAs for gerrit.wikimedia.org (T417156)
    acl is_gerrit req.fhdr(Host) -m str -i gerrit.wikimedia.org
    acl ua_policy_none req.fhdr_cnt(User-Agent) -m int eq 0
    acl ua_library_default req.fhdr(User-Agent) -m reg -i "^(python\-requests|python\/[\d.]+ aiohttp\/[\d.]+|python\-urllib|python\-httpx|okhttp\/|java|apache\-httpclient|go\-|birdnet\-go|guzzlehttp|axios)"
    acl ua_wdqs req.fhdr(User-Agent) -m reg -i "^Wikidata Query Service"
    acl ua_internals req.fhdr(User-Agent) -m reg -i "^Parsoid\/[\d.]+"
    # These are library defaults that include an url for the software itself
    acl ua_forge_url req.fhdr(User-Agent) -m reg -i "https?\:\/\/(github\.com|gitlab\.com)"

    # Allow generic user agents, assuming they provide some form of contact information.
    acl ua_has_contact_info var(req.contact_info) -m found

    # Register why a client was blocked, based on matched ACL.
    # When modifying these, make sure to also modify the corresponding `http-request deny` rules below.
    http-request set-var(txn.x_requestctl) str('ua_policy:none') if ua_policy_none # User-Agent not set.
    http-request set-var(txn.x_requestctl) str('ua_policy:library_default') if ua_library_default !is_gerrit !ua_has_contact_info or ua_library_default !is_gerrit ua_forge_url # Default User-Agent from library.
    http-request set-var(txn.x_requestctl) str('ua_policy:wdqs') if ua_wdqs !ua_has_contact_info # WDQS User-Agent.
    http-request set-var(txn.x_requestctl) str('ua_policy:internals') if ua_internals !ua_has_contact_info # "Internals" UAs

    # Return HTTP 403 when not matching either of our user-agent policies
    # When modifying these, make sure to also modify the corresponding `http-request set-var(txn.x_requestctl)` rules above.
    <%- ua_policy_body = "Please set a user-agent and respect our robot policy https://w.wiki/4wJS. See also https://phabricator.wikimedia.org/T400119.\\n" %>
    http-request deny status 403 content-type text/plain string "<%= ua_policy_body %>" if ua_policy_none
    http-request deny status 403 content-type text/plain string "<%= ua_policy_body %>" if ua_library_default !is_gerrit !ua_has_contact_info or ua_library_default !is_gerrit ua_forge_url
    http-request deny status 403 content-type text/plain string "<%= ua_policy_body %>" if ua_wdqs !ua_has_contact_info
    http-request deny status 403 content-type text/plain string "<%= ua_policy_body %>" if ua_internals !ua_has_contact_info
<%- end -%>

    {{- $path := "/request-haproxy-dsl/cache-<%= @cache_cluster %>/<% if local_scope != 'default' %><%= local_scope %>-<% end %><%= @site %>" -}}
    {{- if not (exists $path) }}
    {{- $path = "/request-haproxy-dsl/cache-<%= @cache_cluster %>/<% if local_scope != 'default' %><%= local_scope %>-<% end %>global" -}}
    {{- end }}
    {{ if exists $path }}
    # REQUESTCTL FILTERS
    {{ $value := json (getv $path) }}{{ range split $value.dsl "\n" }}
    {{ . }}
    {{- end }}
    {{- end}}

    # Populate the X-Requestctl request header in order pass the current state on to varnish. This
    # is only relevant in case requestctl rules haven't blocked the request.
    http-request set-header X-Requestctl %[var(txn.x_requestctl)]

    server backend_server <%= @actual_backend  %><%- if @use_persistent_stats -%> guid stats_backend_requestctl_filters_<%= local_scope %>_server_backend_server<%- end %>
<%- end -%>
<%- end -%>

<%- if @dedicated_hc_backend -%>
backend healthcheck
    option forwardfor
<%- if @use_persistent_stats -%>
    guid stats_backend_healthcheck
<%- end -%>
    server hc_server <%= @backend['prefix'] %>@<%= @backend['address'] %> maxconn 100<%- if @use_persistent_stats -%> guid stats_backend_healthcheck_server_hc_server<%- end %>
<%- end -%>

<%- if @prometheus_port -%>
frontend stats
    no log
    maxconn 1000
    bind :<%= @prometheus_port %>
    bind :::<%= @prometheus_port %> v6only
<%- if @use_persistent_stats -%>
    guid stats_frontend_stats
<%- end -%>
    http-request use-service prometheus-exporter if { path /metrics }
    stats enable
    stats uri /stats
    stats refresh 10s
    # Explicitly avoid keep-alive to prevent Prometheus scrapers from
    # reusing indefinitelly the same TCP connection. See T343000
    http-after-response set-header Connection Close
<%- end -%>
