    acl hc-allowed-src src       -f <%= @hc_sources_file_path %>
    use_backend healthcheck if hc-host hc-path hc-allowed-src || hc-unique-path hc-allowed-src
<%- end -%>

    option forwardfor
<%- if @use_etcd_req_filters -%>
    # Enforce requestctl filters for any request with a trust score lower than C
    <% @requestctl_scopes.select { |data| data[0] != 'moat' }.each do |data| %>
    use_backend requestctl_filters_<%= data[0] %> if <%= data[1] %>
    <% end %>
