    server backend_server <%= @backend['prefix'] %>@<%= @backend['address'] %><%- if @backend['maxconn'] -%> maxconn <%= @backend['maxconn'] %><%- end %>


<%- if @use_etcd_req_filters -%>
<%- @requestctl_scopes.select { |data| data[0] != 'moat' }.each do |data| -%>
<%- local_scope = data[0] -%>
backend requestctl_filters_<%= local_scope %>
<%- if local_scope == 'default' %>
    # ACLs for UA policy enforcement:
    # 1) Block clients with no user-agent.
    # 2) Block clients with a library default or WDQS User-Agent unless a contact information is provided
    # 3) Temporarily allow library-default UAs for gerrit.wikimedia.org (T417156)
    acl is_gerrit req.fhdr(Host) -m str -i gerrit.wikimedia.org
    acl ua_policy_none req.fhdr_cnt(User-Agent) -m int eq 0
    acl ua_library_default req.fhdr(User-Agent) -m reg -i "^(python\-requests|python\/[\d.]+ aiohttp\/[\d.]+|python\-urllib|python\-httpx|okhttp\/|java|apache\-httpclient|go\-|birdnet\-go|guzzlehttp|axios)"
    acl ua_wdqs req.fhdr(User-Agent) -m reg -i "^Wikidata Query Service"
    acl ua_internals req.fhdr(User-Agent) -m reg -i "^Parsoid\/[\d.]+"
    # These are library defaults that include an url for the software itself
    acl ua_forge_url req.fhdr(User-Agent) -m reg -i "https?\:\/\/(github\.com|gitlab\.com)"

    # Allow generic user agents, assuming they provide some form of contact information.
    acl ua_has_contact_info var(req.contact_info) -m found

    # Register why a client was blocked, based on matched ACL.
    # When modifying these, make sure to also modify the corresponding `http-request deny` rules below.
    http-request set-var(txn.x_requestctl) str('ua_policy:none') if ua_policy_none # User-Agent not set.
    http-request set-var(txn.x_requestctl) str('ua_policy:library_default') if ua_library_default !is_gerrit !ua_has_contact_info or ua_library_default !is_gerrit ua_forge_url # Default User-Agent from library.
    http-request set-var(txn.x_requestctl) str('ua_policy:wdqs') if ua_wdqs !ua_has_contact_info # WDQS User-Agent.
    http-request set-var(txn.x_requestctl) str('ua_policy:internals') if ua_internals !ua_has_contact_info # "Internals" UAs

    # Return HTTP 403 when not matching either of our user-agent policies
    # When modifying these, make sure to also modify the corresponding `http-request set-var(txn.x_requestctl)` rules above.
    <%- ua_policy_body = "Please set a user-agent and respect our robot policy https://w.wiki/4wJS. See also https://phabricator.wikimedia.org/T400119.\\n" %>
    http-request deny status 403 content-type text/plain string "<%= ua_policy_body %>" if ua_policy_none
    http-request deny status 403 content-type text/plain string "<%= ua_policy_body %>" if ua_library_default !is_gerrit !ua_has_contact_info or ua_library_default !is_gerrit ua_forge_url
    http-request deny status 403 content-type text/plain string "<%= ua_policy_body %>" if ua_wdqs !ua_has_contact_info
    http-request deny status 403 content-type text/plain string "<%= ua_policy_body %>" if ua_internals !ua_has_contact_info
<%- end -%>

    {{- $path := "/request-haproxy-dsl/cache-<%= @cache_cluster %>/<% if local_scope != 'default' %><%= local_scope %>-<% end %><%= @site %>" -}}
    {{- if not (exists $path) }}
    {{- $path = "/request-haproxy-dsl/cache-<%= @cache_cluster %>/<% if local_scope != 'default' %><%= local_scope %>-<% end %>global" -}}
    {{- end }}
    {{ if exists $path }}
    # REQUESTCTL FILTERS
    {{ $value := json (getv $path) }}{{ range split $value.dsl "\n" }}
    {{ . }}
    {{- end }}
    {{- end}}

    # Populate the X-Requestctl request header in order pass the current state on to varnish. This
    # is only relevant in case requestctl rules haven't blocked the request.
    http-request set-header X-Requestctl %[var(txn.x_requestctl)]

    server backend_server <%= @backend['prefix'] %>@<%= @backend['address'] %><%- if @backend['maxconn'] -%> maxconn <%= @backend['maxconn'] %><%- end %>
<%- end -%>
<%- end -%>

<%- if @dedicated_hc_backend -%>
backend healthcheck
    option forwardfor
    server hc_server <%= @backend['prefix'] %>@<%= @backend['address'] %> maxconn 100
<%- end -%>

<%- if @prometheus_port -%>
frontend stats
    no log
    maxconn 1000
    bind :<%= @prometheus_port %>
    bind :::<%= @prometheus_port %> v6only
    http-request use-service prometheus-exporter if { path /metrics }
    stats enable
    stats uri /stats
    stats refresh 10s
    # Explicitly avoid keep-alive to prevent Prometheus scrapers from
    # reusing indefinitelly the same TCP connection. See T343000
    http-after-response set-header Connection Close
<%- end -%>
