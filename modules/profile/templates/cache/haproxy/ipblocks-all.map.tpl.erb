<%#- SPDX-License-Identifier: Apache-2.0 -%>
{{- range gets "/request-ipblocks/abuse/*" }}
    {{- $ipblock := json .Value }}
    {{- $id := base .Key }}
    {{- /*
    There is no 'default' or 'hasKey' function to catch a missing 'enabled' field.
    To work around this we implicitly cast .enabled to string (which will result
    in "<nil>" if the field does not exist) and test that to not be false.
    */}}
    {{- if not (eq (print $ipblock.enabled) "false") }}
        {{- range $cidr := $ipblock.cidrs }}
{{ $cidr }}   abuse={{ $id }}
        {{- end }}
    {{- end }}
{{- end }}
{{- range gets "/request-ipblocks/known-clients/*" }}
    {{- $ipblock := json .Value }}
    {{- $id := base .Key }}
    {{- if not (eq (print $ipblock.enabled) "false") }}
        {{- range $cidr := $ipblock.cidrs }}
{{ $cidr }}   client={{ $id }}
        {{- end }}
    {{- end }}
    {{- end }}
{{- range gets "/request-ipblocks/cloud/*" }}
    {{- $ipblock := json .Value }}
    {{- $id := base .Key }}
    {{- if not (eq (print $ipblock.enabled) "false") }}
        {{- range $cidr := $ipblock.cidrs }}
{{ $cidr }}   cloud={{ $id }}
        {{- end }}
    {{- end }}
{{- end }}

