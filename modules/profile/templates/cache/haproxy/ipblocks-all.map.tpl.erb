<%#- SPDX-License-Identifier: Apache-2.0 -%>
{{- range gets "/request-ipblocks/abuse/*" }}
    {{- $ipblock := json .Value }}
    {{- $id := base .Key }}
    {{- if ne $ipblock.enabled false }}
        {{- range $cidr := $ipblock.cidrs }}
{{ $cidr }}   abuse={{ $id }}
        {{- end }}
    {{- end }}
{{- end }}
{{- range gets "/request-ipblocks/known-clients/*" }}
    {{- $ipblock := json .Value }}
    {{- $id := base .Key }}
    {{- if ne $ipblock.enabled false }}
        {{- range $cidr := $ipblock.cidrs }}
{{ $cidr }}   client={{ $id }}
        {{- end }}
    {{- end }}
{{- end }}
{{- range gets "/request-ipblocks/cloud/*" }}
    {{- $ipblock := json .Value }}
    {{- $id := base .Key }}
    {{- if ne $ipblock.enabled false }}
        {{- range $cidr := $ipblock.cidrs }}
{{ $cidr }}   cloud={{ $id }}
        {{- end }}
    {{- end }}
{{- end }}
