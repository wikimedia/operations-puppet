<%#- SPDX-License-Identifier: Apache-2.0 -%>
# Note: This file is managed by puppet.
<%
    htsets = @facts['numa']['device_to_htset'][@numa_iface]
    num_threads = htsets.flatten.size
-%>
global
    user haproxy
    group haproxy
    stats socket <%= @socket %> mode 600 expose-fd listeners level admin
    log /var/lib/haproxy/dev/log local0 info
    <%- if @use_haproxykafka -%>
    log <%= @haproxykafka_socket %> len <%= @log_length %> format rfc5424 local0 info
    tune.http.logurilen 2048
    <%- end -%>
    # do not keep old processes longer than 1m after a reload
    hard-stop-after 1m
    set-dumpable
    nbthread <%= num_threads %>
    warn-blocked-traffic-after 500ms
<%
    htsets = @facts['numa']['device_to_htset'][@numa_iface]
    cpus = htsets.flatten.join(' ')
-%>
<%- if @facts['processors']['physicalcount'] > 1 -%>
    # NB: mapping too many cores (>~60) will cause HAProxy to complain about
    # too long of a line and fail to start
    cpu-map 1/1- <%= cpus %>
<%- end -%>

<%- if ['haproxy32', 'haproxy32-awslc'].include?(@haproxy_version) -%>
    tune.lua.bool-sample-conversion pre-3.1-bug
<%- end -%>
<%- if @use_private_data -%>
    lua-prepend-path /etc/haproxy/lua/private/?.lua
<% @private_lua_files.each do |lua_file| -%>
    lua-load-per-thread /etc/haproxy/lua/private/<%= lua_file %>
<%- end -%>
<%- end -%>
    lua-load-per-thread /etc/haproxy/lua/maxmind-lookup.lua
<%- if @report_ja3n -%>
    tune.ssl.capture-buffer-size 96
    lua-load-per-thread /etc/haproxy/lua/ja3n.lua
<%- end -%>
<%- if @report_ja4h -%>
    lua-load-per-thread /etc/haproxy/lua/ja4h.lua
<%- end -%>
    lua-load-per-thread /etc/haproxy/lua/utf8ps.lua
    lua-load-per-thread /etc/haproxy/lua/contact_info.lua
<%- if @use_cidergrinder -%>
    lua-load-per-thread /etc/haproxy/lua/cidergrinder_mmdb.lua /usr/share/CIDERGRINDER/anonymous-residential.cider.mmdb
    lua-load-per-thread /etc/haproxy/lua/cidergrinder_bloom.lua /usr/share/CIDERGRINDER/anonymous-residential.cider.bloom
<%- end -%>

    ssl-default-bind-options ssl-min-ver <%= @min_tls_version -%> ssl-max-ver <%= @max_tls_version %>
    ssl-default-bind-ciphers <%= @tls_ciphers %>
    ssl-default-bind-ciphersuites <%= @tls13_ciphers %>
<%- unless @haproxy_version == 'haproxy32-awslc' -%>
    ssl-dh-param-file /etc/ssl/dhparam.pem
<%- end -%>
    tune.ssl.cachesize <%= @tls_cachesize %>
    tune.ssl.lifetime <%= @tls_session_lifetime %>
    maxconn 200000


    tune.h2.header-table-size <%= @h2settings['header_table_size'] %>
<%# let dynamic window sizing do its thing (available on HAProxy >=3.1) -%>
<%- unless ['haproxy32', 'haproxy32-awslc'].include?(@haproxy_version) -%>
    tune.h2.initial-window-size <%= @h2settings['initial_window_size'] %>
<%- end -%>
    tune.h2.max-concurrent-streams <%= @h2settings['max_concurrent_streams'] %>


defaults
    mode       http
    log-format "%rt %Tr %Tw %Tc %ST {%[capture.req.hdr(0)]} {%[capture.res.hdr(0)]} %ts"
    log-format-sd %{+E}o\ [haproxykafka@0\ server_pid=\"%pid\"\ ip=\"%ci\"\ sequence=\"%rt\"\ dt=\"%tr\"\ time_backend_response=\"%Tr\"\ http_status=\"%ST\"\ response_size=\"%B\"\ termination_state=\"%ts\"\ uri_host=\"%[var(txn.host),lua.utf8ps]\"\ referer=\"%[capture.req.hdr(1),lua.utf8ps]\"\ user_agent=\"%[capture.req.hdr(2),lua.utf8ps]\"\ accept_language=\"%[capture.req.hdr(3),lua.utf8ps]\"\ range=\"%[capture.req.hdr(4),lua.utf8ps]\"\ accept=\"%[capture.req.hdr(5),lua.utf8ps]\"\ tls=\"%[var(txn.tls)]\"\ cache_status=\"%[var(txn.x_cache_status)]\"\ content_type=\"%[var(txn.content_type)]\"\ x_analytics=\"%[var(txn.x_analytics)]\"\ x_cache=\"%[var(txn.x_cache)]\"\ backend=\"%[var(txn.server)]\"\ x_provenance=\"%[var(txn.provenance)]\"\ http_method=\"%HM\"\ uri_path=\"%HPO\"\ uri_query=\"%HQ\"]

    option     dontlognull
<%- if ['haproxy32', 'haproxy32-awslc'].include?(@haproxy_version) -%>
    option     accept-unsafe-violations-in-http-request
    option     accept-unsafe-violations-in-http-response
<%- else -%>
    option     accept-invalid-http-request
    option     accept-invalid-http-response
<%- end -%>
    option     http-ignore-probes
    retries    1
    timeout    connect 50000
    timeout    client 500000
    timeout    server 500000
