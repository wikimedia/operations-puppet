[Unit]
Description=mtail instance for Apache Traffic Server %i
Documentation=https://wikitech.wikimedia.org/wiki/Apache_Traffic_Server
# atsmtail depends on a given fifo-log-demux instance:
#   atsmtail@backend -> fifo-log-demux@notpurge.service
BindsTo=<%= @wanted_by %>
After=<%= @wanted_by %>

[Service]
SyslogIdentifier=atsmtail-%i
Restart=always
ExecStart=/bin/sh -c '/usr/bin/fifo-log-tailer -socket "/run/trafficserver/<%= @atsmtail_log_basename %>.sock" | mtail -progs "<%= @atsmtail_progs %>" -logs /dev/stdin -disable_fsnotify -port "<%= @atsmtail_port %>" <%= @mtail_args %>'

[Install]
WantedBy=<%= @wanted_by %>
