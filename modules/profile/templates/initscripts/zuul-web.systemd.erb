<%#- SPDX-License-Identifier: Apache-2.0 -%>
; https://phabricator.wikimedia.org/T405119
[Unit]
Description=zuul-web service

[Service]
User=zuul
Group=zuul
ExecStart=/usr/bin/docker run \
         --rm \
         --name zuul-web \
         --add-host=host.docker.internal:<%= @host_ip %> \
         -p 9000:9000 \
         --mount type=bind,src=/etc/zuul,dst=/etc/zuul \
         --mount type=bind,src=/etc/zookeeper/zuul-tls,dst=/etc/zookeeper/zuul-tls \
         docker-registry.wikimedia.org/repos/releng/zuul/zuul/zuul-web:<%= @image_version %>

; https://www.groundcover.com/kubernetes-troubleshooting/exit-code-143
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
