<%#- SPDX-License-Identifier: Apache-2.0 -%>
; https://phabricator.wikimedia.org/T405118
[Unit]
Description=zuul scheduler service

[Service]
User=zuul
Group=zuul
ExecStart=/usr/bin/docker run \
         --add-host=host.docker.internal:<%= @host_ip %> \
         --mount type=bind,src=/etc/zuul,dst=/etc/zuul \
         --mount type=bind,src=/var/lib/zuul,dst=/var/lib/zuul \
         --mount type=bind,src=/etc/zookeeper/zuul-tls,dst=/etc/zookeeper/zuul-tls \
         --mount type=bind,src=/var/ssh/zuul,dst=/var/ssh/zuul \
         <%- if @http_proxy -%>
         --env HTTP_PROXY=<%= @http_proxy %> \
         --env HTTPS_PROXY=<%= @http_proxy %> \
         <%- end -%>
         <%- if @no_proxy -%>
         --env NO_PROXY=<%= @no_proxy.join(",") %> \
         <%- end -%>
         docker-registry.wikimedia.org/repos/releng/zuul/zuul/zuul-scheduler:<%= @image_version %>

; https://www.groundcover.com/kubernetes-troubleshooting/exit-code-143
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
