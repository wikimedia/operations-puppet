<%#- SPDX-License-Identifier: Apache-2.0 -%>
[Unit]
Description=AMD GPU partitioning restore at startup
After=local-fs.target systemd-udev-settle.service
Before=kubelet.service amd-k8s-device-plugin.service amd-k8s-node-labeller.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/amd-smi-gpu-partition
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
