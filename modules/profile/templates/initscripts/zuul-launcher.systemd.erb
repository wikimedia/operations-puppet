<%#- SPDX-License-Identifier: Apache-2.0 -%>
[Unit]
Description=zuul launcher service

[Service]
ExecStart=/usr/bin/docker run \
         --rm \
         --name zuul-launcher \
         --user 923:923 \
         --add-host=host.docker.internal:<%= @host_ip %> \
         --mount type=bind,src=/etc/zuul,dst=/etc/zuul \
         --mount type=bind,src=/etc/zuul-launcher,dst=/etc/zuul-launcher \
         --mount type=bind,src=<%= @tls_config_dir %>,dst=<%= @tls_config_dir%> \
         <%- if @http_proxy -%>
         --env HTTP_PROXY=<%= @http_proxy %> \
         --env HTTPS_PROXY=<%= @http_proxy %> \
         <%- end -%>
         <%- if @no_proxy -%>
         --env NO_PROXY=<%= @no_proxy.join(",") %> \
         <%- end -%>
         docker-registry.wikimedia.org/repos/releng/zuul/zuul/zuul-launcher:<%= @image_version %>

; https://www.groundcover.com/kubernetes-troubleshooting/exit-code-143
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
