<%#- SPDX-License-Identifier: Apache-2.0 -%>
# vim: sw=2 ts=2 sts=2 et ft=apache
#####################################################################
### THIS FILE IS MANAGED BY PUPPET
#####################################################################

<VirtualHost *:80>
  ServerName <%= @vhost %>
  ServerAdmin <%= @serveradmin %>

  # Should never be seen, but apache needs this set to something
  DocumentRoot /var/www/html

<%- if @use_tls_endpoint -%>
  SSLProxyEngine on
<%- end -%>
  RewriteEngine on
<%- if @require_ssl -%>
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^/(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,E=ProtoRedirect]
  Header always merge Vary X-Forwarded-Proto env=ProtoRedirect
<%- end -%>

  <Directory />
    Options FollowSymLinks
    AllowOverride None
    Require all denied
  </Directory>

  <Location />
    ProxyPass "<%= @use_tls_endpoint ? 'https' : 'http' %>://<%= @facts['networking']['fqdn'] %>:9200/"
<%= @apache_auth -%>
  </Location>

  ProxyRequests Off

  <Proxy <%= @use_tls_endpoint ? 'https' : 'http' %>://<%= @facts['networking']['fqdn'] %>:9200>
    ProxySet connectiontimeout=5 timeout=90 retry=0
  </Proxy>

  # Tell caches that we are using http authentication
  Header set Vary Authorization

  # Allow GET / exclusively for health checking purposes
  <LocationMatch "^/$">
    <RequireAll>
      Require all granted
      Require method GET
    </RequireAll>
  </LocationMatch>

<%= @locationmatch_search_endpoint %>
</VirtualHost>
