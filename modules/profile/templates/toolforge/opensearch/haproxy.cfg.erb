# SPDX-License-Identifier: Apache-2.0

global
    chroot /var/lib/haproxy
    daemon
    group haproxy
    log /dev/log local0
    stats socket <%= @socket %> mode 666 level user
    user haproxy

defaults
    log global
    maxconn 2048
    mode http
    option dontlognull
    option forwardfor
    option redispatch
    retries 3
    timeout client 50s
    timeout connect 10s
    timeout http-keep-alive 10s
    timeout http-request 5s
    timeout server 5m

listen stats
    bind 0.0.0.0:9900
    bind :::9900
    mode http

    stats enable
    stats uri /stats
    http-request use-service prometheus-exporter if { path /metrics }

