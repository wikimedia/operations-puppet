# Note: This file is managed by puppet.

# Pseudo-backends for stick tables
backend limit-per-tool
    stick-table type string len 128 size 8k expire 10s store conn_cur

frontend k8s-ingress-http
    bind 0.0.0.0:80
    bind :::80
    http-request redirect scheme https
    option httplog
    option dontlog-normal

frontend k8s-ingress-https
    mode http

    bind 0.0.0.0:443 ssl crt /etc/acmecerts/<%= @acme_certname %>/live/ec-prime256v1.chained.crt.key alpn h2,http/1.1
    bind :::443 crt /etc/acmecerts/<%= @acme_certname %>/live/ec-prime256v1.chained.crt.key alpn h2,http/1.1

    http-error status 500 content-type "text/html; charset=utf-8" file "/etc/haproxy/errors/errorpage.html"
    http-error status 503 content-type "text/html; charset=utf-8" file "/etc/haproxy/errors/errorpage.html"

    option httpslog
    option dontlog-normal

    # Host normalization
    # Use the host_only converter to remove eventual trailing port and
    # lowercase it. Also, remove eventual trailing dot.
    http-request set-header Host %[req.hdr(Host),host_only,rtrim(.)]

    http-request set-header X-Forwarded-Host %[req.hdr(Host)]
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Port 443
    http-request set-header X-Original-URI %[url]

    # See http://www.gnuterrypratchett.com/
    http-response set-header X-Clacks-Overhead "GNU Terry Pratchett"
    # T102367: 366 days
    http-response set-header Strict-Transport-Security "max-age=31622400"
    # T130748: Add a report-only CSP header
    http-response set-header Content-Security-Policy-Report-Only "default-src 'self' 'unsafe-eval' 'unsafe-inline' blob: data: filesystem: mediastream: *.toolforge.org wikibooks.org *.wikibooks.org wikidata.org *.wikidata.org wikimedia.org *.wikimedia.org wikinews.org *.wikinews.org wikipedia.org *.wikipedia.org wikiquote.org *.wikiquote.org wikisource.org *.wikisource.org wikiversity.org *.wikiversity.org wikivoyage.org *.wikivoyage.org wiktionary.org *.wiktionary.org *.wmcloud.org *.wmflabs.org wikimediafoundation.org mediawiki.org *.mediawiki.org wss://$host; report-uri https://csp-report.toolforge.org/collect;"
    # T353589: Opt-out of Google's "topics" interest-based advertising system
    http-response set-header Permissions-Policy "browsing-topics=()"
    # T400994: Collect network error reports
    http-response set-header Report-To '{"group": "wm_nel", "max_age": 604800, "endpoints": [{"url": "https://intake-logging.wikimedia.org/v1/events?stream=w3c.reportingapi.network_error&schema_uri=/w3c/reportingapi/network_error/1.0.0"}]}'
    http-response set-header NEL '{"report_to": "wm_nel", "max_age": 604800, "failure_fraction": 0.05, "success_fraction": 0.0}'

    # Protect against http://httpoxy.org/ issues in tools
    http-request del-header Proxy

    # GZIP ALL THE THINGS!
    compression algo gzip
    compression type text/plain text/css text/xml application/json application/javascript application/x-javascript text/javascript

    # TODO: default 404 handlers for /favicon.ico and /robots.txt
    # TODO: header/UA blocks
    # TODO: per-IP rate limiting
    # TODO: logging for toolviews

    # Limit number of requests sent to a specific tool at one time (T404471#11177519)
    http-request track-sc0 hdr(Host) table limit-per-tool
    http-request deny status 503 content-type "text/html; charset=utf-8" file "/etc/haproxy/errors/overloaded.html" if { sc0_conn_cur(limit-per-tool) gt <%= @web_tool_connection_limit %> }

    use_backend k8s-ingress-api-gateway-http if { hdr(host) -i api.svc.<%= @web_domain %> }
    default_backend k8s-ingress-http

    timeout client 1h
    # Higher number of max connections here than the backends can handle, so that we can always
    # queue clients and/or serve errors
    maxconn <%= @web_backend_conn_limit * (@ingress_nodes.length + 1) %>

backend k8s-ingress-http
    mode http

    maxconn <%= @web_backend_conn_limit * @ingress_nodes.length %>
    option httpchk GET /healthz
    balance roundrobin
    timeout server 1h
    default-server inter 10s downinter 5s rise 2 fall 2 slowstart 60s maxconn <%= @web_backend_conn_limit %> maxqueue 256 weight 100
<%- @ingress_nodes.each do |server| -%>
    server <%= server %> <%= server %>:<%= @ingress_backend_port %> check
<%- end -%>
