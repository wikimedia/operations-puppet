# Note: This file is managed by puppet.

# Pseudo-backends for stick tables
backend limit-per-ip
    stick-table type ipv6 size 256k expire 300s store http_req_rate(<%= @rate_limit_burst_time %>s),gpc_rate(10,300s),conn_cur
backend limit-per-tool
    stick-table type string len 128 size 8k expire 10s store conn_cur

# T408570: handle iw.toolforge.org/tool/path -> $tool.toolforge.org/path
backend iw-redirect
    mode http
    acl has-tool-name path_reg '^/[A-Za-z0-9_-]+'
    http-request redirect code 301 location 'https://%[path,regsub("/([A-Za-z0-9_-]+)(/|$).*","\1")].<%= @web_domain %>/%[path,regsub("/([A-Za-z0-9_-]+)(/|$)(.*)","\3")]%HQ' if has-tool-name
    http-request redirect code 301 location 'https://toolforge.org/%HQ' unless has-tool-name

frontend k8s-ingress-http
    bind 0.0.0.0:80
    bind :::80
    http-request redirect scheme https
    option httplog
    option httpclose

    maxconn <%= @http_redirect_conn_limit %>

    timeout client  10s
    timeout client-fin 5s

frontend k8s-ingress-https
    mode http

    bind 0.0.0.0:443 ssl crt /etc/acmecerts/<%= @acme_certname %>/live/ec-prime256v1.chained.crt.key alpn h2,http/1.1
    bind :::443 ssl crt /etc/acmecerts/<%= @acme_certname %>/live/ec-prime256v1.chained.crt.key alpn h2,http/1.1

    http-error status 500 content-type "text/html; charset=utf-8" file "/etc/haproxy/errors/errorpage.html"
    http-error status 503 content-type "text/html; charset=utf-8" file "/etc/haproxy/errors/errorpage.html"

    option httpslog

    http-request track-sc0 src table limit-per-ip
    acl break_enforced sc_gpc_rate(0,0,limit-per-ip) gt 0
    http-request silent-drop if break_enforced
    http-request set-log-level silent if break_enforced

    # Host normalization
    # Use the host_only converter to remove eventual trailing port and
    # lowercase it. Also, remove eventual trailing dot.
    http-request set-header Host %[req.hdr(Host),host_only,rtrim(.)]
    http-request set-var(txn.host) req.hdr(Host)

    http-request set-header X-Forwarded-Host %[req.hdr(Host)]
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Port 443
    http-request set-header X-Original-URI %[path]%HQ

    log-format "${HAPROXY_HTTPS_LOG_FMT} host:%{+Q}[var(txn.host)] ip-rate:%[sc_http_req_rate(0,limit-per-ip)] ip-conns:%[sc_conn_cur(0,limit-per-ip)] tool-conns:%[sc_conn_cur(1,limit-per-tool)]"

    # T301720: redirect ru_monuments to ru-monuments
    http-request redirect code 301 location https://ru-monuments.<%= @web_domain %>%[capture.req.uri] if { hdr(host) -i ru_monuments.<%= @web_domain %> }

    # See http://www.gnuterrypratchett.com/
    http-after-response set-header X-Clacks-Overhead "GNU Terry Pratchett"
    # T102367: 366 days
    http-after-response set-header Strict-Transport-Security "max-age=31622400"
    # T130748: Add a report-only CSP header
    http-after-response set-header Content-Security-Policy-Report-Only "default-src 'self' 'unsafe-eval' 'unsafe-inline' blob: data: filesystem: mediastream: *.toolforge.org wikibooks.org *.wikibooks.org wikidata.org *.wikidata.org wikimedia.org *.wikimedia.org wikinews.org *.wikinews.org wikipedia.org *.wikipedia.org wikiquote.org *.wikiquote.org wikisource.org *.wikisource.org wikiversity.org *.wikiversity.org wikivoyage.org *.wikivoyage.org wiktionary.org *.wiktionary.org *.wmcloud.org *.wmflabs.org wikimediafoundation.org mediawiki.org *.mediawiki.org wss://%[var(txn.host)]; report-uri https://csp-report.toolforge.org/collect;"
    # T353589: Opt-out of Google's "topics" interest-based advertising system
    http-after-response set-header Permissions-Policy "browsing-topics=()"
    # T400994: Collect network error reports
    http-after-response set-header Report-To '{"group": "wm_nel", "max_age": 604800, "endpoints": [{"url": "https://intake-logging.wikimedia.org/v1/events?stream=w3c.reportingapi.network_error&schema_uri=/w3c/reportingapi/network_error/1.0.0"}]}'
    http-after-response set-header NEL '{"report_to": "wm_nel", "max_age": 604800, "failure_fraction": 0.05, "success_fraction": 0.0}'

    # Protect against http://httpoxy.org/ issues in tools
    http-request del-header Proxy

    # GZIP ALL THE THINGS!
    compression algo gzip
    compression type text/plain text/css text/xml application/json application/javascript application/x-javascript text/javascript

    acl has_ua req.hdr(user-agent) -m found
    acl banned src -n -f /etc/haproxy/banned-ips.txt
<%- if @blocked_user_agent_regex -%>
    acl banned req.hdr(user-agent) -m reg -i "<%= @blocked_user_agent_regex %>"
<%- end -%>
<%- if @blocked_referer_regex -%>
    acl banned req.hdr(referer) -m reg -i "<%= @blocked_referer_regex %>"
<%- end -%>
    http-request deny status 403 content-type "text/html; charset=utf-8" file "/etc/haproxy/errors/banned.html" if !has_ua || banned

<%- @disabled_hosts.each do |host| -%>
    http-request deny status 403 content-type "text/html; charset=utf-8" file "/etc/haproxy/errors/disabled.html" if { hdr(host) -i <%= host %> }
<%- end -%>

    ### Rate limiting

    # Silent-drop clients persistently going over the rate limit
    acl needs_break_enforced sc_http_req_rate(0,limit-per-ip) gt <%= (@rate_limit_requests * @rate_limit_burst_time * 1.25).floor %>
    acl enforce_break sc_inc_gpc(0,0,limit-per-ip) gt 0
    http-request silent-drop if !break_enforced needs_break_enforced enforce_break
    http-request set-var-fmt(req.debug_format) "src=%[src]" if !break_enforced needs_break_enforced
    http-request set-var(req.debug) var(req.debug_format),debug(silent-drop,stderr) if !break_enforced needs_break_enforced

    # Most rate limit violators will get a simple 429 page.
    http-request deny status 429 content-type "text/html; charset=utf-8" file "/etc/haproxy/errors/ratelimit.html" if { sc_http_req_rate(0,limit-per-ip) gt <%= @rate_limit_requests * @rate_limit_burst_time %> }

    # Limit number of requests sent to a specific tool at one time (T404471#11177519)
    http-request track-sc1 hdr(Host) table limit-per-tool
    http-request deny status 503 content-type "text/html; charset=utf-8" file "/etc/haproxy/errors/overloaded.html" if { sc_conn_cur(1,limit-per-tool) gt <%= @web_tool_connection_limit %> }

    # T251628: Serve a default /robots.txt and /favicon.ico on a 404 from the backend
    http-response return status 200 content-type "text/plain; charset=utf-8" file "/etc/haproxy/errors/robots.txt" if { status 404 } { capture.req.uri /robots.txt }
    http-response return status 200 content-type "image/x-icon" file "/etc/haproxy/errors/favicon.ico" if { status 404 } { capture.req.uri /favicon.ico }

    # For upstream servers, all requests appear to come over http,
    # thus emitting redirects to that as well.  So we need to
    # rewrite redirects with the /actual/ scheme the request came
    # in over.  There may be fringe cases where upstream servers
    # want https requests to redirect to non-Tools servers over
    # http, so we limit the rewriting to the current $host.
    http-response replace-header Location ^http://([^\.]+)\.<%= @web_domain.gsub(/\./, "\\.") %>/(.*) https://\1.<%= @web_domain %>/\2

    http-request redirect code 301 location 'https://www.<%= @web_domain %>' if { hdr(host) -i <%= @web_domain %> }

    use_backend iw-redirect if { hdr(host) -i iw.<%= @web_domain %> }
    use_backend k8s-ingress-api-gateway-http if { hdr(host) -i api.svc.<%= @web_domain %> }
    default_backend k8s-ingress-http

    timeout client <%= @web_client_timeout %>s
    timeout client-fin 15s

    maxconn <%= @frontend_conn_limit %>

backend k8s-ingress-http
    mode http

    option httpchk GET /healthz/ready HTTP/1.1
    http-check send hdr Host <%= @web_domain %>
    balance roundrobin
    timeout server 1h
    default-server inter 10s downinter 5s rise 2 fall 2 slowstart 60s maxconn <%= @web_backend_conn_limit %> maxqueue 256 weight 100
    default-server resolvers system-resolvers resolve-prefer ipv4
<%- @gateway_nodes.each do |server| -%>
    server <%= server %> <%= server %>:<%= @gateway_backend_port %> check port <%= @gateway_healthz_port %>
<%- end -%>
