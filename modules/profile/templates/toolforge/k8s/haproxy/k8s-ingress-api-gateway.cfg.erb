frontend k8s-ingress-api-gateway-tcp
    bind 0.0.0.0:<%= @api_gateway_port %>
    bind :::<%= @api_gateway_port %>
    mode tcp
    option tcplog
    timeout client 1h
    default_backend k8s-ingress-api-gateway-tcp

backend k8s-ingress-api-gateway-tcp
    mode tcp
    option httpchk GET /healthz
    balance roundrobin
    timeout server 1h
    default-server inter 10s downinter 5s rise 2 fall 2 slowstart 60s maxconn 250 maxqueue 256 weight 100
    default-server resolvers system-resolvers resolve-prefer ipv4
<%- @gateway_nodes.each do |server| -%>
    server <%= server %> <%= server %>:<%= @api_gateway_port %> check check-ssl verify none
<%- end -%>

backend k8s-ingress-api-gateway-http
    mode http
    option httpchk GET /healthz
    balance roundrobin
    timeout server 1h
    default-server inter 10s downinter 5s rise 2 fall 2 slowstart 60s maxconn 250 maxqueue 256 weight 100
    default-server resolvers system-resolvers resolve-prefer ipv4
<%- @gateway_nodes.each do |server| -%>
    server <%= server %> <%= server %>:<%= @api_gateway_port %> ssl check check-ssl verify none
<%- end -%>
