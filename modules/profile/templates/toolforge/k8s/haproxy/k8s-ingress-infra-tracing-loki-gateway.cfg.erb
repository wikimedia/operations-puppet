frontend k8s-ingress-infra-tracing-loki-gateway-tcp
    bind 0.0.0.0:<%= @infra_tracing_loki_gateway_port %>
    bind :::<%= @infra_tracing_loki_gateway_port %>
    mode tcp
    option tcplog
    timeout client 1m
    default_backend k8s-ingress-infra-tracing-loki-gateway-tcp

backend k8s-ingress-infra-tracing-loki-gateway-tcp
    mode tcp
    option httpchk GET /
    balance roundrobin
    timeout server 1h
    default-server inter 10s downinter 5s rise 2 fall 2 slowstart 60s maxconn 250 maxqueue 256 weight 100
    default-server resolvers system-resolvers resolve-prefer ipv4
<%- @ingress_nodes.each do |server| -%>
    server <%= server %> <%= server %>:<%= @infra_tracing_loki_gateway_port %> check check-ssl verify none
<%- end -%>
