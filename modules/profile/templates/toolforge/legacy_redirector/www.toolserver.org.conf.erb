# vim: filetype=apache

<VirtualHost *:80>
    ServerAdmin root@toolserver.org
    ServerName www.toolserver.org
    ServerAlias toolserver.org
    ServerAlias *.www.toolserver.org
    ServerAlias stable.toolserver.org
    ServerAlias wiki.toolserver.org
    ServerAlias status.toolserver.org

<%- if @ssl_certificate_name -%>
    DocumentRoot /var/www/www.toolserver.org/

    RewriteEngine on
    RewriteCond %{SERVER_PORT} !^443$
    RewriteRule ^/(.*)$ https://www.toolserver.org/$1 [L,NE,R]

    CustomLog /var/log/apache2/www.toolserver.org-access.log wmf
    ErrorLog /var/log/apache2/www.toolserver.org-error.log
    LogLevel warn
    ServerSignature Off
</VirtualHost>

<VirtualHost *:443>
    ServerAdmin root@toolserver.org
    ServerName www.toolserver.org
    ServerAlias toolserver.org
    ServerAlias *.www.toolserver.org
    ServerAlias stable.toolserver.org
    ServerAlias wiki.toolserver.org

    SSLEngine on
    SSLCertificateFile /etc/acmecerts/<%= @ssl_certificate_name %>/live/ec-prime256v1.crt
    SSLCertificateChainFile /etc/acmecerts/<%= @ssl_certificate_name %>/live/ec-prime256v1.chained.crt
    SSLCertificateKeyFile /etc/acmecerts/<%= @ssl_certificate_name %>/live/ec-prime256v1.key
    <%= @ssl_settings.join("\n    ") %>

    Header always set Report-To '{"group": "wm_nel", "max_age": 604800, "endpoints": [{"url": "https://intake-logging.wikimedia.org/v1/events?stream=w3c.reportingapi.network_error&schema_uri=/w3c/reportingapi/network_error/1.0.0"}]}'
    Header always set NEL '{"report_to": "wm_nel", "max_age": 604800, "failure_fraction": 0.05, "success_fraction": 0.0}'
<%- end -%>

    DocumentRoot /var/www/www.toolserver.org/

    CustomLog /var/log/apache2/www.toolserver.org-access.log wmf
    ErrorLog /var/log/apache2/www.toolserver.org-error.log
    LogLevel warn
    ServerSignature Off

    ErrorDocument 404 /notfound.html

    RewriteEngine on

    # Redirect wiki.toolserver.org to mediawiki.org.
    RewriteCond %{HTTP_HOST} =wiki.toolserver.org [NC]
    RewriteRule ^/view/(.*)$ https://www.mediawiki.org/wiki/Toolserver:$1 [L,R]

    # T224265 - Redirect ~nikola/svgtranslate.php?svg=* to svgtranslate tool
    RewriteCond %{QUERY_STRING} ^svg=(.*)$
    RewriteRule ^/~nikola/svgtranslate.php$ https://svgtranslate.toolforge.org/search?filename=%1 [L,R=301]

