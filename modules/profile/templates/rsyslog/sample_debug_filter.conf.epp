<%#- SPDX-License-Identifier: Apache-2.0 -%>
<%- | String $sampling_rate | -%>

module(load="builtin:omfile")

set $!rand = random(<%= $sampling_rate %>);

template(name="DebugTemplate" type="list") {
    constant(value="Received: ")
    property(name="timereported" dateFormat="rfc3339")
    constant(value=" FromHost: '")
    property(name="fromhost")
    constant(value="' Hostname: '")
    property(name="hostname")
    constant(value="' App: '")
    property(name="programname")
    constant(value="' Tag: '")
    property(name="syslogtag")
    constant(value="' Message: ")
    property(name="msg")
    constant(value="\n")
}

if ($fromhost-ip != '127.0.0.1' and $!rand == 0) then {
    action(
        type="omfile"
        file="/srv/syslog/rsyslog-debug-custom.log"
        template="DebugTemplate"
    )

    action(
        type="omfile"
        file="/srv/syslog/rsyslog-debug-standard.log"
        template="RSYSLOG_DebugFormat"
    )
}
