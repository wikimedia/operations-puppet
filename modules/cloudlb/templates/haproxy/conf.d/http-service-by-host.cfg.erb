# modules/cloudlb/templates/haproxy/conf.d/http-service-by-host.cfg.erb

frontend <%= @title %>_frontend
<%- @frontends.each do |frontend| -%>
<%- addresses = frontend['address'] ? [frontend['address']] : ['', '::'] -%>
<%- addresses.each do |addr| -%>
    bind <%= addr %>:<%= frontend['port'] %><% if frontend.include? 'acme_chief_cert_name' %> ssl crt /etc/acmecerts/<%= frontend['acme_chief_cert_name'] %>/live/ec-prime256v1.chained.crt.key<% end %>
<%- end -%>
<%- end -%>
    http-request set-header X-Forwarded-Proto https if { ssl_fc }
    acl is-blocked-ip src -f /etc/haproxy/ipblocklist.txt
    http-request deny if is-blocked-ip
    acl is-blockedagent hdr_sub(user-agent) -i -f /etc/haproxy/agentblocklist.txt
    http-request deny if is-blockedagent

<%- @host_mapping.each do |hostname, backend| -%>
    acl <%= hostname %> hdr(host) -i <%= hostname %>
<%- end -%>
<%- @host_mapping.each do | hostname, backend | -%>
    use_backend <%= backend %>_backend if <%= hostname %>
<%- end -%>
