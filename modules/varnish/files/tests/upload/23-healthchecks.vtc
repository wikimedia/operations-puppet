# SPDX-License-Identifier: Apache-2.0
varnishtest "Test healthcheck endpoints"

# empty server stanza because healthcheck endpoints get synth responses
server s1 {
} -start

varnish v1 -arg "-p vcl_path=${vcl_path} -p vcc_err_unref=false -p vcc_allow_inline_c=true -p cc_command='${cc_command}'" -vcl+backend {
    backend vtc_backend {
        .host = "${s1_addr}"; .port = "${s1_port}";
    }

    include "${basepath}/usr/share/varnish/tests/wikimedia_upload-frontend.vcl";
} -start

client c1 {
    # healthcheck.wikimedia.org
    txreq -url "/varnish-fe" -hdr "X-Forwarded-Proto: https" -hdr "Host: healthcheck.wikimedia.org"
    rxresp

    expect resp.status == 200

    # unique healthcheck path on upload.wm.o
    txreq -url "/varnish-fe-hc-5ebea9" -hdr "X-Forwarded-Proto: https" -hdr "Host: upload.wikimedia.org"
    rxresp

    expect resp.status == 200

    # unique healthcheck path on maps.wm.o
    txreq -url "/varnish-fe-hc-5ebea9" -hdr "X-Forwarded-Proto: https" -hdr "Host: maps.wikimedia.org"
    rxresp

    expect resp.status == 200

    # unique healthcheck path on a random host
    txreq -url "/varnish-fe-hc-5ebea9" -hdr "X-Forwarded-Proto: https" -hdr "Host: foobar.wikimedia.org"
    rxresp

    expect resp.status == 200
} -run
