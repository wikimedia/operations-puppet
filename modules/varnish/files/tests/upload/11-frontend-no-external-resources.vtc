# SPDX-License-Identifier: Apache-2.0
varnishtest "Restrict loading of external resources"

server s1 {
    loop 6 {
        rxreq
        txresp
    }
} -start

varnish v1 -arg "-p vcl_path=${vcl_path} -p vcc_err_unref=false -p vcc_allow_inline_c=true -p cc_command='${cc_command}'" -vcl+backend {
    backend vtc_backend {
        .host = "${s1_addr}"; .port = "${s1_port}";
    }

    # trust all requests by default
    sub vcl_recv {
        set req.http.X-Trusted-Request = "A";
    }
    include "${basepath}/usr/share/varnish/tests/wikimedia_upload-frontend.vcl";
} -start

client c1 {
    txreq -url "/wikipedia/fr" -hdr "X-Forwarded-Proto: https" -hdr "Host: upload.wikimedia.org"
    rxresp

    expect resp.status == 200
    expect resp.http.Content-Security-Policy-Report-Only ~ "default-src 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "script-src 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "style-src 'unsafe-inline' data:;"
    expect resp.http.Content-Security-Policy-Report-Only ~ "font-src data:;"
    expect resp.http.Content-Security-Policy-Report-Only ~ "media-src data: 'self';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "object-src 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "worker-src 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "manifest-src 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "base-uri 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "form-action 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "frame-ancestors 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "report-uri.*reportonly=1"
    expect resp.http.Reporting-Endpoints == "csp_endpoint=\"https://commons.wikimedia.org/w/api.php?reportonly=1&source=image&action=cspreport&format=json\""
    expect resp.http.X-Content-Security-Policy == <undef>
    expect resp.http.X-Content-Security-Policy-Report-Only == <undef>


    txreq -url "/wikipedia/el/test.pdf" -hdr "X-Forwarded-Proto: https" -hdr "Host: upload.wikimedia.org"
    rxresp

    expect resp.status == 200
    expect resp.http.Content-Security-Policy-Report-Only ~ "object-src 'self'"
    expect resp.http.Content-Security-Policy-Report-Only ~ "default-src 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "script-src 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "style-src 'unsafe-inline' data:;"
    expect resp.http.Content-Security-Policy-Report-Only ~ "font-src data:;"
    expect resp.http.Content-Security-Policy-Report-Only ~ "media-src data: 'self';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "worker-src 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "manifest-src 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "base-uri 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "form-action 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "frame-ancestors 'none';"
    expect resp.http.Content-Security-Policy-Report-Only !~ "sandbox"
    expect resp.http.Content-Security-Policy-Report-Only ~ "report-uri.*reportonly=1"
    expect resp.http.Content-Security-Policy == <undef>
    expect resp.http.X-Content-Security-Policy == <undef>
    expect resp.http.X-Content-Security-Policy-Report-Only == <undef>
    expect resp.http.Reporting-Endpoints == "csp_endpoint=\"https://commons.wikimedia.org/w/api.php?reportonly=1&source=image&action=cspreport&format=json\""


    txreq -url "/wikipedia/el/test_page" -hdr "X-Forwarded-Proto: https" -hdr "Host: upload.wikimedia.org"
    rxresp

    # non-pdfs should not have Content-Security-Policy-Report-Only with
    # "object-src 'self'"
    expect resp.status == 200
    expect resp.http.Content-Security-Policy-Report-Only !~ "object-src 'self'"
    # Content-Security-Policy-Report-Only does not support the `sandbox`
    # directive
    expect resp.http.Content-Security-Policy-Report-Only !~ "sandbox"
    expect resp.http.Content-Security-Policy-Report-Only ~ "script-src 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "style-src 'unsafe-inline' data:;"
    expect resp.http.Content-Security-Policy-Report-Only ~ "font-src data:;"
    expect resp.http.Content-Security-Policy-Report-Only ~ "media-src data: 'self';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "object-src 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "worker-src 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "manifest-src 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "base-uri 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "form-action 'none';"
    expect resp.http.Content-Security-Policy-Report-Only ~ "frame-ancestors 'none';"
    expect resp.http.Content-Security-Policy == <undef>
    expect resp.http.X-Content-Security-Policy == <undef>
    expect resp.http.X-Content-Security-Policy-Report-Only == <undef>
    expect resp.http.Content-Security-Policy-Report-Only ~ "report-uri.*reportonly=1"
    expect resp.http.Reporting-Endpoints == "csp_endpoint=\"https://commons.wikimedia.org/w/api.php?reportonly=1&source=image&action=cspreport&format=json\""


    # testing enforce mode; same conditions apply, except that the header is Content-Security-Policy
    txreq -url "/wikipedia/test/test.pdf" -hdr "X-Forwarded-Proto: https" -hdr "Host: upload.wikimedia.org"
    rxresp

    expect resp.status == 200
    expect resp.http.Content-Security-Policy ~ "object-src 'self'"
    expect resp.http.Content-Security-Policy !~ "sandbox"
    expect resp.http.Content-Security-Policy ~ "default-src 'none';"
    expect resp.http.Content-Security-Policy ~ "script-src 'none';"
    expect resp.http.Content-Security-Policy ~ "style-src 'unsafe-inline' data:;"
    expect resp.http.Content-Security-Policy ~ "font-src data:;"
    expect resp.http.Content-Security-Policy ~ "media-src data: 'self';"
    expect resp.http.Content-Security-Policy ~ "worker-src 'none';"
    expect resp.http.Content-Security-Policy ~ "manifest-src 'none';"
    expect resp.http.Content-Security-Policy ~ "base-uri 'none';"
    expect resp.http.Content-Security-Policy ~ "form-action 'none';"
    expect resp.http.Content-Security-Policy ~ "frame-ancestors 'none';"
    expect resp.http.Reporting-Endpoints == "csp_endpoint=\"https://commons.wikimedia.org/w/api.php?reportonly=0&source=image&action=cspreport&format=json\""
    expect resp.http.Content-Security-Policy ~ "report-uri.*reportonly=0"
    expect resp.http.X-Content-Security-Policy == <undef>
    expect resp.http.X-Content-Security-Policy-Report-Only == <undef>


    txreq -url "/wikipedia/test/test_page" -hdr "X-Forwarded-Proto: https" -hdr "Host: upload.wikimedia.org"
    rxresp

    expect resp.status == 200
    expect resp.http.Content-Security-Policy ~ "sandbox"
    expect resp.http.Content-Security-Policy ~ "script-src 'none';"
    expect resp.http.Content-Security-Policy ~ "style-src 'unsafe-inline' data:;"
    expect resp.http.Content-Security-Policy ~ "font-src data:;"
    expect resp.http.Content-Security-Policy ~ "media-src data: 'self';"
    expect resp.http.Content-Security-Policy ~ "object-src 'none';"
    expect resp.http.Content-Security-Policy ~ "worker-src 'none';"
    expect resp.http.Content-Security-Policy ~ "manifest-src 'none';"
    expect resp.http.Content-Security-Policy ~ "base-uri 'none';"
    expect resp.http.Content-Security-Policy ~ "form-action 'none';"
    expect resp.http.Content-Security-Policy ~ "frame-ancestors 'none';"
    expect resp.http.Content-Security-Policy ~ "report-uri.*reportonly=0"
    expect resp.http.Reporting-Endpoints == "csp_endpoint=\"https://commons.wikimedia.org/w/api.php?reportonly=0&source=image&action=cspreport&format=json\""
    expect resp.http.X-Content-Security-Policy == <undef>
    expect resp.http.X-Content-Security-Policy-Report-Only == <undef>
} -run
