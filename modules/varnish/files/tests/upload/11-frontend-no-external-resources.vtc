varnishtest "Restrict loading of external resources"

server s1 {
    loop 6 {
        rxreq
        txresp
    }
} -start

varnish v1 -arg "-p vcl_path=${vcl_path} -p vcc_err_unref=false -p vcc_allow_inline_c=true -p cc_command='${cc_command}'" -vcl+backend {
    backend vtc_backend {
        .host = "${s1_addr}"; .port = "${s1_port}";
    }

    # trust all requests by default
    sub vcl_recv {
        set req.http.X-Trusted-Request = "A";
    }
    include "${basepath}/usr/share/varnish/tests/wikimedia_upload-frontend.vcl";
} -start

client c1 {
    txreq -url "/wikipedia/fr" -hdr "X-Forwarded-Proto: https" -hdr "Host: upload.wikimedia.org"
    rxresp

    expect resp.status == 200
    expect resp.http.Content-Security-Policy-Report-Only ~ "^default-src 'none';"
    expect resp.http.X-Content-Security-Policy-Report-Only == resp.http.Content-Security-Policy-Report-Only


    txreq -url "/wikipedia/el/test.pdf" -hdr "X-Forwarded-Proto: https" -hdr "Host: upload.wikimedia.org"
    rxresp

    # pdfs should have "object-src 'self'" in Content-Security-Policy-Report-Only
    # they should not have "sandbox" in CSP
    expect resp.status == 200
    expect resp.http.Content-Security-Policy-Report-Only ~ "object-src 'self'"
    expect resp.http.Content-Security-Policy-Report-Only !~ "sandbox"
    expect resp.http.Content-Security-Policy == <undef>
    expect resp.http.X-Content-Security-Policy-Report-Only == resp.http.Content-Security-Policy-Report-Only


    txreq -url "/wikipedia/el/test_page" -hdr "X-Forwarded-Proto: https" -hdr "Host: upload.wikimedia.org"
    rxresp

    # non-pdfs should not have Content-Security-Policy-Report-Only with
    # 'sandbox', nor should they have "object-src 'self'"
    expect resp.status == 200
    expect resp.http.Content-Security-Policy-Report-Only !~ "object-src 'self'"
    expect resp.http.Content-Security-Policy-Report-Only !~ "sandbox"
    expect resp.http.Content-Security-Policy == <undef>
    expect resp.http.X-Content-Security-Policy-Report-Only == resp.http.Content-Security-Policy-Report-Only


    # testing enforce mode; same conditions apply, except that the header is Content-Security-Policy
    txreq -url "/wikipedia/test/test.pdf" -hdr "X-Forwarded-Proto: https" -hdr "Host: upload.wikimedia.org"
    rxresp

    expect resp.status == 200
    expect resp.http.Content-Security-Policy ~ "object-src 'self'"
    expect resp.http.Content-Security-Policy !~ "sandbox"
    expect resp.http.Content-Security-Policy-Report-Only == <undef>
    expect resp.http.X-Content-Security-Policy-Report-Only == <undef>
    expect resp.http.X-Content-Security-Policy == resp.http.Content-Security-Policy


    txreq -url "/wikipedia/test/test_page" -hdr "X-Forwarded-Proto: https" -hdr "Host: upload.wikimedia.org"
    rxresp

    expect resp.status == 200
    expect resp.http.Content-Security-Policy !~ "object-src 'self'"
    expect resp.http.Content-Security-Policy ~ "sandbox"
    expect resp.http.Content-Security-Policy-Report-Only == <undef>
    expect resp.http.X-Content-Security-Policy-Report-Only == <undef>
    expect resp.http.X-Content-Security-Policy == resp.http.Content-Security-Policy
} -run
