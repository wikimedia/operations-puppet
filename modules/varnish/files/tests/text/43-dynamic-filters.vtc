# SPDX-License-Identifier: Apache-2.0
varnishtest "cache_text dynamic-filters"

server s1 {
    loop 2 {
        rxreq
        txresp
    }
} -start

varnish v1 -arg "-p vcl_path=${vcl_path} -p vcc_err_unref=false -p vcc_allow_inline_c=true -p cc_command='${cc_command}'" -vcl+backend {
   backend vtc_backend {
       .host = "${s1_addr}"; .port = "${s1_port}";
   }

   include "${basepath}/usr/share/varnish/tests/wikimedia_misc-frontend.vcl";
}

# Attach the "wikimedia_misc" label to wikimedia_misc-frontend.vcl
varnish v1 -cli "vcl.label wikimedia_misc vcl1"

varnish v1 -vcl {
    backend vtc_backend {
        .host = "${s1_addr}"; .port = "${s1_port}";
    }

    include "${basepath}/usr/share/varnish/tests/wikimedia_text-frontend.vcl";
} -start


client c1 {
    txreq -url "/wiki/Main_Page" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "X-Provenance: cloud=test-cloud-provider"
    rxresp
    expect resp.status == 403

    txreq -url "/wiki/Main_Page" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "X-Provenance: abuse=phabricator_abusers" -hdr "X-Wikimedia-Debug: backend=mwdebug1001"
    rxresp
    expect resp.status == 200

    txreq -url "/wiki/Main_Page" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "X-Provenance: abuse=phabricator_abusers" -hdr "Cookie: X-Wikimedia-Debug=backend%3Dmwdebug1001%3Blog"
    rxresp
    expect resp.status == 200

    txreq -req POST -url "/" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "X-Provenance: abuse=text_abuse_nets"
    rxresp
    expect resp.status == 403

    txreq  -url "/?nocache=true" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "X-Provenance: abuse=text_abuse_nets"
    rxresp
    expect resp.status == 403

    # Test that rules in the deprecation scope are applied to all requests, including the ones from trusted sources.
    txreq -url "/api/rest_v1/page/data-parsoid" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "X-Trusted-Request: A"
    rxresp
    expect resp.status == 403
    expect resp.body ~ "API endpoint is removed."
} -run

varnish v1 -expect backend_req == 2
