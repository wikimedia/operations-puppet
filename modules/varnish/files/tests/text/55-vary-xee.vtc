# SPDX-License-Identifier: Apache-2.0
varnishtest "Ensure that X-Experiment-Enrollments is removed from Vary headers"

server s1 {
    rxreq
    expect req.url == "/1"
    txresp -hdr "Cache-Control: public, s-maxage=10, max-age=0" \
           -hdr "Vary: X-Experiment-Enrollments, Accept-Encoding" \
           -hdr "X-Request-Id: 42"

    rxreq
    expect req.url == "/2"
    txresp -hdr "Vary: X-Experiment-Enrollments" \
        -hdr "Cache-Control: public, s-maxage=0, max-age=0" -hdr "X-Request-Id: 43"

    rxreq
    expect req.url == "/3"
    txresp -hdr "Vary: Accept-Encoding, X-Experiment-Enrollments" -hdr "X-Request-Id: 44"

    rxreq
    expect req.url == "/4"
    txresp -hdr "Vary: Accept-Encoding, X-Experiment-Enrollments, X-Forwarding-Proto" -hdr "X-Request-Id: 45"
} -start

varnish v1 -arg "-p vcl_path=${vcl_path} -p vcc_err_unref=false -p vcc_allow_inline_c=true -p cc_command='${cc_command}'" -vcl+backend {
   backend vtc_backend {
       .host = "${s1_addr}"; .port = "${s1_port}";
   }

   include "${basepath}/usr/share/varnish/tests/wikimedia_misc-frontend.vcl";
}

# Attach the "wikimedia_misc" label to wikimedia_misc-frontend.vcl
varnish v1 -cli "vcl.label wikimedia_misc vcl1"

varnish v1 -vcl {
    backend vtc_backend {
        .host = "${s1_addr}"; .port = "${s1_port}";
    }

    include "${basepath}/usr/share/varnish/tests/wikimedia_text-frontend.vcl";
} -start

client c1 {
    txreq -url "/1" -hdr "Host: meta.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.Vary == "Accept-Encoding"
    expect resp.http.X-Request-Id == 42

    txreq -url "/2" -hdr "Host: meta.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.Vary == <undef>
    expect resp.http.X-Request-Id == 43

    txreq -url "/3" -hdr "Host: meta.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.Vary == "Accept-Encoding"
    expect resp.http.X-Request-Id == 44

    txreq -url "/4" -hdr "Host: meta.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.Vary == "Accept-Encoding, X-Forwarding-Proto"
    expect resp.http.X-Request-Id == 45
} -run

varnish v1 -expect cache_hit == 0
