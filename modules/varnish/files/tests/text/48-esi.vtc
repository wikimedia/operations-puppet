# SPDX-License-Identifier: Apache-2.0
varnishtest "ESI"

server s1 {
    rxreq
    expect req.url == "/wiki/Main_Page"
    txresp -hdr "Content-Type: text/html; utf-8" -body {
        <html>
        <esi:include src="/esi/foo"/>
        </html>
    }
    # response will be cached by v1 so only 1 request will hit s1
    rxreq
    expect req.url == "/w/rest.php/fragments/v0-internal/foo?user_id=user1"
    txresp -body {
        Included file for user1
    }
    rxreq
    expect req.url == "/wiki/Private_Page"
    txresp -hdr "Cache-Control: private" -hdr "Content-Type: text/html; utf-8" -body {
        <html>
        <esi:include src="/esi/foo"/>
        </html>
    }
    rxreq
    expect req.url == "/wiki/Bad_Page"
    txresp -hdr "Content-Type: text/html; utf-8" -body {
        <html>
        <esi:include src="/esi/foo?user_id=admin&user_id=root"/>
        </html>
    }
    rxreq
    expect req.url == "/wiki/Param_Page"
    txresp -hdr "Content-Type: text/html; utf-8" -body {
        <html>
        <esi:include src="/esi/bar?answer=42"/>
        </html>
    }
    rxreq
    expect req.url == "/w/rest.php/fragments/v0-internal/bar?user_id=user1"
    txresp -body {
        query parameters have been stripped
    }
} -start


varnish v1 -arg "-a ${tmpdir}/v1.sock -p vcl_path=${vcl_path} -p vcc_err_unref=false -p vcc_allow_inline_c=true -p cc_command='${cc_command}'" -vcl+backend {
   backend vtc_backend {
       .host = "${s1_addr}"; .port = "${s1_port}";
   }

    include "${basepath}/usr/share/varnish/tests/wikimedia_misc-frontend.vcl";
}

# Attach the "wikimedia_misc" label to wikimedia_misc-frontend.vcl
varnish v1 -cli "vcl.label wikimedia_misc vcl1"

varnish v1 -vcl {
    backend vtc_backend {
        .host = "${s1_addr}"; .port = "${s1_port}";
    }
    sub vcl_deliver {
        set resp.http.url = req.url;
    }
    include "${basepath}/usr/share/varnish/tests/wikimedia_text-frontend.vcl";

} -start

client c1 -connect "${tmpdir}/v1.sock" {
    # 1. Authenticated request works as expected
    # provide a WMF-Uniq cookie to ensure the same X-E-E value
    txreq -url "/wiki/Main_Page" -hdr "X-JWT-Sub: user1" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "Cookie: WMF-Uniq=fJ_78P59gZJLL5lpUJzosAHuAAAAAMaC5V3iaYIYfYnoPEvFMlUxDy0ugjXSXVic"

    rxresp
    expect resp.body ~ "Included file for user1"
    # provide a WMF-Uniq cookie to ensure the same X-E-E value
    txreq -url "/wiki/Private_Page" -hdr "X-JWT-Sub: user1" -hdr "Cookie: enwikiSession=42;WMF-Uniq=fJ_78P59gZJLL5lpUJzosAHuAAAAAMaC5V3iaYIYfYnoPEvFMlUxDy0ugjXSXVic" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.body ~ "Included file for user1"

    # 2. user_id must always come from X-JWT-Sub
    txreq -url "/wiki/Bad_Page" -hdr "X-JWT-Sub: user1" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "Cookie: WMF-Uniq=fJ_78P59gZJLL5lpUJzosAHuAAAAAMaC5V3iaYIYfYnoPEvFMlUxDy0ugjXSXVic"
    rxresp
    expect resp.body ~ "Included file for user1"

    # 3. Anonymous requests don't get the included ESI fragment
    txreq -url "/wiki/Main_Page" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "Cookie: WMF-Uniq=fJ_78P59gZJLL5lpUJzosAHuAAAAAMaC5V3iaYIYfYnoPEvFMlUxDy0ugjXSXVic"

    rxresp
    expect resp.body !~ "Included file for user1"

    # 4. Query parameters are stripped from /esi/ requests
    txreq -url "/wiki/Param_Page" -hdr "X-JWT-Sub: user1" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "Cookie: WMF-Uniq=fJ_78P59gZJLL5lpUJzosAHuAAAAAMaC5V3iaYIYfYnoPEvFMlUxDy0ugjXSXVic"

    rxresp
    expect resp.body ~ "query parameters have been stripped"
} -run
