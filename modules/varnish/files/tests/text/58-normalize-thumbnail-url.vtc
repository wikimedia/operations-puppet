# SPDX-License-Identifier: Apache-2.0
varnishtest "Normalize Thumbnail URL"

server s1 {
    # $ cat text/58-norm* | grep '^\s*rxresp' | wc -l
    loop 16 {
        rxreq
        txresp
    }
} -start

varnish v1 -arg "-p vcl_path=${vcl_path} -p vcc_err_unref=false -p vcc_allow_inline_c=true -p cc_command='${cc_command}'" -vcl+backend {
    backend vtc_backend {
        .host = "${s1_addr}"; .port = "${s1_port}";
    }

    sub vcl_recv {
        set req.http.X-Trusted-Request = "A";
    }
    include "${basepath}/usr/share/varnish/tests/wikimedia_misc-frontend.vcl";
}

# Attach the "wikimedia_misc" label to wikimedia_misc-frontend.vcl
varnish v1 -cli "vcl.label wikimedia_misc vcl1"

varnish v1 -vcl {
    backend vtc_backend {
        .host = "${s1_addr}"; .port = "${s1_port}";
    }

    sub vcl_deliver {
        // Copy req metadata to resp, to keep req/resp assertions together in the client
        if (req.url) {
            set resp.http.testreq-url = req.url;
        }
    }

    include "${basepath}/usr/share/varnish/tests/wikimedia_text-frontend.vcl";
} -start

client c1 {
    txreq -url "/wikipedia/commons/thumb/b/b1/Santorin_%28GR%29%2C_Ia_--_2017_--_2698.jpg/960px-Santorin_%28GR%29%2C_Ia_--_2017_--_2698.jpg" -hdr "Host: thumb.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.testreq-url == "/wikipedia/commons/thumb/b/b1/Santorin_%28GR%29%2C_Ia_--_2017_--_2698.jpg/960px-Santorin_%28GR%29%2C_Ia_--_2017_--_2698.jpg"

    txreq -url "/wikipedia/commons/thumb/b/b1/Santorin_%28GR%29%2C_Ia_--_2017_--_2698.jpg/960px-foo.jpg" -hdr "Host: thumb.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.testreq-url == "/wikipedia/commons/thumb/b/b1/Santorin_%28GR%29%2C_Ia_--_2017_--_2698.jpg/960px-Santorin_%28GR%29%2C_Ia_--_2017_--_2698.jpg"

    txreq -url "/wikipedia/commons/thumb/b/b1/Santorin_%28GR%29%2C_Ia_--_2017_--_2698.jpg/960px-foo.JPG" -hdr "Host: thumb.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.testreq-url == "/wikipedia/commons/thumb/b/b1/Santorin_%28GR%29%2C_Ia_--_2017_--_2698.jpg/960px-Santorin_%28GR%29%2C_Ia_--_2017_--_2698.jpg"

    txreq -url "/wikipedia/commons/thumb/b/b1/Santorin_%28GR%29%2C_Ia_--_2017_--_2698.jpg/960px-Santorin_%28GR%29%2C_Ia_--_2017_--_2698.JPG" -hdr "Host: thumb.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.testreq-url == "/wikipedia/commons/thumb/b/b1/Santorin_%28GR%29%2C_Ia_--_2017_--_2698.jpg/960px-Santorin_%28GR%29%2C_Ia_--_2017_--_2698.jpg"

    txreq -url "/wikipedia/commons/thumb/b/b1/Santorin_%28GR%29%2C_Ia_--_2017_--_2698.jpg/960px-Santorin_%28GR%29%2C_Ia_--_2017_--_2698.jpg.png" -hdr "Host: thumb.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.testreq-url == "/wikipedia/commons/thumb/b/b1/Santorin_%28GR%29%2C_Ia_--_2017_--_2698.jpg/960px-Santorin_%28GR%29%2C_Ia_--_2017_--_2698.jpg.png"

    txreq -url "/wikipedia/commons/thumb/7/7f/Foobar_2015.JPG/1280px-Foobar_2015.JPG" -hdr "Host: thumb.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.testreq-url == "/wikipedia/commons/thumb/7/7f/Foobar_2015.JPG/1280px-Foobar_2015.JPG"

    txreq -url "/wikipedia/commons/thumb/7/7f/Foobar_2015.JPG/1280px-Foobar_2015.jpg" -hdr "Host: thumb.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.testreq-url == "/wikipedia/commons/thumb/7/7f/Foobar_2015.JPG/1280px-Foobar_2015.JPG"

    txreq -url "/wikipedia/commons/thumb/9/96/Free_the_Nipple_UK%2C_Fringe_2017_video.webm/500px-seek%3D28-Free_the_Nipple_UK%2C_Fringe_2017_video.webm.jpg" -hdr "Host: thumb.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.testreq-url == "/wikipedia/commons/thumb/9/96/Free_the_Nipple_UK%2C_Fringe_2017_video.webm/500px-seek%3d28-Free_the_Nipple_UK%2C_Fringe_2017_video.webm.jpg"

    txreq -url "/wikipedia/commons/thumb/9/96/Free_the_Nipple_UK%2C_Fringe_2017_video.webm/500px-seek%3D28-nothing.jpg" -hdr "Host: thumb.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.testreq-url == "/wikipedia/commons/thumb/9/96/Free_the_Nipple_UK%2C_Fringe_2017_video.webm/500px-seek%3d28-Free_the_Nipple_UK%2C_Fringe_2017_video.webm.jpg"

    txreq -url "/wikipedia/commons/thumb/9/96/Free_the_Nipple_UK%2C_Fringe_2017_video.webm/500px-SeEk%3D28-nothing.jpg" -hdr "Host: thumb.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.testreq-url == "/wikipedia/commons/thumb/9/96/Free_the_Nipple_UK%2C_Fringe_2017_video.webm/500px-seek%3d28-Free_the_Nipple_UK%2C_Fringe_2017_video.webm.jpg"

    txreq -url "/wikipedia/commons/thumb/7/7a/Robert_Thorp_-_Durham_School_Reg.pdf/page2-500px-Robert_Thorp_-_Durham_School_Reg.pdf.jpg" -hdr "Host: thumb.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.testreq-url == "/wikipedia/commons/thumb/7/7a/Robert_Thorp_-_Durham_School_Reg.pdf/page2-500px-Robert_Thorp_-_Durham_School_Reg.pdf.jpg"

    txreq -url "/wikipedia/commons/thumb/7/7a/Robert_Thorp_-_Durham_School_Reg.pdf/page2-500px-thumbnail.pdf.jpg" -hdr "Host: thumb.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.testreq-url == "/wikipedia/commons/thumb/7/7a/Robert_Thorp_-_Durham_School_Reg.pdf/page2-500px-Robert_Thorp_-_Durham_School_Reg.pdf.jpg"

    txreq -url "/wikipedia/commons/thumb/7/7a/Robert_Thorp_-_Durham_School_Reg.pdf/page2-500px-thumbnail.jpg" -hdr "Host: thumb.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.testreq-url == "/wikipedia/commons/thumb/7/7a/Robert_Thorp_-_Durham_School_Reg.pdf/page2-500px-Robert_Thorp_-_Durham_School_Reg.pdf.jpg"

    txreq -url "/wikipedia/commons/thumb/7/7a/0InV0EYT1y3zoKKAIUNkejbvnNIIIcwVwvgUxP3a9yt1r7HGzECbmXoaArfywciytY1byoD6QR37Dzqy391IT6UhEgSy8X7hxbox5aj5r1K9cE5ShgTDWvpkP32Srg05rHFa4fUFrrdD2EXp10DFpvhwf1SFXtFGodUvZzKZT9O8YD5mJEdkVXjbb6AwdTw8fA4vvBxY.pdf/page2-500px-thumbnail.jpg" -hdr "Host: thumb.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.testreq-url == "/wikipedia/commons/thumb/7/7a/0InV0EYT1y3zoKKAIUNkejbvnNIIIcwVwvgUxP3a9yt1r7HGzECbmXoaArfywciytY1byoD6QR37Dzqy391IT6UhEgSy8X7hxbox5aj5r1K9cE5ShgTDWvpkP32Srg05rHFa4fUFrrdD2EXp10DFpvhwf1SFXtFGodUvZzKZT9O8YD5mJEdkVXjbb6AwdTw8fA4vvBxY.pdf/page2-500px-thumbnail.jpg"

    txreq -url "/wikipedia/commons/thumb/7/7a/0InV0EYT1y3zoKKAIUNkejbvnNIIIcwVwvgUxP3a9yt1r7HGzECbmXoaArfywciytY1byoD6QR37Dzqy391IT6UhEgSy8X7hxbox5aj5r1K9cE5ShgTDWvpkP32Srg05rHFa4fUFrrdD2EXp10DFpvhwf1SFXtFGodUvZzKZT9O8YD5mJEdkVXjbb6AwdTw8fA4vvBxY.pdf/page2-500px-foo.jpg" -hdr "Host: thumb.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.testreq-url == "/wikipedia/commons/thumb/7/7a/0InV0EYT1y3zoKKAIUNkejbvnNIIIcwVwvgUxP3a9yt1r7HGzECbmXoaArfywciytY1byoD6QR37Dzqy391IT6UhEgSy8X7hxbox5aj5r1K9cE5ShgTDWvpkP32Srg05rHFa4fUFrrdD2EXp10DFpvhwf1SFXtFGodUvZzKZT9O8YD5mJEdkVXjbb6AwdTw8fA4vvBxY.pdf/page2-500px-thumbnail.jpg"

    txreq -url "/wikipedia/commons/thumb/7/7a/0InV0EYT1y3zoKKAIUNkejbvnNIIIcwVwvgUxP3a9yt1r7HGzECbmXoaArfywciytY1byoD6QR37Dzqy391IT6UhEgSy8X7hxbox5aj5r1K9cE5ShgTDWvpkP32Srg05rHFa4fUFrrdD2EXp10DFpvhwf1SFXtFGodUvZzKZT9O8YD5mJEdkVXjbb6AwdTw8fA4vvBxY.pdf/page2-500px-0InV0EYT1y3zoKKAIUNkejbvnNIIIcwVwvgUxP3a9yt1r7HGzECbmXoaArfywciytY1byoD6QR37Dzqy391IT6UhEgSy8X7hxbox5aj5r1K9cE5ShgTDWvpkP32Srg05rHFa4fUFrrdD2EXp10DFpvhwf1SFXtFGodUvZzKZT9O8YD5mJEdkVXjbb6AwdTw8fA4vvBxY.pdf.jpg" -hdr "Host: thumb.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.testreq-url == "/wikipedia/commons/thumb/7/7a/0InV0EYT1y3zoKKAIUNkejbvnNIIIcwVwvgUxP3a9yt1r7HGzECbmXoaArfywciytY1byoD6QR37Dzqy391IT6UhEgSy8X7hxbox5aj5r1K9cE5ShgTDWvpkP32Srg05rHFa4fUFrrdD2EXp10DFpvhwf1SFXtFGodUvZzKZT9O8YD5mJEdkVXjbb6AwdTw8fA4vvBxY.pdf/page2-500px-thumbnail.jpg"
}

client c1 -run
