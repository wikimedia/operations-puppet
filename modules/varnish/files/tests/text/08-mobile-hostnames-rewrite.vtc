varnishtest "cache_text mobile hostname rewrites"

server s1 {
    # M-dot requests
    rxreq
    expect req.http.x-dt-host == "www.mediawiki.org"
    txresp

    rxreq
    expect req.http.x-dt-host == "www.wikidata.org"
    txresp

    rxreq
    expect req.http.x-dt-host == "www.wikifunctions.org"
    txresp

    rxreq
    expect req.http.x-dt-host == "en.wikipedia.org"
    txresp

    rxreq
    expect req.http.x-dt-host == "it.wikipedia.org"
    txresp

    rxreq
    expect req.http.x-dt-host == "zh-classical.wikipedia.org"
    txresp

    rxreq
    expect req.http.x-dt-host == "foundation.wikimedia.org"
    txresp

    rxreq
    expect req.http.x-dt-host == "wikipedia.org"
    txresp

    # Canonical pageview request from mobile client (new-style)
    rxreq
    expect req.http.host == "test.wikipedia.org"
    expect req.http.x-dt-host == <undef>
    expect req.http.X-Subdomain == "M"
    txresp -hdr "Vary: X-Subdomain,Cookie"

    # Canonical pageview request from desktop client (new-style)
    rxreq
    expect req.http.host == "test.wikipedia.org"
    expect req.http.x-dt-host == <undef>
    expect req.http.X-Subdomain == <undef>
    txresp -hdr "Vary: X-Subdomain,Cookie"

    # Canonical load.php request from mobile client (new-style)
    rxreq
    expect req.http.host == "test.wikipedia.org"
    expect req.url == "/w/load.php?modules=startup"
    expect req.http.x-dt-host == <undef>
    expect req.http.X-Subdomain == "M"
    txresp -hdr "Vary: X-Subdomain,Cookie"

    # Canonical load.php request from desktop client (new-style)
    rxreq
    expect req.http.host == "test.wikipedia.org"
    expect req.url == "/w/load.php?modules=startup"
    expect req.http.x-dt-host == <undef>
    expect req.http.X-Subdomain == <undef>
    txresp -hdr "Vary: X-Subdomain,Cookie"

    # Canonical load.php request from mobile client (old-style)
    # Canonical load.php request from desktop client (old-style) [identical, cache hit]
    rxreq
    expect req.http.host == "de.wikipedia.org"
    expect req.url == "/w/load.php?modules=startup"
    expect req.http.x-dt-host == <undef>
    expect req.http.X-Subdomain == <undef>
    txresp -hdr "Vary: X-Subdomain,Cookie" -hdr "Cache-Control: public, max-age=300"

    # Mobile opt-out (legacy)
    # curl -i 'https://nl.wikipedia.org/w/index.php?title=Kris_Berry&mobileaction=toggle_view_desktop'
    rxreq
    expect req.http.host == "nl.wikipedia.org"
    expect req.http.x-dt-host == <undef>
    expect req.http.X-Subdomain == <undef>
    txresp -status 301 -hdr "Vary: X-Subdomain,Cookie" -hdr "Cache-Control: private, max-age=0" -hdr "Set-Cookie: stopMobileRedirect=true" -hdr "Location: https://nl.wikipedia.org/wiki/Kris_Berry"

    # Mobile opt-out (new, same as legacy)
    # curl -i 'https://test.wikipedia.org/w/index.php?title=Sandbox&mobileaction=toggle_view_desktop'
    rxreq
    expect req.http.host == "test.wikipedia.org"
    expect req.http.x-dt-host == <undef>
    expect req.http.X-Subdomain == <undef>
    txresp -status 301 -hdr "Vary: X-Subdomain,Cookie" -hdr "Cache-Control: private, max-age=0" -hdr "Set-Cookie: stopMobileRedirect=true" -hdr "Location: https://test.wikipedia.org/wiki/Sandbox"

    # Mobile opt-in (legacy)
    # (to external) curl -i 'https://nl.m.wikipedia.org/w/index.php?title=Kris_Berry&mobileaction=toggle_view_mobile'
    # (to ATS) [this test]
    # (to mediawiki) curl -i 'https://nl.wikipedia.org/w/index.php?title=Kris_Berry&mobileaction=toggle_view_mobile' -H 'X-Subdomain: M'
    rxreq
    expect req.http.host == "nl.m.wikipedia.org"
    expect req.http.x-dt-host == "nl.wikipedia.org"
    expect req.http.X-Subdomain == "M"
    txresp -status 301 -hdr "Vary: X-Subdomain" -hdr "Cache-Control: s-maxage=3600" -hdr "Location: https://nl.m.wikipedia.org/wiki/Kris_Berry"

    # Mobile opt-in (new, now same-domain and with cookies)
    # curl -i 'https://test.wikipedia.org/w/index.php?title=Sandbox&mobileaction=toggle_view_mobile'
    rxreq
    expect req.http.host == "test.wikipedia.org"
    expect req.http.x-dt-host == <undef>
    expect req.http.X-Subdomain == <undef>
    txresp -status 301 -hdr "Vary: X-Subdomain,Cookie" -hdr "Cache-Control: private, max-age=0" -hdr "Set-Cookie: mf_useformat=true" -hdr "Location: https://test.wikipedia.org/wiki/Sandbox"

    # Page view with new-style mobile opt-in cookie
    rxreq
    expect req.http.host == "test.wikipedia.org"
    expect req.http.x-dt-host == <undef>
    expect req.http.X-Subdomain == "M"
    txresp

    # Various tests that need plain origin responses
    #
    # * Don't count tests with HTTP 302 mobile redirects, as those tests don't call origin.
    #
    # * If the count seems too low, it means one of the test client is using a cache-hit
    #   instead of calling the origin. That should be fine, but if you want to assert both
    #   requests, then make sure both responses set CC:private in the test server.
    loop 10 {
        rxreq
        expect req.http.x-dt-host == <undef>
        txresp
    }

    # Google Translate on simple.wikipedia.org
    rxreq
    expect req.http.host == "simple.wikipedia.org"
    expect req.http.x-dt-host == <undef>
    expect req.http.X-Subdomain == <undef>
    txresp

    # Google Translate on en.wikipedia.org
    rxreq
    expect req.http.host == "en.wikipedia.org"
    expect req.http.x-dt-host == <undef>
    expect req.http.X-Subdomain == <undef>
    txresp

    # Googlebot on commons.wikimedia.org
    rxreq
    expect req.http.host == "commons.wikimedia.org"
    expect req.http.x-dt-host == <undef>
    expect req.http.X-Subdomain == "M"
    txresp
} -start

varnish v1 -arg "-p vcl_path=${vcl_path} -p vcc_err_unref=false -p vcc_allow_inline_c=true -p cc_command='${cc_command}'" -vcl+backend {
   backend vtc_backend {
       .host = "${s1_addr}"; .port = "${s1_port}";
   }

   include "${basepath}/usr/share/varnish/tests/wikimedia_misc-frontend.vcl";
}

# Attach the "wikimedia_misc" label to wikimedia_misc-frontend.vcl
varnish v1 -cli "vcl.label wikimedia_misc vcl1"

varnish v1 -vcl {
    backend vtc_backend {
        .host = "${s1_addr}"; .port = "${s1_port}";
    }

    # trust all requests by default, otherwise we'd get rate-limited having no UA.
    sub vcl_recv {
        set req.http.X-Trusted-Request = "A";
    }

    include "${basepath}/usr/share/varnish/tests/wikimedia_text-frontend.vcl";
} -start

client c1 {

    # Test: For m-dot requests to real wikis we must
    # * Compute the correct canonical hostname in x-dt-host, for upstream ATS.
    # * Respond in-place, regardless of user agent.

    txreq -url "/" -hdr "Host: m.mediawiki.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>

    txreq -url "/" -hdr "Host: m.wikidata.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>

    txreq -url "/" -hdr "Host: m.wikifunctions.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>

    txreq -url "/" -hdr "Host: en.m.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>

    txreq -url "/" -hdr "Host: it.m.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>

    txreq -url "/" -hdr "Host: zh-classical.m.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>

    txreq -url "/" -hdr "Host: foundation.m.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>

    # Test: m-dot alias of of www-portal
    #
    # TODO: This gets x-dt-host but shouldn't.
    #
    # We have an Apache redirect from m.wikipedia.org to www.wikipedia.org.
    # This happens to "work" because
    # 1) cluster_fe_recv_pre_purge treats the match before "m." as optional,
    # 2) "wikipedia.org" and "m.wikipedia.org" are both Apache redirects,
    #    so it hits a (different) redirect with the same result.
    txreq -url "/" -hdr "Host: m.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>

    # Test: Canonical pageview request from mobile client (new-style)
    # Suppress m-dot redirect in favor of X-Subdomain header
    txreq -url "/wiki/Main_Page" -hdr "User-Agent: Android" -hdr "Host: test.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>
    expect resp.http.vary == "X-Subdomain,Cookie,User-Agent"

    # Test: Canonical pageview request from desktop client (new-style)
    txreq -url "/wiki/Banana" -hdr "User-Agent: Firefox" -hdr "Host: test.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>
    expect resp.http.vary == "X-Subdomain,Cookie,User-Agent"

    # Test: Canonical load.php request from mobile client (new-style)
    txreq -url "/w/load.php?modules=startup" -hdr "User-Agent: Android" -hdr "Host: test.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>
    expect resp.http.vary == "X-Subdomain,Cookie,User-Agent"

    # Test: Canonical load.php request from desktop client (new-style)
    txreq -url "/w/load.php?modules=startup" -hdr "User-Agent: Firefox" -hdr "Host: test.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>
    expect resp.http.vary == "X-Subdomain,Cookie,User-Agent"

    # Test: Canonical load.php request from mobile client (old-style)
    txreq -url "/w/load.php?modules=startup" -hdr "User-Agent: Android" -hdr "Host: de.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>
    expect resp.http.vary == "X-Subdomain,Cookie,User-Agent"

    # Test: Canonical load.php request from desktop client (old-style)
    txreq -url "/w/load.php?modules=startup" -hdr "User-Agent: Firefox" -hdr "Host: de.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>
    expect resp.http.vary == "X-Subdomain,Cookie,User-Agent"

    # Test: Mobile opt-out (legacy), when mobile client clicks "Desktop view"
    # Suppress m-dot redirect for mobile client
    txreq -url "/w/index.php?title=Kris_Berry&mobileaction=toggle_view_desktop" -hdr "User-Agent: Android" -hdr "Host: nl.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.location == "https://nl.wikipedia.org/wiki/Kris_Berry"
    expect resp.http.vary == "X-Subdomain,Cookie,User-Agent"
    expect resp.status == 301

    # Test: Mobile opt-out (new)
    # Suppress X-Subdomain header
    txreq -url "/w/index.php?title=Sandbox&mobileaction=toggle_view_desktop" -hdr "User-Agent: Android" -hdr "Host: test.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.location == "https://test.wikipedia.org/wiki/Sandbox"
    expect resp.http.vary == "X-Subdomain,Cookie,User-Agent"
    expect resp.status == 301

    # Test: Mobile opt-in (legacy), when desktop client clicks "Mobile view"
    txreq -url "/w/index.php?title=Kris_Berry&mobileaction=toggle_view_mobile" -hdr "User-Agent: Firefox" -hdr "Host: nl.m.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.location == "https://nl.m.wikipedia.org/wiki/Kris_Berry"
    expect resp.http.vary == "X-Subdomain,User-Agent"
    expect resp.status == 301

    # Test: Mobile opt-in (new)
    txreq -url "/w/index.php?title=Sandbox&mobileaction=toggle_view_mobile" -hdr "User-Agent: Firefox" -hdr "Host: test.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.location == "https://test.wikipedia.org/wiki/Sandbox"
    expect resp.http.vary == "X-Subdomain,Cookie,User-Agent"
    expect resp.status == 301

    # Test: Page view with new-style mobile opt-in cookie
    # Respond in-place with mobile header
    txreq -url "/wiki/Sandbox" -hdr "User-Agent: Firefox" -hdr "Host: test.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "Cookie: mf_useformat=true"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>
    expect resp.http.vary == "User-Agent"

    #
    # Test: For canonical requests, respond normal to desktop and unknown clients
    #

    txreq -url "/" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>
    expect resp.http.vary == <undef>

    txreq -url "/" -hdr "Host: donate.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>
    expect resp.http.vary == <undef>

    txreq -url "/" -hdr "Host: donate.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>
    expect resp.http.vary == <undef>

    #
    # Test: Fundraising wikis respond normal to mobile clients
    # They have no mobile version and must not redirect
    #

    txreq -url "/" -hdr "User-Agent: nintendo" -hdr "Host: donate.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>
    expect resp.http.vary == <undef>

    txreq -url "/" -hdr "User-Agent: nintendo" -hdr "Host: donate.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>
    expect resp.http.vary == <undef>

    txreq -url "/wiki/Main_Page" -hdr "User-Agent: nintendo" -hdr "Host: thankyou.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>
    expect resp.http.vary == "User-Agent"

    #
    # Test: For canonical requests, redirect mobile clients to m-dot (main regex)
    #

    txreq -url "/wiki/Main_Page" -hdr "User-Agent: nintendo" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.location == "https://en.m.wikipedia.org/wiki/Main_Page"
    expect resp.status == 302
    expect resp.http.Access-Control-Allow-Origin == "*"
    expect resp.http.vary == <undef>

    txreq -url "/wiki/Main_Page" -hdr "User-Agent: nintendo" -hdr "Host: zh-classical.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.location == "https://zh-classical.m.wikipedia.org/wiki/Main_Page"
    expect resp.http.vary == <undef>
    expect resp.status == 302

    txreq -url "/?title=foo" -hdr "User-Agent: nintendo" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.location == "https://en.m.wikipedia.org/?title=foo"
    expect resp.http.vary == <undef>
    expect resp.status == 302

    txreq -url "/?title=foo&bar=baz" -hdr "User-Agent: nintendo" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.location == "https://en.m.wikipedia.org/?bar=baz&title=foo"
    expect resp.http.vary == <undef>
    expect resp.status == 302

    txreq -url "/?bar=baz&title=foo" -hdr "User-Agent: nintendo" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.location == "https://en.m.wikipedia.org/?bar=baz&title=foo"
    expect resp.http.vary == <undef>
    expect resp.status == 302

    txreq -url "/w/index.php?title=MyPage&action=info" -hdr "User-Agent: nintendo" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.location == "https://en.m.wikipedia.org/w/index.php?action=info&title=MyPage"
    expect resp.http.vary == <undef>
    expect resp.status == 302

    txreq -url "/wiki/Main_Page" -hdr "User-Agent: nintendo" -hdr "Host: ca.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>
    expect resp.http.vary == "User-Agent"

    txreq -url "/wiki/Homepage" -hdr "User-Agent: nintendo" -hdr "Host: office.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>
    expect resp.http.vary == "User-Agent"

    txreq -url "/wiki/Portal" -hdr "User-Agent: nintendo" -hdr "Host: quality.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200
    expect resp.http.location == <undef>
    expect resp.http.vary == "User-Agent"

    # Test: Android devices are mobile clients (main regex must be case insensitive)
    txreq -url "/wiki/Kris_Berry" -hdr "User-Agent: Android" -hdr "Host: nl.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.location == "https://nl.m.wikipedia.org/wiki/Kris_Berry"
    expect resp.http.vary == <undef>
    expect resp.status == 302

    # Test: Legacy Samsung devices are mobile clients (main regex)
    txreq -url "/wiki/Jasmine" -hdr "User-Agent: SAMSUNG-S8000 Jasmine/1.0" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.location == "https://en.m.wikipedia.org/wiki/Jasmine"
    expect resp.http.vary == <undef>
    expect resp.status == 302

    # Test: "Samsung Internet" on Smart TV identifies as desktop Linux (T127021)
    txreq -url "/wiki/Sonido" -hdr "User-Agent: Mozilla/5.0 (SMART-TV; Linux) SamsungBrowser/1.0 TV" -hdr "Host: es.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200

    # Test: "Samsung Internet" when in "Prefer desktop website" mode (T405279)
    txreq -url "/wiki/Infrasonido" -hdr "User-Agent: Mozilla/5.0 (X11; Linux x86_64) SamsungBrowser/28.0 Chrome/130.0.0.0" -hdr "Host: es.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200

    #
    # Test: Treat "Google Translate proxy" as a mobile client, regardless of user agent
    #

    txreq -url "/w/index.php?title=MyPage&action=info"  -hdr "User-Agent: firefox" -hdr "Host: simple.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "Via: 1.0 translate.google.com TWSFE/0.9"
    rxresp
    expect resp.http.location == "https://simple.m.wikipedia.org/w/index.php?action=info&title=MyPage"
    expect resp.http.vary == <undef>
    expect resp.status == 302

    txreq -url "/w/index.php?title=MyPage&action=info"  -hdr "User-Agent: firefox" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "Via: 1.0 translate.google.com TWSFE/0.9"
    rxresp
    expect resp.http.location == "https://en.m.wikipedia.org/w/index.php?action=info&title=MyPage"
    expect resp.http.vary == <undef>
    expect resp.status == 302

    txreq -url "/w/index.php?title=MyPage&action=info"  -hdr "User-Agent: Mozilla/5.0 (SMART-TV; Linux) SamsungBrowser/1.0 TV" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "Via: 1.0 translate.google.com TWSFE/0.9"
    rxresp
    expect resp.http.location == "https://en.m.wikipedia.org/w/index.php?action=info&title=MyPage"
    expect resp.http.vary == <undef>
    expect resp.status == 302

    txreq -url "/wiki/Sonido" -hdr "User-Agent: firefox" -hdr "Host: es.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "Via: 1.0 translate.google.com TWSFE/0.9"
    rxresp
    expect resp.http.location == "https://es.m.wikipedia.org/wiki/Sonido"
    expect resp.http.vary == <undef>
    expect resp.status == 302

    # Test: "Google Translate proxy" preference overrides all UA logic, including the "Samsung Smart TV" override.
    txreq -url "/wiki/Sonido" -hdr "User-Agent: Mozilla/5.0 (SMART-TV; Linux) SamsungBrowser/1.0 TV" -hdr "Host: es.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "Via: 1.0 translate.google.com TWSFE/0.9"
    rxresp
    expect resp.http.location == "https://es.m.wikipedia.org/wiki/Sonido"
    expect resp.http.vary == <undef>
    expect resp.status == 302

    # Test: Exclude non-pageview URLs from mobile redirect
    txreq -url "/w/load.php?lang" -hdr "User-Agent: nintendo" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200

    #
    # Test: "Google Translate proxy" preference overrides all UA logic, except Googlebot (just in case)
    #

    txreq -url "/wiki/Saturn"  -hdr "User-Agent: Googlebot" -hdr "Host: simple.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "Via: 1.0 translate.google.com TWSFE/0.9"
    rxresp
    expect resp.status == 200

    txreq -url "/wiki/Jupiter"  -hdr "User-Agent: Googlebot" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https" -hdr "Via: 1.0 translate.google.com TWSFE/0.9"
    rxresp
    expect resp.status == 200

    #
    # Test: Exclude Googlebot-on-Wikimedia-Commons from mobile redirect (T397267)
    #

    txreq -url "/wiki/Main_Page" -hdr "User-Agent: Mozilla/5.0 (Linux; Android 6.0.1; Nexus 5X Build/MMB29P) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/W.X.Y.Z Mobile Safari/537.36 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)" -hdr "Host: en.wikipedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.location == "https://en.m.wikipedia.org/wiki/Main_Page"
    expect resp.http.vary == <undef>
    expect resp.status == 302

    txreq -url "/wiki/Main_Page" -hdr "User-Agent: Mozilla/5.0 (Linux; Android 6.0.1; Nexus 5X Build/MMB29P) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/W.X.Y.Z Mobile Safari/537.36 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)" -hdr "Host: commons.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.status == 200

} -run
