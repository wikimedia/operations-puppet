# SPDX-License-Identifier: Apache-2.0
varnishtest "Return 400 to thumb requests with bad file extension"

server s1 {
    rxreq
    expect req.url == "/wikipedia/commons/thumb/test.jpg/120px-test.jpg"
    txresp

    rxreq
    expect req.url == "/wikipedia/commons/Thumb/test.png/120px-test.png"
    txresp
} -start

varnish v1 -arg "-p vcl_path=${vcl_path} -p vcc_err_unref=false -p vcc_allow_inline_c=true -p cc_command='${cc_command}'" -vcl+backend {
    backend vtc_backend {
        .host = "${s1_addr}"; .port = "${s1_port}";
    }

    sub vcl_recv {
        set req.http.X-Trusted-Request = "A";
    }
    include "${basepath}/usr/share/varnish/tests/wikimedia_misc-frontend.vcl";
}

# Attach the "wikimedia_misc" label to wikimedia_misc-frontend.vcl
varnish v1 -cli "vcl.label wikimedia_misc vcl1"

varnish v1 -vcl {
    backend vtc_backend {
        .host = "${s1_addr}"; .port = "${s1_port}";
    }

    include "${basepath}/usr/share/varnish/tests/wikimedia_text-frontend.vcl";
} -start

client c1 {
    txreq -url "/wikipedia/commons/thumb/test.not-ok" -hdr "X-Forwarded-Proto: https" -hdr "Host: thumb.wikimedia.org"
    rxresp

    expect resp.status == 400

    txreq -url "/wikipedia/commons/Thumb/test.webpx" -hdr "X-Forwarded-Proto: https" -hdr "Host: thumb.wikimedia.org"
    rxresp
    expect resp.status == 400

    txreq -url "/wikipedia/commons/Thumb/test" -hdr "X-Forwarded-Proto: https" -hdr "Host: thumb.wikimedia.org"
    rxresp
    expect resp.status == 400

    txreq -url "/wikipedia/commons/thumb/test.jpg/120px-test.jpg" -hdr "X-Forwarded-Proto: https" -hdr "Host: thumb.wikimedia.org"
    rxresp
    expect resp.status == 200

    txreq -url "/wikipedia/commons/Thumb/test.png/120px-test.PNG" -hdr "X-Forwarded-Proto: https" -hdr "Host: thumb.wikimedia.org"
    rxresp
    expect resp.status == 200
} -run
