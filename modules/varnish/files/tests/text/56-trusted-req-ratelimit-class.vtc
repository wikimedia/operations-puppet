# SPDX-License-Identifier: Apache-2.0
varnishtest "cache_text x-trusted-request and x-ratelimit-class headers"

server s1 {
    rxreq
    expect req.url == "/1"
    txresp -hdr "X-Analytics: k=v"

    rxreq
    expect req.url == "/2"
    txresp -hdr "X-Analytics: k=v" \
           -hdr "X-WMF-Ratelimit-Class: A"
} -start

varnish v1 -arg "-p vcl_path=${vcl_path} -p vcc_err_unref=false -p vcc_allow_inline_c=true -p cc_command='${cc_command}'" -vcl+backend {
   backend vtc_backend {
       .host = "${s1_addr}"; .port = "${s1_port}";
   }

   include "${basepath}/usr/share/varnish/tests/wikimedia_misc-frontend.vcl";
}

# Attach the "wikimedia_misc" label to wikimedia_misc-frontend.vcl
varnish v1 -cli "vcl.label wikimedia_misc vcl1"

varnish v1 -vcl {
    backend vtc_backend {
        .host = "${s1_addr}"; .port = "${s1_port}";
    }

    include "${basepath}/usr/share/varnish/tests/wikimedia_text-frontend.vcl";
} -start

client c1 {
    txreq -url "/1" -hdr "Host: meta.wikimedia.org" -hdr "X-Forwarded-Proto: https" -hdr "X-Trusted-Request: 1"
    rxresp
    expect resp.http.X-Analytics ~ "trusted_req=1"

    txreq -url "/2" -hdr "Host: meta.wikimedia.org" -hdr "X-Forwarded-Proto: https"
    rxresp
    expect resp.http.X-Analytics ~ "rl_class=A"
    expect resp.http.X-Analytics ~ "trusted_req=E"
    expect resp.http.X-WMF-Ratelimit-Class == <undef>
} -run


varnish v1 -expect cache_hit == 0
