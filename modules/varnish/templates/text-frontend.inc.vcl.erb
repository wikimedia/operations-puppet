import std;

# Temporary hack to patch T284479
# Not a complete list.
# Do not use; use X-Provenance == "cloud=gcp" instead; see also T270391
acl google_cloud_nets {
    "2600:1900::0"/28;
}

<%- if @vcl_config.fetch('do_esitest', false) or @varnish_testing -%>
backend esi_backend {
    .host = "127.0.0.1";
    .port = "4321";
    .connect_timeout = 1s;
    .first_byte_timeout = 1s;
