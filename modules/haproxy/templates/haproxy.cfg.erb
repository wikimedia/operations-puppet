# Note: This file is managed by puppet.

global
	maxconn 4096
	#debug
	#quiet
	user haproxy
	group haproxy
<%- if @logging -%>
	log /var/lib/haproxy/dev/log local0
	log /var/lib/haproxy/dev/log local1 notice
<%- end -%>
	stats socket <%= @socket %> mode 666 level user


defaults
	mode	http
<%- if @logging -%>
	log     global
<%- end -%>
	option	httplog
	option	dontlognull
	retries	3
	option redispatch
	maxconn	2000
	timeout connect 50000
	timeout client 500000
	timeout server 500000
