<%# SPDX-License-Identifier: Apache-2.0 -%>
backend hiddenparma_known_client_backend
    {{- $path := "/request-haproxy-dsl/<%= @cluster %>/known-clients-<%= @location %>" -}}
    {{- if not (exists $path) }}
    {{- $path = "/request-haproxy-dsl/<%= @cluster %>/known-clients-global" -}}
    {{- end }}
    {{ if exists $path }}
    # REQUESTCTL FILTERS
    {{ $value := json (getv $path) }}{{ range split $value.dsl "\n" }}
    {{ . }}
    {{- end }}
    {{- end}}
    server backend_server <%= @actual_backend_server %>

