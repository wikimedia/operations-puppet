# WONTFIX - We want at least 100.
# Lot of long lines (ssh keys for example).
--no-80chars-check
# even longer lines are also around
--no-140chars-check

# T127797 - needs at least one comment line for each class
--no-documentation-check

# When using strict_indent (which is the case in the puppet vscode extension) we need to declare our indent
--load=./rake_modules/chars_per_indent4.rb

# puppet-lint tries to turn top scope variables into facts:
# - https://github.com/puppetlabs/puppet-lint/issues/195
--no-top_scope_facts-check
